# Supabase（src/lib/supabase.ts 使用，必填，否则 /blog /products /videos /tags 等页面 500）
# 注意：这里是项目的 API 地址（https://<ref>.supabase.co），不是 Dashboard 后台地址
PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# Google Analytics（src/layouts/BaseLayout.astro 使用，可选，留空则不注入 GA 脚本）
PUBLIC_GA_ID=

# Cloudflare R2 图片桶（仅 docs/r2-image-pipeline.py 本地脚本使用，站点前端不读这两项）
# 令牌作用域：仅 meiyu 桶（对象读取/写入/列出）；Secret 只在创建时显示一次
# 获取与自检步骤见 docs/r2-setup.md；缺失时脚本会自动回退为热链路径
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
