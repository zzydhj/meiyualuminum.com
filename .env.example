# Supabase（src/lib/supabase.ts 使用，必填，否则 /blog /products /videos /tags 等页面 500）
# 注意：这里是项目的 API 地址（https://<ref>.supabase.co），不是 Dashboard 后台地址
PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# Google Analytics（src/layouts/BaseLayout.astro 使用，可选，留空则不注入 GA 脚本）
PUBLIC_GA_ID=
