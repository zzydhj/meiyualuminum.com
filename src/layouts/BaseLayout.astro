---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingInquiry from "../components/FloatingInquiry.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import BackToTop from "../components/BackToTop.astro";
import FloatingFreeSample from "../components/FloatingFreeSample.astro";
import InquiryModal from "../components/InquiryModal.astro";
import "../styles/global.css";
import { DEFAULT_LANG, buildAlternates, type Lang } from "../lib/i18n";

interface Props {
  pageTitle: string;
  /** 页面可见大标题（h1）。不传则回退用 pageTitle。
      用途分离：pageTitle 服务 <title>/OG 等 SEO 标签，headingTitle 服务读者看到的 h1。 */
  headingTitle?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: "website" | "article";
  pubDate?: Date;
  author?: string;
  keywords?: string[];
  customCss?: string;
  customJs?: string;
  hideTitle?: boolean;
  /** 首页传入 true：桌面端 header 初始透明，滚动后变白 */
  transparentHeader?: boolean;
  /** 当前页面语言（用于 <html lang> 和导航链接前缀） */
  lang?: Lang;
  /**
   * 转化页 / 无内容价值页设 true：输出 robots 指令禁止编录但仍跟随链接。
   * 这类页（如询盘成功页）必须同时从 sitemap 里排除，否则等于一边递清单一边叫它别收。
   */
  noindex?: boolean;
  /** hreflang 多语言替代链接（自动从 URL 生成，也可手动覆盖） */
  alternates?: { lang: string; href: string }[];
}

const {
  pageTitle,
  headingTitle,
  description = "MEIYU Aluminum Co., Ltd. — direct factory of architectural aluminium ceiling tiles, linear strip ceilings, wall cladding and facade panels in Dongguan, China.",
  image,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  type = "website",
  pubDate,
  author,
  keywords = [],
  customCss,
  customJs,
  hideTitle = false,
  transparentHeader = false,
  lang = DEFAULT_LANG,
  noindex = false,
  alternates: alternatesProp,
} = Astro.props;

// 自动生成 hreflang：手动传入 alternates 时优先用，否则从当前 URL 路径生成
const alternates = alternatesProp ?? buildAlternates(Astro.url.pathname);

const siteName = "Meiyu Aluminum";
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "";

// 站点级默认分享图：页面未传 image 时兜底，避免 twitter:card=summary_large_image
// 声明了大图却没有 og:image（WhatsApp / LinkedIn / 微信转发时无预览图）。
// 换图只改这一行；理想尺寸是 1200×630，当前这张是 800×533（3:2，可用）。
const DEFAULT_OG_IMAGE =
  "https://file.meiyualuminum.com/home/mega-menu/aluminum-veneer.webp";

// 未传图时回退到站点默认图，保证每页都有 og:image / twitter:image
const ogImage = new URL(image || DEFAULT_OG_IMAGE, Astro.site).href;

// Google Analytics 衡量 ID：默认值就是本站正式 ID，PUBLIC_GA_ID 仅用于换属性时覆盖。
// 以前 head 里一份硬编码、body 末尾一份 env 驱动，共两套；一旦真的设了 PUBLIC_GA_ID
// 就会重复装载 gtag（pageview 计两遍），所以收成单一来源。
// 2026-10-12 核对过 GA 后台数据流详情：meiyualuminum.com 的衡量 ID 是 G-MNY00M46JX；
// 此前默认值写成了一个不相干的 G-DS2EV49TRD，所以 GA 一直显示“未收到数据”。
// 这个写错的默认值比读不到 env 更险：它能让数据静默报到别人的 property 里。
const gaId = import.meta.env.PUBLIC_GA_ID || "G-MNY00M46JX";

// Organization JSON-LD (global, appears on every page)
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  sameAs: [
    "https://www.twitter.com/meiyualuminum",
    "https://www.linkedin.com/meiyualuminum",
    "https://www.github.com/meiyualuminum",
  ],
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link
      rel="icon"
      type="image/x-icon"
      href="https://file.meiyualuminum.com/home/favicon.ico"
    />

    {
      /* Google Analytics 4（单一来源：见上方 gaId）。
         必须用 set:html：Astro 的 <script is:inline> 内容原样输出、不做 JSX 插值，
         直接写花括号占位会被当字符串下发，gtag.js 能加载但一条 pageview 都不上报。
         这里用 JSX 注释而不是 HTML 注释：HTML 注释会随页面下发，
         注释里出现 config / noindex 之类字样会让自动检查误报。 */
    }
    {
      gaId && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
          />
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\ngtag('js', new Date());\ngtag('config', '${gaId}');`}
          />
        </>
      )
    }

    <!-- Inter font — 异步加载，不阻塞首屏渲染 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      /></noscript
    >

    <!-- Basic SEO -->
    <title>{pageTitle} | {siteName}</title>
    <meta name="description" content={description} />
    {
      keywords.length > 0 && (
        <meta name="keywords" content={keywords.join(", ")} />
      )
    }
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang 多语言替代链接 -->
    {
      alternates.map((alt) => (
        <link
          rel="alternate"
          hreflang={alt.lang}
          href={new URL(alt.href, Astro.site).href}
        />
      ))
    }
    {
      alternates.length > 0 && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={
            new URL(
              alternates.find((a) => a.lang === DEFAULT_LANG)?.href ??
                canonicalURL,
              Astro.site,
            ).href
          }
        />
      )
    }

    {
      /* 已上线：不再输出索引限制 meta 标签。日后若需临时退出索引，
        改这里并同步 robots.txt。（用 JSX 注释，不随 HTML 下发） */
    }

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    {
      pubDate && (
        <meta
          property="article:published_time"
          content={pubDate.toISOString()}
        />
      )
    }
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <!-- Per-page custom CSS (from database) -->
    {customCss && <style set:html={customCss} />}

    <!-- Per-page head extras (e.g. resource preloading) -->
    <slot name="head" />
  </head>
  <body>
    <Header transparent={transparentHeader} lang={lang} />
    <main class="container">
      {!hideTitle && <h1>{headingTitle || pageTitle}</h1>}
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import "../scripts/menu.js";
      import "../scripts/watermark.js";
      import "../scripts/videoCover.js";
    </script>

    <!-- Per-page custom JS (from database, runs after DOM is ready) -->
    {customJs && <script is:inline set:html={customJs} />}

    <!-- Global floating inquiry FAB — fixed bottom-right, all pages -->
    <FloatingInquiry />

    <!-- Global floating Free Sample capsule — above WhatsApp, desktop only -->
    <FloatingFreeSample />

    <!-- Global floating WhatsApp button — above inquiry FAB -->
    <FloatingWhatsApp />

    <!-- Global back-to-top sticky tab — bottom of the floating stack, flush to window bottom -->
    <BackToTop />

    <!-- WhatsApp 点击统计：任何 wa.me 链接被点击 → 记一次 GA4 事件 whatsapp_click。
         wa.me 新开标签页，click 先于跳转触发；gtag 以 beacon 发送不丢失。
         业务/运营在 GA4 → 报告 → 互动 → 事件 中查看 whatsapp_click。 -->
    <script>
      document.addEventListener(
        "click",
        (e) => {
          const target = e.target as Element | null;
          const a = target?.closest?.(
            'a[href^="https://wa.me/"], a[href^="https://api.whatsapp.com/"]',
          );
          if (!a) return;
          const payload = {
            wa_source: a.getAttribute("data-wa-source") || "inline_link",
            page_path: window.location.pathname,
            page_title: document.title,
          };
          const w = window as unknown as {
            gtag?: (...args: unknown[]) => void;
            dataLayer?: unknown[];
          };
          if (typeof w.gtag === "function") {
            w.gtag("event", "whatsapp_click", payload);
          } else {
            (w.dataLayer = w.dataLayer || []).push({
              event: "whatsapp_click",
              ...payload,
            });
          }
        },
        true,
      );
    </script>

    <!-- Global inquiry modal — triggered from any [data-open-inquiry-modal] button -->
    <InquiryModal />

    <!--Start of Tawk.to Script-->
    <!-- Tawk.to 在线客服聊天（第三方，全站生效）。
         is:inline 确保脚本原样输出、按序执行，不被 Astro 打包处理。 -->
    <script is:inline type="text/javascript">
      var Tawk_API = Tawk_API || {},
        Tawk_LoadStart = new Date();
      (function () {
        var s1 = document.createElement("script"),
          s0 = document.getElementsByTagName("script")[0];
        s1.async = true;
        s1.src = "https://embed.tawk.to/6ac7ad4579143d34c40cc4be/1k4dvpmq3";
        s1.charset = "UTF-8";
        s1.setAttribute("crossorigin", "*");
        s0.parentNode.insertBefore(s1, s0);
      })();
    </script>
    <!--End of Tawk.to Script-->
  </body>
</html>
