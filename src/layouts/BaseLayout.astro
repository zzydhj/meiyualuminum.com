---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingInquiry from '../components/FloatingInquiry.astro';
import InquiryModal from '../components/InquiryModal.astro';
import '../styles/global.css';

interface Props {
  pageTitle: string;
  /** 页面可见大标题（h1）。不传则回退用 pageTitle。
      用途分离：pageTitle 服务 <title>/OG 等 SEO 标签，headingTitle 服务读者看到的 h1。 */
  headingTitle?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
  keywords?: string[];
  customCss?: string;
  customJs?: string;
  hideTitle?: boolean;
  /** 首页传入 true：桌面端 header 初始透明，滚动后变白 */
  transparentHeader?: boolean;
}

const {
  pageTitle,
  headingTitle,
  description = "Professional automotive parts supplier - OEM quality brake pads, filters, and engine components",
  image,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  type = "website",
  pubDate,
  author,
  keywords = [],
  customCss,
  customJs,
  hideTitle = false,
  transparentHeader = false,
} = Astro.props;

const siteName = "Meiyu Aluminum";
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';

// Only build absolute image URL if image is provided
const ogImage = image ? new URL(image, Astro.site).href : undefined;

// Google Analytics tracking ID (set PUBLIC_GA_ID in .env)
const gaId = import.meta.env.PUBLIC_GA_ID || '';

// Organization JSON-LD (global, appears on every page)
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteName,
  "url": siteUrl,
  "logo": `${siteUrl}/favicon.svg`,
  "sameAs": [
    "https://www.twitter.com/meiyualuminum",
    "https://www.linkedin.com/meiyualuminum",
    "https://www.github.com/meiyualuminum"
  ]
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="https://file.meiyualuminum.com/home/favicon.ico" />

    <!-- Inter font — used by the footer typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <!-- Basic SEO -->
    <title>{pageTitle} | {siteName}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <link rel="canonical" href={canonicalURL} />

    <!-- ⚠️ TEMPORARY (pre-launch): keep every page out of search engine indexes.
         noindex = don't index this page; nofollow = don't follow its links.
         REMOVE this line when the site goes live. -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <!-- Per-page custom CSS (from database) -->
    {customCss && <style set:html={customCss} />}

    <!-- Per-page head extras (e.g. resource preloading) -->
    <slot name="head" />
  </head>
  <body>
    <Header transparent={transparentHeader} />
    <main class="container">
      {!hideTitle && <h1>{headingTitle || pageTitle}</h1>}
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/menu.js";
      import "../scripts/watermark.js";
    </script>

    <!-- Google Analytics -->
    {gaId && (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{gaId}');
      </script>
    )}
    {gaId && (
      <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
    )}

    <!-- Per-page custom JS (from database, runs after DOM is ready) -->
    {customJs && <script is:inline set:html={customJs} />}

    <!-- Global floating inquiry FAB — fixed bottom-right, all pages -->
    <FloatingInquiry />

    <!-- Global inquiry modal — triggered from any [data-open-inquiry-modal] button -->
    <InquiryModal />
  </body>
</html>
