---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  pageTitle: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
  keywords?: string[];
  customCss?: string;
  customJs?: string;
}

const {
  pageTitle,
  description = "Professional automotive parts supplier - OEM quality brake pads, filters, and engine components",
  image,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  type = "website",
  pubDate,
  author,
  keywords = [],
  customCss,
  customJs,
} = Astro.props;

const siteName = "Meiyu Aluminum";
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';

// Only build absolute image URL if image is provided
const ogImage = image ? new URL(image, Astro.site).href : undefined;

// Google Analytics tracking ID (set PUBLIC_GA_ID in .env)
const gaId = import.meta.env.PUBLIC_GA_ID || '';

// Organization JSON-LD (global, appears on every page)
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteName,
  "url": siteUrl,
  "logo": `${siteUrl}/favicon.svg`,
  "sameAs": [
    "https://www.twitter.com/meiyualuminum",
    "https://www.linkedin.com/meiyualuminum",
    "https://www.github.com/meiyualuminum"
  ]
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Basic SEO -->
    <title>{pageTitle} | {siteName}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <!-- Per-page custom CSS (from database) -->
    {customCss && <style set:html={customCss} />}
  </head>
  <body>
    <Header />
    <main class="container">
      <h1>{pageTitle}</h1>
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/menu.js";
    </script>

    <!-- Google Analytics -->
    {gaId && (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{gaId}');
      </script>
    )}
    {gaId && (
      <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
    )}

    <!-- Per-page custom JS (from database, runs after DOM is ready) -->
    {customJs && <script is:inline set:html={customJs} />}
  </body>
</html>
