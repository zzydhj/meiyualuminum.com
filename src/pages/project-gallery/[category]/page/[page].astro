---
/**
 * project-gallery/[category]/page/[page].astro — 项目画廊分类列表第 2~N 页（SSR）
 *
 * - 第 1 页由 project-gallery/[category].astro 渲染（/project-gallery/{category}/ 为规范地址）
 * - 页码非法或超出范围一律 302 回该分类第 1 页：不留空页，也不产生重复内容
 */
import PageHero from "../../../../components/PageHero.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ProjectGallery from "../../../../components/ProjectGallery.astro";
import { PAGE_SIZE, resolvePage } from "../../../../lib/pagination";
import {
    CATEGORY_MAP,
    fetchAllProjects,
    groupProjectsByCategory,
} from "../../../../lib/projectGallery";

// SSR：案例数一变，分类分页的边界就得重算。
export const prerender = false;

const category = decodeURIComponent(Astro.params.category ?? "");
const items = groupProjectsByCategory(await fetchAllProjects()).get(category);

// 口径与 project-gallery/[category].astro 一致：只认 CATEGORY_MAP 内有案例的分类。
if (!CATEGORY_MAP[category] || !items) {
    return Astro.redirect("/project-gallery/");
}

const totalPages = Math.ceil(items.length / PAGE_SIZE);
const currentPage = resolvePage(Astro.params.page, totalPages);
const categoryPath = encodeURIComponent(category);

// 页码非法或超出范围 → 回该分类第 1 页（第 1 页的规范地址是分类页本身）。
if (currentPage === null) {
    return Astro.redirect(`/project-gallery/${categoryPath}/`);
}

const label = CATEGORY_MAP[category].label;
const pageDescription = `Browse our ${label} project cases: aluminum building material installations worldwide - page ${currentPage}.`;
---

<BaseLayout
    pageTitle={`${label} Projects - Page ${currentPage}`}
    description={pageDescription}
    hideTitle
>
    <PageHero
        slim
        imageAlt={label}
        titleWhite={label}
        titleGold={`Page ${currentPage}`}
        crumb={{
            items: [
                { name: "Home", url: "/" },
                { name: "Project Gallery", url: "/project-gallery/" },
                { name: label, url: `/project-gallery/${categoryPath}/` },
                {
                    name: `Page ${currentPage}`,
                    url: `/project-gallery/${categoryPath}/page/${currentPage}/`,
                },
            ],
        }}
    />
    <ProjectGallery category={category} currentPage={currentPage} />
</BaseLayout>
