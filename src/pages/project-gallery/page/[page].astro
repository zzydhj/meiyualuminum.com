---
/**
 * project-gallery/page/[page].astro — 项目画廊总列表第 2~N 页（SSR）
 *
 * - 第 1 页由 [page].astro 渲染（SSR，/project-gallery/ 为规范地址），本路由只负责第 2 页起
 * - 页码非法或超出总页数一律 302 回第 1 页：不留空页，也不产生重复内容
 */
import PageHero from "../../../components/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectGallery from "../../../components/ProjectGallery.astro";
import { PAGE_SIZE, resolvePage } from "../../../lib/pagination";
import { fetchAllProjects } from "../../../lib/projectGallery";

// SSR：案例数一变总页数就得重算，理由同 blog/page/[page].astro。
export const prerender = false;

const totalPages = Math.ceil((await fetchAllProjects()).length / PAGE_SIZE);
const currentPage = resolvePage(Astro.params.page, totalPages);

if (currentPage === null) {
    return Astro.redirect("/project-gallery/");
}

const pageDescription =
    "Browse our portfolio of aluminum building material installations across sectors and multiple continents.";
---

<BaseLayout
    pageTitle={`Project Gallery - Page ${currentPage}`}
    description={pageDescription}
    hideTitle
>
    <PageHero
        slim
        imageAlt={`Project Gallery - Page ${currentPage}`}
        titleWhite="Project Gallery"
        titleGold={`Page ${currentPage}`}
        crumb={{
            items: [
                { name: "Home", url: "/" },
                { name: "Project Gallery", url: "/project-gallery/" },
                {
                    name: `Page ${currentPage}`,
                    url: `/project-gallery/page/${currentPage}/`,
                },
            ],
        }}
    />
    <ProjectGallery currentPage={currentPage} />
</BaseLayout>
