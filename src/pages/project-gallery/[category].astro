---
/**
 * project-gallery/[category].astro — 项目画廊分类列表第 1 页（SSR）
 *
 * - 第 2~N 页由 project-gallery/[category]/page/[page].astro 渲染
 * - 药丸为链接式筛选（A 方案）：服务端过滤 + 分页正确，取代旧版页内 JS 隐藏
 * - 只渲染「有案例且在 CATEGORY_MAP 内」的分类，其余 302 回画廊首页
 */
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import {
    CATEGORY_MAP,
    fetchAllProjects,
    groupProjectsByCategory,
} from "../../lib/projectGallery";

// SSR：案例存在 posts 表，新增或删除案例后分类页与首页同步变化，不需重建部署。
export const prerender = false;

const category = decodeURIComponent(Astro.params.category ?? "");
const byCategory = groupProjectsByCategory(await fetchAllProjects());

// 与原先 getStaticPaths 完全同口径：不在 CATEGORY_MAP 里、或该分类下一例都没有，
// 都不该有这个页面。处理同标签页：302 回画廊首页，不返回 404 空白页。
if (!CATEGORY_MAP[category] || !byCategory.has(category)) {
    return Astro.redirect("/project-gallery/");
}

const label = CATEGORY_MAP[category].label;
const categoryPath = encodeURIComponent(category);
const pageDescription = `Browse our ${label} project cases: aluminum building material installations worldwide.`;
---

<BaseLayout
    pageTitle={`${label} Projects`}
    description={pageDescription}
    hideTitle
>
    <PageHero
        slim
        imageAlt={label}
        titleWhite={label}
        titleGold="Projects"
        subtitle={pageDescription}
        crumb={{
            items: [
                { name: "Home", url: "/" },
                { name: "Project Gallery", url: "/project-gallery/" },
                { name: label, url: `/project-gallery/${categoryPath}/` },
            ],
        }}
    />
    <ProjectGallery category={category} />
</BaseLayout>
