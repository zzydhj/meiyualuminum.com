              <li>On-Site Technical Guidance</li>
              <li>Full Project Lifecycle Support</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="section-cta-bronze">
        <a href="/contact" class="btn-primary-bronze">Get a Free Quote</a>
        <a href="/products" class="btn-secondary-bronze">View Projects</a>
