  .meiyu-map-pin .ring2 { animation-delay: .8s; }
  @keyframes meiyu-ripple {
    0%   { width: 10px; height: 10px; opacity: .8; }
    100% { width: 40px; height: 40px; opacity: 0; }
  }

  .meiyu-map-tip {
    position: absolute;
    background: #3A2A1A;
    border: 1px solid rgba(192,168,130,.45);
    border-radius: 10px; padding: 14px 16px; width: 200px;
    pointer-events: none; opacity: 0; transition: opacity .15s;
    z-index: 20; box-shadow: 0 8px 32px rgba(0,0,0,.5);
  }
  .meiyu-map-tip.on { opacity: 1; }
  .meiyu-map-tip-reg  { font-size: 10px; color: #C0A882; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 3px; }
  .meiyu-map-tip-name { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 4px; }
  .meiyu-map-tip-meta { font-size: 11px; color: rgba(255,255,255,.45); }
  .meiyu-map-tip-count {
    display: inline-block; margin-top: 8px;
    background: rgba(192,168,130,.12); border: 1px solid rgba(192,168,130,.3);
    color: #C0A882; font-size: 10px; font-weight: 700;
    padding: 3px 8px; border-radius: 4px;
  }

  .meiyu-map-legend {
    position: absolute; bottom: 14px; left: 16px;
    display: flex; gap: 14px; z-index: 5;
  }
  .meiyu-map-leg-i { display: flex; align-items: center; gap: 5px; font-size: 10px; color: rgba(255,255,255,.45); }
  .meiyu-map-leg-d { width: 7px; height: 7px; border-radius: 50%; }

  .meiyu-map-panel { width: 320px; flex-shrink: 0; display: flex; flex-direction: column; gap: 16px; }

  .meiyu-map-p-head {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(192,168,130,.18);
    border-radius: 10px; padding: 20px 22px;
  }
  .meiyu-map-p-head h3 {
    font-size: 14px; font-weight: 700; color: #C0A882;
    letter-spacing: 2px; text-transform: uppercase; margin-bottom: 4px;
  }
  .meiyu-map-p-head p { font-size: 13px; color: rgba(255,255,255,.4); }

  .meiyu-map-filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .meiyu-map-fb {
    padding: 6px 14px; border-radius: 20px;
    border: 1px solid rgba(255,255,255,.15);
    background: transparent; color: rgba(255,255,255,.55);
    font-size: 12px; font-weight: 600; cursor: pointer;
    transition: all .2s; font-family: inherit;
  }
  .meiyu-map-fb:hover,
  .meiyu-map-fb.on {
    background: rgba(192,168,130,.18);
    border-color: #C0A882; color: #C0A882;
  }

  .meiyu-map-clist {
    flex: 1; overflow-y: auto;
    display: flex; flex-direction: column; gap: 10px;
    max-height: 420px; padding-right: 6px;
  }
  .meiyu-map-clist::-webkit-scrollbar { width: 4px; }
  .meiyu-map-clist::-webkit-scrollbar-thumb { background: rgba(192,168,130,.3); border-radius: 2px; }

  .meiyu-map-cc {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 9px; padding: 14px 16px;
    cursor: pointer; transition: all .2s;
    display: flex; gap: 12px; align-items: flex-start;
  }
  .meiyu-map-cc:hover,
  .meiyu-map-cc.on {
    background: rgba(192,168,130,.1);
    border-color: rgba(192,168,130,.4);
  }
  .meiyu-map-cc-dot { width: 8px; height: 8px; border-radius: 50%; background: #C0A882; flex-shrink: 0; margin-top: 5px; }
  .meiyu-map-cc-name { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .meiyu-map-cc-meta { font-size: 12px; color: rgba(255,255,255,.4); }
  .meiyu-map-cc-tag {
    font-size: 11px; font-weight: 600; color: #C0A882;
    background: rgba(192,168,130,.1); border-radius: 4px;
    padding: 3px 8px; margin-top: 6px; display: inline-block;
  }

  .meiyu-map-cta {
    display: flex; align-items: center; justify-content: space-between;
    background: linear-gradient(135deg, rgba(192,168,130,.15), rgba(192,168,130,.06));
    border: 1px solid rgba(192,168,130,.35);
    border-radius: 9px; padding: 16px 20px;
    cursor: pointer; transition: all .2s; text-decoration: none;
  }
  .meiyu-map-cta:hover {
    background: linear-gradient(135deg, rgba(192,168,130,.25), rgba(192,168,130,.12));
  }
  .meiyu-map-cta span { font-size: 13px; font-weight: 700; color: #C0A882; }

  @media (max-width: 992px) {
    .meiyu-map-body { flex-direction: column; align-items: stretch; }
    .meiyu-map-panel { width: 100%; }
    .meiyu-map-wrap  { aspect-ratio: auto; height: 300px; }
    .meiyu-map-container { padding: 40px 20px; }
  }
</style>

<script>
  /* ===== Video Hero: 3-stage deferred loading =====
     1. 首次加载：只显示 poster 封面图，不下载视频
     2. 页面加载完成：开始下载视频
     3. 边下边播：canplay 后立即播放
     移动端兼容：play() 被拒绝时监听首次用户交互再播放 */
  const heroVideo = document.querySelector<HTMLVideoElement>('.video-hero-bg');
  if (heroVideo) {
    const showFallback = () => heroVideo.classList.add('video-failed');
    heroVideo.addEventListener('error', showFallback);
    heroVideo.querySelectorAll('source').forEach((s) => s.addEventListener('error', showFallback));

    // 确保 muted（移动端 autoplay 策略要求）
    heroVideo.muted = true;

    // 尝试播放，失败则等用户首次交互
    const tryPlay = () => {
      const p = heroVideo.play();
      if (p) {
        p.catch(() => {
          // autoplay 被拦截，等用户触摸/点击后重试
          const onInteract = () => {
            heroVideo.play().catch(() => {});
            document.removeEventListener('touchstart', onInteract);
            document.removeEventListener('click', onInteract);
          };
          document.addEventListener('touchstart', onInteract, { once: true, passive: true });
          document.addEventListener('click', onInteract, { once: true });
        });
      }
    };

    // 阶段 2：DOM 解析完即开始下载视频（不等图片/字体，提前 2-4s）
    const startLoad = () => {
      heroVideo.preload = 'auto';
      heroVideo.load();
    };

    // 阶段 3：视频可以播放时立即播放
    heroVideo.addEventListener('canplay', () => {
      if (heroVideo.paused) tryPlay();
    }, { once: true });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startLoad, { once: true });
    } else {
      startLoad();
    }

    // Safety net: 8s 后如果完全没加载到数据，显示 fallback
    setTimeout(() => {
      if (heroVideo.readyState === 0 && heroVideo.networkState === 3) {
        showFallback();
      }
    }, 8000);
  }

  document.querySelectorAll('.gallery-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.gallery-tab').forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const target = tab.getAttribute('data-tab');
      document.querySelectorAll('.gallery-panel').forEach((p) => p.classList.remove('active'));
      document.querySelector(`.gallery-panel[data-panel="${target}"]`)?.classList.add('active');
    });
  });

  /* ===== Global Map Section ===== */
  const DB: Record<string, {n:string;c:string;t:string;r?:string}[]> = {
    all:[
      {n:"Guangzhou Finance Center",c:"Guangzhou, CN",t:"Facade Panel",r:"cn"},
      {n:"Dubai Mall Expansion",c:"Dubai, UAE",t:"Ceiling System",r:"me"},
      {n:"Singapore Changi T5",c:"Singapore",t:"Acoustic Ceiling",r:"sea"},
      {n:"Berlin Office Tower",c:"Berlin, DE",t:"Curtain Wall",r:"eu"},
      {n:"Sydney Convention Ctr",c:"Sydney, AU",t:"Facade Panel",r:"au"},
      {n:"Shenzhen Bay HQ",c:"Shenzhen, CN",t:"Decorative Screen",r:"cn"},
      {n:"Abu Dhabi Cultural Hub",c:"Abu Dhabi, UAE",t:"Facade Panel",r:"me"},
      {n:"KL Tower Renovation",c:"Kuala Lumpur, MY",t:"Ceiling System",r:"sea"},
    ],
    cn:[
      {n:"Guangzhou Finance Center",c:"Guangzhou, CN",t:"Facade Panel"},
      {n:"Shenzhen Bay HQ",c:"Shenzhen, CN",t:"Decorative Screen"},
      {n:"Shanghai Bund Plaza",c:"Shanghai, CN",t:"Curtain Wall"},
    ],
    me:[
      {n:"Dubai Mall Expansion",c:"Dubai, UAE",t:"Ceiling System"},
      {n:"Abu Dhabi Cultural Hub",c:"Abu Dhabi, UAE",t:"Facade Panel"},
      {n:"Riyadh Metro Station",c:"Riyadh, SA",t:"Acoustic Ceiling"},
    ],
    sea:[
      {n:"Singapore Changi T5",c:"Singapore",t:"Acoustic Ceiling"},
      {n:"KL Tower Renovation",c:"Kuala Lumpur, MY",t:"Ceiling System"},
    ],
    eu:[
      {n:"Berlin Office Tower",c:"Berlin, DE",t:"Curtain Wall"},
      {n:"Amsterdam Arena Roof",c:"Amsterdam, NL",t:"Facade Panel"},
    ],
    au:[{n:"Sydney Convention Ctr",c:"Sydney, AU",t:"Facade Panel"}],
    na:[{n:"Toronto Mixed-Use",c:"Toronto, CA",t:"Facade Panel"}],
    af:[{n:"Lagos Business Hub",c:"Lagos, NG",t:"Ceiling System"}],
    sa:[{n:"São Paulo Tower",c:"São Paulo, BR",t:"Decorative Screen"}],
  };
  const RN: Record<string,string> = {all:"All Regions",cn:"China",me:"Middle East",sea:"Southeast Asia",eu:"Europe",au:"Australia",na:"North America",af:"Africa",sa:"South America"};
  const TD: Record<string,{reg:string;name:string;meta:string;count:string}> = {
    cn:{reg:"EAST ASIA",name:"China Projects",meta:"Foshan · Shenzhen · Guangzhou · Shanghai",count:"80+ Projects"},
    me:{reg:"MIDDLE EAST",name:"Middle East Projects",meta:"Dubai · Abu Dhabi · Riyadh",count:"55+ Projects"},
    sea:{reg:"SOUTHEAST ASIA",name:"SE Asia Projects",meta:"Singapore · Kuala Lumpur · Bangkok",count:"30+ Projects"},
    eu:{reg:"EUROPE",name:"Europe Projects",meta:"Berlin · Amsterdam · Paris",count:"25+ Projects"},
    au:{reg:"OCEANIA",name:"Australia Projects",meta:"Sydney · Melbourne",count:"12+ Projects"},
    na:{reg:"NORTH AMERICA",name:"N. America Projects",meta:"Toronto · Los Angeles",count:"10+ Projects"},
    af:{reg:"AFRICA",name:"Africa Projects",meta:"Lagos · Nairobi",count:"8+ Projects"},
    sa:{reg:"SOUTH AMERICA",name:"S. America Projects",meta:"São Paulo · Buenos Aires",count:"6+ Projects"},
  };

  function renderMap(r: string) {
    const d = DB[r] || DB.all;
    const clist = document.getElementById('meiyu-clist');
    if (clist) {
      clist.innerHTML = d.map((c, i) => `
        <div class="meiyu-map-cc ${i === 0 ? 'on' : ''}">
          <div class="meiyu-map-cc-dot"></div>
          <div style="min-width:0;flex:1">
            <div class="meiyu-map-cc-name">${c.n}</div>
            <div class="meiyu-map-cc-meta">${c.c}</div>
            <span class="meiyu-map-cc-tag">${c.t}</span>
          </div>
        </div>`).join('');
    }
    const pReg = document.getElementById('meiyu-pReg');
    const pDesc = document.getElementById('meiyu-pDesc');
    if (pReg) pReg.textContent = RN[r] || 'All Regions';
    if (pDesc) pDesc.textContent = d.length + ' project' + (d.length > 1 ? 's' : '') + ' in this region';
  }
  renderMap('all');

  const tip = document.getElementById('meiyu-tip');
  const mw = document.getElementById('meiyu-mw');
  document.querySelectorAll('.meiyu-map-pin').forEach((p) => {
    p.addEventListener('mouseenter', () => {
      const id = (p as HTMLElement).dataset.id || '';
      const d = TD[id]; if (!d || !tip) return;
      const tReg = document.getElementById('meiyu-tReg');
      const tName = document.getElementById('meiyu-tName');
      const tMeta = document.getElementById('meiyu-tMeta');
      const tCount = document.getElementById('meiyu-tCount');
      if (tReg) tReg.textContent = d.reg;
      if (tName) tName.textContent = d.name;
      if (tMeta) tMeta.textContent = d.meta;
      if (tCount) tCount.textContent = d.count;
      tip.classList.add('on');
    });
    p.addEventListener('mousemove', (e) => {
      if (!mw || !tip) return;
      const ev = e as MouseEvent;
      const r = mw.getBoundingClientRect();
      let x = ev.clientX - r.left + 14, y = ev.clientY - r.top - 20;
      if (x + 210 > r.width) x = ev.clientX - r.left - 220;
      if (y + 120 > r.height) y = ev.clientY - r.top - 130;
      tip.style.left = x + 'px'; tip.style.top = y + 'px';
    });
    p.addEventListener('mouseleave', () => tip?.classList.remove('on'));
    p.addEventListener('click', () => {
      const id = (p as HTMLElement).dataset.id || '';
      renderMap(id);
      document.querySelectorAll('.meiyu-map-fb').forEach((b) => b.classList.remove('on'));
      const b = document.querySelector(`.meiyu-map-fb[data-r="${id}"]`);
      if (b) b.classList.add('on');
    });
  });

  document.querySelectorAll('.meiyu-map-fb').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.meiyu-map-fb').forEach((x) => x.classList.remove('on'));
      b.classList.add('on');
      renderMap((b as HTMLElement).dataset.r || 'all');
    });
  });

  function anim(id: string, end: number, sfx = '') {
    let v = 0; const s = Math.ceil(end / 40);
    const el = document.getElementById(id); if (!el) return;
    const t = setInterval(() => {
      v = Math.min(v + s, end);
      el.textContent = v + sfx;
      if (v >= end) clearInterval(t);
    }, 28);
  }
  anim('meiyu-sC', 38); anim('meiyu-sP', 240, '+'); anim('meiyu-sK', 120, '+');
</script>
