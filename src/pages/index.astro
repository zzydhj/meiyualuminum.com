            </p>
            <ul>
              <li>Shop Drawing Production &amp; Submission</li>
              <li>Connection Detail Refinement &amp; Optimization</li>
              <li>
                Seamless Coordination with Design Institutes &amp; Main
                Contractors
              </li>
            </ul>
            <button
              type="button"
              class="card-cta-bronze"
              data-open-inquiry-modal>Request Shop Drawings</button
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Gallery Tabs Section ===== -->
  <section class="gallery-tabs-section">
    <div class="section-header-bronze">
      <span class="eyebrow-bronze">Project Gallery</span>
      <div class="gold-line-bronze"></div>
