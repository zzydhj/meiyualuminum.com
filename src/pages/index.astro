        </div>
        <div
          class="vg-item"
          data-vg-src={`https://file.meiyualuminum.com/video-project/suzhou-starlight-gateway-project.mp4${VG_V}`}
        >
          <div class="vg-cell">
            <img
              class="vg-cover"
              src={VG_COVERS["vg-suzhou-starlight-gateway"]}
              alt="Suzhou Starlight Gateway project video cover"
              loading="lazy"
              decoding="async"
              width="480"
              height="854"
            />
          </div>
          <button type="button" class="vg-play" data-vg-play>
            <svg
              class="vg-ic-play"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M8 5v14l11-7z" fill="currentColor"></path></svg
            >
            <svg
              class="vg-ic-pause"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"
