---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { supabase } from "../lib/supabase";

// Fetch home page data from Supabase
const { data: homePage, error } = await supabase
  .from("pages")
  .select("*")
  .eq("slug", "home")
  .eq("status", "published")
  .single();

if (error) {
  console.error("Failed to fetch home page:", error);
}

const pageTitle = homePage?.seo_title || homePage?.title || "Home";
const pageDescription = homePage?.seo_description || "";
const keywords = homePage?.keywords ?? [];

// Custom per-page code (plain text columns: custom_css / custom_js)
const customCss = homePage?.custom_css ?? "";
const customJs = homePage?.custom_js ?? "";

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Meiyu Aluminum",
  "url": Astro.site,
};
---

<BaseLayout pageTitle={pageTitle} description={pageDescription} keywords={keywords} customCss={customCss} customJs={customJs}>
  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

  <!-- Hero section -->
  {(homePage?.hero_title || homePage?.hero_subtitle) && (
    <section class="hero">
      {homePage?.hero_title && <h2>{homePage.hero_title}</h2>}
      {homePage?.hero_subtitle && <p class="subtitle">{homePage.hero_subtitle}</p>}
    </section>
  )}

  <!-- Page content (HTML from database) -->
  {homePage?.content && (
    <div class="page-content" set:html={homePage.content} />
  )}
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 2rem 0;
    margin-bottom: 1.5rem;
  }

  .hero h2 {
    font-size: 2rem;
    margin: 0 0 0.75rem;
    color: #0d0950;
  }

  .hero .subtitle {
    font-size: 1.15rem;
    color: #475569;
    margin: 0 auto;
    max-width: 600px;
    line-height: 1.6;
  }

  .page-content {
    line-height: 1.8;
    font-size: 1rem;
  }

  .page-content h2 {
    margin-top: 2rem;
    color: #1e293b;
  }

  .page-content p {
    margin-bottom: 1rem;
    color: #475569;
  }
</style>
