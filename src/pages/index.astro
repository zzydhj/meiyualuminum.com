            <span class="vg-play-text">Play</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Solutions Section (Bronze) ===== -->
  <section class="solutions-section-bronze">
    <div class="solutions-container-bronze">
      <div class="section-header-bronze">
        <span class="eyebrow-bronze">What We Offer</span>
