  /* ===== Full-screen Video Hero ===== */
  .video-hero {
    position: relative;
    width: var(--inner-w);
    margin-left: var(--bleed);
    /* Cancel out the .container's 1rem top padding so the video sits flush against the header */
    margin-top: -1rem;
    height: calc(100vh - 60px);
    height: calc(100svh - 60px);
    overflow: hidden;
  }

  /* LCP 底图：垫在视频下方的真实 <img>（视频失败时即兜底画面）。
     绝对定位铺满 hero，width/height 属性只给宽高比 hint，不参与布局。 */
  .video-hero-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Hide the video element when it fails, revealing the fallback background */
  .video-hero-bg.video-failed {
    display: none;
  }
  @media (min-width: 636px) {
    .video-hero {
      height: calc(100vh - 72px);
      height: calc(100svh - 72px);
    }
  }
  /* ≥1280px（与页眉桌面断点同步）: header 为 fixed 透明覆盖，hero 占满整个视口 */
  @media (min-width: 1280px) {
