<script>
  /* ===== Video Hero: 3-stage deferred loading =====
     1. 首次加载：preload=metadata 只取第一帧做封面（不下载整片）
     2. 页面加载完成：开始下载视频
     3. 边下边播：canplay 后立即播放
     移动端兼容：play() 被拒绝时监听首次用户交互再播放 */
  const heroVideo = document.querySelector<HTMLVideoElement>(".video-hero-bg");
  if (heroVideo) {
    const showFallback = () => heroVideo.classList.add("video-failed");
    heroVideo.addEventListener("error", showFallback);
    heroVideo
      .querySelectorAll("source")
      .forEach((s) => s.addEventListener("error", showFallback));

    // 确保 muted（移动端 autoplay 策略要求）
    heroVideo.muted = true;

    // 尝试播放，失败则等用户首次交互
    const tryPlay = () => {
      const p = heroVideo.play();
      if (p) {
        p.catch(() => {
          // autoplay 被拦截，等用户任何一次交互后重试
          const onInteract = () => {
            heroVideo.play().catch(() => {});
            document.removeEventListener("touchstart", onInteract);
            document.removeEventListener("click", onInteract);
            document.removeEventListener("pointerdown", onInteract);
            document.removeEventListener("keydown", onInteract);
          };
          document.addEventListener("touchstart", onInteract, {
            once: true,
            passive: true,
          });
          document.addEventListener("click", onInteract, { once: true });
          document.addEventListener("pointerdown", onInteract, {
            once: true,
            capture: true,
          });
          document.addEventListener("keydown", onInteract, { once: true });
        });
      }
    };

    // 阶段 2（业主 2026-11-06 定口径）：先让整页能浏览，window load 之后才在
    // 主线程空闲时默默下载视频——首屏有底图垫着，视觉不断档；慢网上几 MB 的
    // 自动播放视频不再和首屏底图/CSS 抢带宽，也不会把 LCP 观测点拖到几十秒。
    // load() 是「重置」不是「确保已加载」：它会掐掉正在进行的下载、把 currentTime
    // 推回片段起点（#t=0.1）再重拉。所以下面 rIC 与 4s 定时器两条路径只能生效一次，
    // 否则业主看到的症状就是「播几秒跳回 0 重播」（2026-11-07 实测：首个 mp4 请求在
    // load+4s 被掐断并重新发起）；而且第 2 次要重新下载已经下过的字节，慢网上反而更慢。
    let loadStarted = false;
    const startLoad = () => {
      if (loadStarted) return;
      loadStarted = true;
      heroVideo.preload = "auto";
      heroVideo.load();
    };
    const startLoadDeferred = () => {
      const go = () => startLoad();
      if (typeof requestIdleCallback === "function") {
        requestIdleCallback(go, { timeout: 5000 });
      } else {
        setTimeout(go, 2000);
      }
      // 硬兜底：隐藏的预览面板/后台标签里 requestIdleCallback 可能一直不执行，
      // 最迟 4s 也强制开始下载——首屏底图已就绪，此时拉视频不伤 LCP。
      setTimeout(go, 4000);
    };

    // 阶段 3：视频可以播放时立即播放（不设 once：canplay 可能早于监听器挂载）
    heroVideo.addEventListener("canplay", () => {
      if (heroVideo.paused) tryPlay();
    });

    if (document.readyState === "complete") {
      preloadLazyImages();
      startLoadDeferred();
    } else {
      window.addEventListener(
        "load",
        () => {
          preloadLazyImages();
          startLoadDeferred();
        },
        { once: true },
      );
    }

    // 兜底 A（8s）：既没解出帧、也没在拉流 → 说明加载根本没开始，放开守卫重试一次。
    // 必须两个条件一起看：networkState 2 = NETWORK_LOADING，慢网上下载健康进行中时
    // readyState 也是 0，只看 readyState 会把那条健康下载中的流掐掉重来（今天早些时候就是这么误伤的）。
    setTimeout(() => {
      if (heroVideo.readyState === 0 && heroVideo.networkState !== 2) {
        loadStarted = false;
        startLoad();
      }
    }, 8000);

    // 兜底 B（16s）：16 秒还一帧都没有，不管它是不是“还在拉流”，那条流实际上已经死了
    // （卡住的连接会一直保持 networkState=2，靠上面的条件永远等不到重试）。最后重试
    // 一次，再等 8s 仍无数据就判定真失败、回退到底图。这两次重试时屏幕上都只有底图
    // 或 poster，不会产生任何回跳观感；真正在播的视频 readyState 早就 ≥ 2，进不来。
    setTimeout(() => {
      if (heroVideo.readyState === 0) {
        loadStarted = false;
        startLoad();
        setTimeout(() => {
          if (heroVideo.readyState === 0) showFallback();
        }, 8000);
      }
    }, 16000);

    // ===== 阶段 4：整页 load 后空闲时，把「首屏附近」的懒加载图升为 eager =====
    // 业主 2026-11-06 口径：图片先加载展示，才轮到视频后台下载。但「全部升级」
    // 是错的：移动端实测会把 facade/mega-menu/factory 等 ~40 张屏外图一次性拉满，
    // 从 load 一直堵到 30s+，反把 hero 视频首帧挤到最后（LCP 爆到 24s）。
    // 正解＝只升「首屏 1.25 屏高以内」的图，屏外一律保持原生 lazy（滚到才加载，
    // 天然从上往下），既不塞满连接、又让看得见的图先于视频落地。
    // 用 function 声明是为了让上面的 load 钩子能先调用它。
    function preloadLazyImages() {
      const idle =
        (window as any).requestIdleCallback ||
        ((cb: Function) => setTimeout(cb, 2000));
      idle(
        () => {
          const limit = window.innerHeight * 1.25; // 首屏 + 一点提前量
          document
            .querySelectorAll<HTMLImageElement>('img[loading="lazy"]')
            .forEach((img) => {
              // 隐藏 Tab 面板（display:none）里的图跳过：不点就不加载，
              // 升 eager 会让 5 个 Tab 的图一起在后台抢带宽（业主明确不要）
              if (img.closest(".gallery-panel:not(.active)")) return;
              const rect = img.getBoundingClientRect();
              // 无渲染盒（display:none）或落在首屏之外：保持 lazy，滚到再加载
              if (!rect.height || rect.top > limit || rect.bottom < 0) return;
              img.loading = "eager";
              // 用 decode() 在后台线程解码，不阻塞主线程（避免滚动时卡顿）
              if (!img.complete) {
                img.decode().catch(() => {}); // 解码失败不影响正常显示
              }
            });
        },
        { timeout: 5000 },
      ); // 最多等 5s 空闲，超时也执行
    }
  }

  document.querySelectorAll(".gallery-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document
        .querySelectorAll(".gallery-tab")
        .forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      const target = tab.getAttribute("data-tab");
      document
        .querySelectorAll(".gallery-panel")
        .forEach((p) => p.classList.remove("active"));
      const panel = document.querySelector(
        `.gallery-panel[data-panel="${target}"]`,
      );
      panel?.classList.add("active");
      // 切到的面板立即全力加载自己的图（用户动作 = 最高优先级）；
      // 没切过的面板继续保持 lazy，一张都不多下（业主 2026-11-06 口径）
      panel
        ?.querySelectorAll<HTMLImageElement>('img[loading="lazy"]')
        .forEach((img) => {
          img.loading = "eager";
        });
    });
  });

  /* ===== Video Gallery: 静态封面图 + Play 点击才注入视频 =====
     - 封面是普通 <img loading=lazy>（ markup 里没有任何 <video>），按 DOM 顺序
       进懒加载队列，不会比后面章节的图更慢，也不跟 hero 底图抢带宽
     - 点 Play 才创建 <video preload=auto> 盖在封面上全力下载（用户动作 =
       最高优先级）；再点暂停，按钮文案 Play/Pause 同步
     - 仅首格（data-vg-auto）在 window load + hero 已拿到画面 + 进视口后才注入并播，
       离开视口只暂停不预先下载（业主 2026-11-07 口径：开屏视频全力优先，才轮到首格；
       整站因此只剩 hero + 首格两个视频请求） */
  const vgSection = document.getElementById("videoGallery");
  if (vgSection) {
    /** 首次调用才把 <video> 注入 .vg-cell（盖在封面 img 上层），之后复用 */
    const ensureVideo = (item: HTMLElement): HTMLVideoElement | null => {
      const existing = item.querySelector<HTMLVideoElement>("video");
      if (existing) return existing;
      const src = item.dataset.vgSrc;
      const cell = item.querySelector<HTMLElement>(".vg-cell");
      if (!src || !cell) return null;
      const video = document.createElement("video");
      video.muted = true;
      video.loop = true;
      video.playsInline = true;
      video.preload = "auto";
      video.src = src;
      // Astro scoped CSS 不会命中 JS 动态创建的 <video>（它没有 data-astro-cid
      // 属性），.vg-cell video 的铺满规则对它无效——首格自播实测视频按原始尺寸
      // 撑爆网格列。铺满样式必须内联写死，与封面 img 同一套定位。
      video.style.position = "absolute";
      video.style.inset = "0";
      video.style.width = "100%";
      video.style.height = "100%";
      video.style.objectFit = "cover";
      video.style.display = "block";
      cell.appendChild(video);
      return video;
    };

    vgSection.querySelectorAll<HTMLElement>(".vg-item").forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>("[data-vg-play]");
      const label = btn?.querySelector(".vg-play-text");
      if (!btn) return;

      const sync = (playing: boolean) => {
        item.classList.toggle("playing", playing);
        if (label) label.textContent = playing ? "Pause" : "Play";
      };

      btn.addEventListener("click", () => {
        const video = ensureVideo(item);
        if (!video) return;
        // 事件只绑一次：注入后播放/暂停都由 sync 刷按钮状态
        if (!video.dataset.vgBound) {
          video.dataset.vgBound = "1";
          video.addEventListener("play", () => sync(true));
          video.addEventListener("pause", () => sync(false));
        }
        if (video.paused) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    });

    // 业主 2026-11-07 口径：封面必须“滚到就有图、秒加载”。vg 整段在首屏
    // 之下，原生 lazy 要等真正滚到才发请求，临近视口（提前一整屏）时把 6 张
    // 封面一次性升 eager：单张 39~63KB、合计 ~300KB，换“滚到即满图”值得。
    const vgCovers = Array.from(
      vgSection.querySelectorAll<HTMLImageElement>("img.vg-cover"),
    );
    if (vgCovers.length && "IntersectionObserver" in window) {
      const vgEagerIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            vgCovers.forEach((img) => {
              img.loading = "eager";
            });
            vgEagerIO.disconnect();
          });
        },
        { rootMargin: "100% 0px" },
      );
      vgEagerIO.observe(vgSection);
    }

    // 首格默认自动播放：window load 之后（封面图等静态资源先落地）+ 进视口才
    // 注入并起播，离开视口即暂停；用户手动点过该格按钮后交还手动控制；
    // 偏好减少动态时不自动播（封面图照常显示）
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const featured = vgSection.querySelector<HTMLElement>(
      ".vg-item[data-vg-auto]",
    );
    const fBtn = featured?.querySelector<HTMLButtonElement>("[data-vg-play]");
    let manual = false;
    fBtn?.addEventListener("click", () => {
      manual = true;
    });
    if (featured && !reduceMotion) {
      let featuredObserver: IntersectionObserver | null = null;
      const startFeatured = () => {
        if (featuredObserver) return; // 事件与超时两条路都可能走到这里，只允许起一次
        featuredObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (manual) return;
              if (entry.isIntersecting) {
                // 下载门控（业主 2026-11-07）：ensureVideo 里是 preload="auto"，
                // <video> 一创建就开始整片下载，后面的 pause() 拦不住它。
                // 而 IntersectionObserver 在 observe() 那一刻必定先投递一次
                // isIntersecting=false 的初始回调——以前 ensureVideo 写在这个
                // 回调外面，等于屏幕外就把 23.6MB 拉走了（实测 buffered 先涨到
                // 14.8/25.2s，滚过去之后一条新的 mp4 请求都没产生）。
                const video = ensureVideo(featured);
                video?.play().catch(() => {});
              } else {
                // 只有已经注入过的（用户滚回来又滚走）才需要暂停；没注入就什么都不做
                featured.querySelector<HTMLVideoElement>("video")?.pause();
              }
            });
          },
          { threshold: 0.35 },
        );
        featuredObserver.observe(featured);
      };

      // 顺序保证（业主 2026-11-07 口径：开屏视频全力优先，然后才是画廊首格）：
      // hero 拿到画面（readyState ≥ 2）之前，首格一个字节都不得下载。
      // 首格 23.6MB 是 hero 5.9MB 的 4 倍，两路并发实测把 hero 首帧从 3.8s 推到 13s。
      const hero = document.querySelector<HTMLVideoElement>(".video-hero-bg");
      const heroHasPicture = () => !!hero && hero.readyState >= 2;
      const waitHero = () => {
        if (!hero || heroHasPicture()) {
          startFeatured();
          return;
        }
        const onHeroData = () => {
          if (!heroHasPicture()) return;
          hero.removeEventListener("loadeddata", onHeroData);
          startFeatured();
        };
        hero.addEventListener("loadeddata", onHeroData);
        // 上限兜底：hero 被慢网或自动播放策略卡住时，不能把画廊永远锁死。
        // 12s 后不管 hero 有没有画面都放行（首格自己仍受上面的视口门控约束）。
        setTimeout(startFeatured, 12000);
      };

      if (document.readyState === "complete") {
        waitHero();
      } else {
        window.addEventListener("load", waitHero, { once: true });
      }
    }
  }

