---
import BaseLayout from "../layouts/BaseLayout.astro";
import FactoryTourRail from "../components/FactoryTourRail.astro";
import OrderProcess from "../components/OrderProcess.astro";
import { VG_COVERS } from "../lib/videoCovers";

/**
 * 画廊 6 条视频共用的缓存版本号。
 *
 * R2 直链被 Cloudflare 边缘缓存一年（实测 GET 命中 cf-cache-status: HIT、
 * Cache-Control: max-age=31536000），在桶里同名替换文件后边缘仍会回旧字节。
 * 业主 2026-11-07 换 xiamen 那条就撞上了：源站已是 3,103,320 B（HEAD 可见），
 * 而浏览器走的 GET 仍拿到 23,585,673 B 的旧对象，TTL 还剩约 364 天。
 * 项内没有 Cloudflare API Token、wrangler 也无 purge 子命令，所以只能换缓存键。
 * 以后在 R2 里换过任何一条画廊视频，把这个值往上抬一次并部署即可（hero 那条
 * 同理，写死在 markup 里的 ?v=20261028）。
 *
 * 20261107b 的来由：20261107 上线后业主把 6 条全部压缩重传，但边缘在 ?v=20261107
 * 这个键上存的仍是旧内容（实测 liangjiang 返回 2,909,902 B / Last-Modified 10 月 8 日，
 * 而源站已是 555 kB）。旧内容是被开发时的探测请求写进去的：量体积时用了 ffprobe
 * 与 curl 的 GET，它们在业主替换完成之前就命中了这个缓存键（HEAD 不进缓存，GET 进）。
 * 教训：探测 R2 素材体积要用 HEAD 或带一个一次性的 query，不要把即将更换的正式键预热。
 */
const VG_V = "?v=20261107b";

// 纯静态预渲染：首页除 FactoryTourRail（工厂视频轨，构建时查一次 videos 表）外
// 全是下方写死的常量，没有按请求取数的内容。曾经 prerender = false 的理由是
// 多语言 rewrite 目标（/en/ /zh/ 内部重写到 /），而 i18n 的 MULTILINGUAL_ENABLED
// 已关、语言路由全 404，该理由不复存在。SSR 只让每个冷缓存的边缘节点先冷启动
// Worker 再查一次库（实测 TTFB 4s+），静态化后 HTML 由边缘直出。
// 代价：视频轨增删视频要重新部署才上首页（/about/ 仍 SSR，照常即时反映）。

// 首页是纯代码页面：标题、副标题、SEO 信息全部写死在下方常量中，
// 不依赖数据库 pages 表（home 记录已删除，/home/ 影子路由随之消失）。
// 如需修改首页文案 / SEO，直接编辑下面的常量，改完重新构建或重启生效。
// <title> 由 BaseLayout 拼成 `{pageTitle} | MEIYU`（后缀占 8 字），Google 约 60 字截断，
// 所以这里必须 ≤ 52 字。品牌名不写进来——后缀已经带了，写两次就是白占位置
// （改前本页 title 是 110 字，全站最严重的一页）。描述同理 ≤ 160。
const pageTitle = "Aluminum Ceiling & Facade Systems Manufacturer";
const pageDescription =
  "Aluminum veneer, ceiling tiles, honeycomb, baffle and fluted panels. Custom CNC fabrication, PVDF and powder coating, BIM support, factory direct.";
const keywords = [
  "aluminum veneer",
  "aluminum facade cladding",
  "aluminum ceiling panels",
  "aluminum honeycomb panel",
  "aluminum baffle ceiling",
  "fluted aluminum panel",
  "PVDF coated aluminum",
  "building materials manufacturer",
  "Meiyu Aluminum",
];
const heroTitle = "Aluminum Building Materials You Can Trust";
const heroSubtitle =
  "Professional supplier of aluminum ceiling systems, facade panels & wall cladding";

/**
 * 首页产品展示的 8 个品类，与 MegaMenu 同源。
 * 增删品类只改这一个数组，卡片模板自动渲染（每行 4 个，扁平卡）。
 */
const PRODUCT_LINES = [
  {
    href: "/categories/aluminum-veneer/",
    img: "https://file.meiyualuminum.com/home/mega-menu/aluminum-veneer.webp",
    title: "Aluminum Veneer",
    alt: "Aluminum Veneer — curved and flat facade cladding panels",
  },
  {
    href: "/categories/aluminum-strip-panel/",
    img: "https://file.meiyualuminum.com/home/mega-menu/aluminum-strip-panel.webp",
    title: "Aluminum Strip Panel",
    alt: "Aluminum Strip Panel — linear facade and soffit cladding",
  },
  {
    href: "/categories/u-shaped-aluminum-square-tube/",
    img: "https://file.meiyualuminum.com/home/mega-menu/u-shaped-aluminum-square-tube.webp",
    title: "U-Shaped Aluminum Square Tube",
    alt: "U-Shaped Aluminum Square Tube — open baffle ceiling system",
  },
  {
    href: "/categories/aluminum-honeycomb-core-panel/",
    img: "https://file.meiyualuminum.com/home/mega-menu/aluminum-honeycomb-core-panel.webp",
    title: "Aluminum Honeycomb Core Panel",
    alt: "Aluminum Honeycomb Core Panel — lightweight high-strength cladding",
  },
  {
    href: "/categories/aluminum-ceiling-tile/",
    img: "https://file.meiyualuminum.com/home/mega-menu/aluminum-ceiling-tile.webp",
    title: "Aluminum Ceiling Tile",
    alt: "Aluminum Ceiling Tile — modular lay-in and clip-in panels",
  },
  {
    href: "/categories/aluminum-square-tube/",
    img: "https://file.meiyualuminum.com/home/mega-menu/aluminum-square-tube.webp",
    title: "Aluminum Square Tube",
    alt: "Aluminum Square Tube — linear ceiling and wall baffle system",
  },
  {
    href: "/categories/fluted-aluminum-panel/",
    img: "https://file.meiyualuminum.com/home/mega-menu/fluted-aluminum-panel.webp",
    title: "Fluted Aluminum Panel",
    alt: "Fluted Aluminum Panel — decorative wall and ceiling cladding",
  },
  {
    href: "/categories/aluminum-skirting-board/",
    img: "https://file.meiyualuminum.com/home/mega-menu/aluminum-skirting-board.webp",
    title: "Aluminum Skirting Board",
    alt: "Aluminum Skirting Board — decorative wall base trim",
  },
];

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Meiyu Aluminum",
  url: Astro.site,
};
---

<BaseLayout
  pageTitle={pageTitle}
  description={pageDescription}
  keywords={keywords}
  hideTitle
  transparentHeader
>
  {/* 预连接 CDN，省去 DNS+TCP+TLS 握手时间 */}
  <Fragment slot="head">
    <link rel="preconnect" href="https://file.meiyualuminum.com" crossorigin />
    {
      /* hero 底图就是本页的 LCP 元素：放进 head 让预加载扫描器第一时间排队。
        改前它挂在 .video-hero 的 background-image 上，要等 CSS 下载解析完才被发现，
        冷启动实测 7~8s 才画出来，Lighthouse 桌面/移动双双报 NO_LCP。 */
    }
    <link
      rel="preload"
      as="image"
      href="https://file.meiyualuminum.com/meiyu-video-4.webp"
      fetchpriority="high"
    />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

  <!-- ===== Full-screen Video Hero Banner ===== -->
  <section class="video-hero">
    {
      /* LCP 元素：真实 <img> 垫在视频下面。视频帧不参与 LCP 候选，CSS 背景图又要等
        CSS 到达才被发现；<img> 写在 HTML 里，扫描器解析到 body 第一行就排队。
        视频首帧就绪后盖住它；视频失败时它就是兜底画面（取代旧的 CSS 背景）。
        alt 必须非空：Chrome 把 alt="" 当装饰图排除出 LCP 候选，而这张底图
        就是本页的 LCP 元素——空 alt 会让 DevTools/Lighthouse 报 NO_LCP。 */
    }
    <img
      class="video-hero-poster"
      src="https://file.meiyualuminum.com/meiyu-video-4.webp"
      alt="Aluminum ceiling and facade projects by MEIYU"
      width="1200"
      height="620"
      fetchpriority="high"
      decoding="async"
    />
    {
      /* markup 一律 preload="none"：HTML 解析阶段不发任何媒体请求，让 hero
        底图独占首屏带宽（metadata 也要排队抢连接，移动端实测拖慢底图）；
        下载时机由下方 JS 在 window load + 主线程空闲时接管。
        poster 必须给：<video> 不带 poster 时 Chrome 用「首帧」当 LCP 候选，
        而首帧要等整片下完才画——移动端实测被图片队列堵到 30s+，LCP 直接爆掉。
        poster 与上方 <img> 同一 URL（已在 head preload 命中缓存），秒画，
        LCP 候选因此锁定在首屏就绪那一刻，不再随视频下载时长漂移。 */
    }
    <video
      class="video-hero-bg"
      muted
      loop
      playsinline
      preload="none"
      poster="https://file.meiyualuminum.com/meiyu-video-4.webp"
    >
      {
        /* 版本号是必需的，不是装饰：R2 自定义域名对这类文件回 `cache-control:
          max-age=31536000`（一年），而键名不变。业主 2026-10-28 重传了视频，
          源站与边缘都已是新字节，但回访浏览器的旧条目还有一年才过期——
          不改 URL 就只能你自己 Ctrl+F5 看得到。换视频时跟着改 ?v= 。 */
      }
      <source
        src="https://file.meiyualuminum.com/meiyu-video-3.mp4?v=20261028#t=0.1"
        type="video/mp4"
      />
    </video>
    <div class="video-hero-overlay"></div>
    <div class="video-hero-content">
      <h1>{heroTitle}</h1>
      <p>{heroSubtitle}</p>
      <div class="hero-cta-row">
        <button type="button" class="hero-cta-primary" data-open-inquiry-modal
          >Get a Quote</button
        >
        <a href="/products/" class="hero-cta-outline">View All Products</a>
      </div>
    </div>
  </section>

  {
    /* ===== Video Gallery Section (scroll-triggered autoplay) =====
       紧跟 banner 的第一块：这里全是已完工项目的实拍视频（2026-10-13 用户指定），
       把最强的信任资产放在最前；12 道工序带移到 Explore Our Product Lines 之后。 */
  }
  <section class="video-gallery-section" id="videoGallery">
    <div class="vg-container">
      <div class="vg-header">
        <span class="vg-eyebrow">Real Projects</span>
        <div class="vg-gold-line"></div>
        <h2>See MEIYU<sup>&reg;</sup> Projects in <span>Action</span></h2>
        <p>
          Installed ceilings and facades filmed after handover — real buildings,
          real sites, not renders.
        </p>
      </div>
      {
        /* 六格一律先渲染 <img> 封面（竖屏 9:16 webp，39~63KB）：普通 lazy 队列
          按 DOM 顺序加载，不会比后面章节的图更慢；视频地址挂在 data-vg-src 上，
          首格进视口自播、其余点击才注入 <video> 全力加载（业主 2026-11-06 口径：
          整站只剩 hero + 首格两个视频请求）。 */
      }
      <div class="vg-grid">
        <div
          class="vg-item"
          data-vg-src={`https://file.meiyualuminum.com/video-project/xiamen-205e2-project.mp4${VG_V}#t=0.1`}
          data-vg-auto
        >
          <div class="vg-cell">
            <img
              class="vg-cover"
              src={VG_COVERS["vg-xiamen-205e2"]}
              alt="Xiamen 205E2 aluminum facade project video cover"
              loading="lazy"
              decoding="async"
              width="480"
              height="854"
            />
          </div>
          <button type="button" class="vg-play" data-vg-play>
            <svg
              class="vg-ic-play"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M8 5v14l11-7z" fill="currentColor"></path></svg
            >
            <svg
              class="vg-ic-pause"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"
              ></path></svg
            >
            <span class="vg-play-text">Play</span>
          </button>
        </div>
        <div
          class="vg-item"
          data-vg-src={`https://file.meiyualuminum.com/video-project/liangjiang-hub-project.mp4${VG_V}`}
        >
          <div class="vg-cell">
            <img
              class="vg-cover"
              src={VG_COVERS["vg-liangjiang-hub"]}
              alt="Liangjiang Hub aluminum ceiling project video cover"
              loading="lazy"
              decoding="async"
              width="480"
              height="854"
            />
          </div>
          <button type="button" class="vg-play" data-vg-play>
            <svg
              class="vg-ic-play"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M8 5v14l11-7z" fill="currentColor"></path></svg
            >
            <svg
              class="vg-ic-pause"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"
              ></path></svg
            >
            <span class="vg-play-text">Play</span>
          </button>
        </div>
        <div
          class="vg-item"
          data-vg-src={`https://file.meiyualuminum.com/video-project/wuhan-gateway-trade-center.mp4${VG_V}`}
        >
          <div class="vg-cell">
            <img
              class="vg-cover"
              src={VG_COVERS["vg-wuhan-gateway-trade-center"]}
              alt="Wuhan Gateway Trade Center facade project video cover"
              loading="lazy"
              decoding="async"
              width="480"
              height="854"
            />
          </div>
          <button type="button" class="vg-play" data-vg-play>
            <svg
              class="vg-ic-play"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M8 5v14l11-7z" fill="currentColor"></path></svg
            >
            <svg
              class="vg-ic-pause"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"
              ></path></svg
            >
            <span class="vg-play-text">Play</span>
          </button>
        </div>
        <div
          class="vg-item"
          data-vg-src={`https://file.meiyualuminum.com/video-project/chengdu-cloud-plaza-canopy-project.mp4${VG_V}`}
        >
          <div class="vg-cell">
            <img
              class="vg-cover"
              src={VG_COVERS["vg-chengdu-cloud-plaza-canopy"]}
              alt="Chengdu Cloud Plaza canopy project video cover"
              loading="lazy"
              decoding="async"
              width="480"
              height="854"
            />
          </div>
          <button type="button" class="vg-play" data-vg-play>
            <svg
              class="vg-ic-play"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M8 5v14l11-7z" fill="currentColor"></path></svg
            >
            <svg
              class="vg-ic-pause"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"
              ></path></svg
            >
            <span class="vg-play-text">Play</span>
          </button>
        </div>
        <div
          class="vg-item"
          data-vg-src={`https://file.meiyualuminum.com/video-project/hangzhou-gateway-tower-garage.mp4${VG_V}`}
        >
          <div class="vg-cell">
            <img
              class="vg-cover"
              src={VG_COVERS["vg-hangzhou-gateway-tower-garage"]}
              alt="Hangzhou Gateway Tower garage facade project video cover"
              loading="lazy"
              decoding="async"
              width="480"
              height="854"
            />
          </div>
          <button type="button" class="vg-play" data-vg-play>
            <svg
              class="vg-ic-play"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M8 5v14l11-7z" fill="currentColor"></path></svg
            >
            <svg
              class="vg-ic-pause"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              aria-hidden="true"
              ><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"
              ></path></svg
            >
            <span class="vg-play-text">Play</span>
