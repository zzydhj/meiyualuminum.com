---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { supabase } from "../lib/supabase";

// Fetch home page data from Supabase
const { data: homePage, error } = await supabase
  .from("pages")
  .select("*")
  .eq("slug", "home")
  .eq("status", "published")
  .single();

if (error) {
  console.error("Failed to fetch home page:", error);
}

const pageTitle = homePage?.seo_title || homePage?.title || "Home";
const pageDescription = homePage?.seo_description || "";
const keywords = homePage?.keywords ?? [];

// Custom per-page code (plain text columns: custom_css / custom_js)
const customCss = homePage?.custom_css ?? "";
const customJs = homePage?.custom_js ?? "";

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Meiyu Aluminum",
  "url": Astro.site,
};
---

<BaseLayout pageTitle={pageTitle} description={pageDescription} keywords={keywords} customCss={customCss} customJs={customJs} hideTitle>
  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

  <!-- ===== Full-screen Video Hero Banner ===== -->
  <section class="video-hero">
    <video class="video-hero-bg" autoplay muted loop playsinline preload="auto" poster="https://meiyualuminum.com/wp-content/uploads/2026/07/wsW3FpIdZh.jpeg">
      <source src="https://file.meiyualuminum.com/meiyu-factory-video.webm" type="video/webm" />
    </video>
    <div class="video-hero-overlay"></div>
    <div class="video-hero-content">
      <h1>{homePage?.hero_title || pageTitle}</h1>
      {homePage?.hero_subtitle && <p>{homePage.hero_subtitle}</p>}
    </div>
  </section>

  <!-- Page content (HTML from database) -->
  {homePage?.content && (
    <div class="page-content" set:html={homePage.content} />
  )}

  <!-- ===== Solutions Section (Bronze) ===== -->
  <section class="solutions-section-bronze">
    <div class="solutions-container-bronze">
      <div class="section-header-bronze">
        <span class="eyebrow-bronze">What We Offer (Bronze Version)</span>
        <div class="gold-line-bronze"></div>
        <h2>Tailored Solutions for <span>Every Project</span></h2>
        <p>From concept to completion, MEIYU<sup style="font-size:0.65em;color:#C0A882;">®</sup> delivers precision-engineered aluminum ceiling &amp; wall systems built for performance and lasting aesthetics.</p>
      </div>
      <div class="solutions-grid-bronze">
        <div class="card-bronze">
          <img src="https://meiyualuminum.com/wp-content/uploads/2026/07/wsW3FpIdZh.jpeg" alt="Aluminum Ceiling Systems" class="card-img-bronze">
          <div class="card-body-bronze">
            <span class="card-tag-bronze">Manufacturing</span>
            <h3>Premium Aluminum Systems</h3>
            <p>Durable, low-maintenance aluminum ceiling and facade systems tailored for commercial and civic developments.</p>
            <ul>
              <li>Fire-resistant &amp; weather-proof</li>
              <li>Acoustic performance certified</li>
              <li>Compliant with global standards</li>
            </ul>
          </div>
        </div>
        <div class="card-bronze card-highlight-bronze">
          <img src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=800&q=80" alt="Custom Design & 3D Modeling" class="card-img-bronze">
          <div class="card-body-bronze">
            <span class="card-tag-bronze">Core Competence</span>
            <h3>Custom Design Capabilities</h3>
            <p>We transform your architectural vision into reality with unmatched precision, offering comprehensive design support from concept to execution.</p>
            <ul>
              <li>High-Precision 3D Modeling</li>
              <li>Shop Drawing Refinement</li>
              <li>BIM Coordination &amp; Analysis</li>
            </ul>
          </div>
        </div>
        <div class="card-bronze">
          <img src="https://meiyualuminum.com/wp-content/uploads/2026/07/wsW3FpIdZh.jpeg" alt="Smart Engineering Support" class="card-img-bronze">
          <div class="card-body-bronze">
            <span class="card-tag-bronze">Engineering</span>
            <h3>Smart Engineering Support</h3>
            <p>From mock-up samples to on-site technical guidance, our engineers work alongside your team through final installation.</p>
            <ul>
