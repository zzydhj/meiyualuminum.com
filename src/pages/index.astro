---
import BaseLayout from "../layouts/BaseLayout.astro";

// 首页是纯代码页面：标题、副标题、SEO 信息全部写死在下方常量中，
// 不依赖数据库 pages 表（home 记录已删除，/home/ 影子路由随之消失）。
// 如需修改首页文案 / SEO，直接编辑下面的常量，改完重新构建或重启生效。
const pageTitle = "Meiyu Aluminum - Professional Automotive Parts Supplier";
const pageDescription = "OEM quality brake pads, filters, and engine components for Toyota, Honda, and more.";
const keywords = ["automotive parts", "OEM quality", "brake pads", "oil filters", "Meiyu Aluminum"];
const heroTitle = "Aluminum Building Materials You Can Trust";
const heroSubtitle = "Professional supplier of aluminum ceiling systems, facade panels & wall cladding";

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Meiyu Aluminum",
  "url": Astro.site,
};
---

<BaseLayout pageTitle={pageTitle} description={pageDescription} keywords={keywords} hideTitle transparentHeader>
  <!-- 预连接 CDN，省去 DNS+TCP+TLS 握手时间 -->
  <Fragment slot="head">
    <link rel="preconnect" href="https://file.meiyualuminum.com" crossorigin />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

  <!-- ===== Full-screen Video Hero Banner ===== -->
  <section class="video-hero">
    <video class="video-hero-bg" muted loop playsinline preload="none" poster="https://file.meiyualuminum.com/meiyu-video-4.webp">
      <source src="https://file.meiyualuminum.com/meiyu-video-3.mp4" type="video/mp4" />
    </video>
    <div class="video-hero-overlay"></div>
    <div class="video-hero-content">
      <h1>{heroTitle}</h1>
      <p>{heroSubtitle}</p>
    </div>
  </section>

  <!-- ===== Solutions Section (Bronze) ===== -->
  <section class="solutions-section-bronze">
    <div class="solutions-container-bronze">
      <div class="section-header-bronze">
        <span class="eyebrow-bronze">What We Offer</span>
        <div class="gold-line-bronze"></div>
        <h2>Tailored Solutions for <span>Every Project</span></h2>
        <p>From concept to completion, MEIYU<sup style="font-size:0.65em;color:#C0A882;">®</sup> delivers precision-engineered aluminum ceiling &amp; wall systems built for performance and lasting aesthetics.</p>
      </div>
      <div class="solutions-grid-bronze">
        <div class="card-bronze">
          <img src="https://file.meiyualuminum.com/home/custom-aluminum-single-panel-design-factory-installation-building-facade.webp" alt="Custom aluminum single panel design showcase including technical drawings, factory production, shipping, on-site installation by worker on suspended platform, and completed building facade in grey metallic finish" class="card-img-bronze" loading="lazy" width="720" height="480">
          <div class="card-body-bronze">
            <span class="card-tag-bronze">Customization</span>
            <h3>Aluminum Panel &amp; Batten Custom Systems</h3>
            <p>High-quality aluminum building materials engineered for commercial and civic architecture, with full support for custom dimensions and profiles.</p>
            <ul>
              <li>Multi-spec sizing, manufactured to drawing</li>
              <li>Versatile finishes &mdash; PVDF / powder coating available</li>
              <li>Compliant with international building material standards</li>
            </ul>
            <button type="button" class="card-cta-bronze" data-open-inquiry-modal>Start Customization</button>
          </div>
        </div>
        <div class="card-bronze card-highlight-bronze">
          <img src="https://file.meiyualuminum.com/home/meiyu-engineer-architectural-3d-modeling-laser-scanner-construction-site.webp" alt="MEIYU engineer in safety vest and hard hat reviewing a high-precision 3D building model on a laptop at a construction site with a 3D laser scanner on tripod" class="card-img-bronze" loading="lazy" width="720" height="480">
          <div class="card-body-bronze">
            <span class="card-tag-bronze">Engineering</span>
            <h3>High-Precision 3D Modeling Support</h3>
            <p>From prototype samples to on-site technical guidance, our engineering team leverages high-precision 3D models to support every stage of project delivery and installation.</p>
            <ul>
              <li>High-Precision 3D Modeling &amp; Clash Detection</li>
              <li>BIM Coordination &amp; Data Delivery</li>
              <li>Full Project Lifecycle Technical Support</li>
            </ul>
            <button type="button" class="card-cta-bronze" data-open-inquiry-modal>Request 3D Modeling</button>
          </div>
        </div>
        <div class="card-bronze">
          <img src="https://file.meiyualuminum.com/home/south-gate-tower-aluminum-single-panel-curtain-wall-construction-drawing-3d-render.webp" alt="South Gate Tower architectural drawing set showing north facade elevation, aluminum single panel curtain wall construction details, exploded axonometric view, and 3D rendered exterior perspective" class="card-img-bronze" loading="lazy" width="720" height="480">
          <div class="card-body-bronze">
            <span class="card-tag-bronze">Core Competence</span>
            <h3>Expert Shop Drawing Capabilities</h3>
            <p>From schematic design to on-site execution, we deliver end-to-end shop drawing services that translate design intent into precise, production-ready documentation.</p>
            <ul>
              <li>Shop Drawing Production &amp; Submission</li>
              <li>Connection Detail Refinement &amp; Optimization</li>
              <li>Seamless Coordination with Design Institutes &amp; Main Contractors</li>
            </ul>
            <button type="button" class="card-cta-bronze" data-open-inquiry-modal>Request Shop Drawings</button>
          </div>
        </div>
      </div>
    </div>
  </section>

