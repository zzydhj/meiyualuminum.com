---
/**
 * tags/[tag].astro — 标签文章列表第 1 页
 *
 * - 第 2~N 页由 tags/[tag]/page/[page].astro 生成（/tags/{tag}/page/N/）
 * - 每页 PAGE_SIZE 篇，与博客列表共用分页配置与导航组件
 */
import Breadcrumb from "../../components/Breadcrumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostGrid from "../../components/PostGrid.astro";
import PaginationNav from "../../components/PaginationNav.astro";
import { PAGE_SIZE } from "../../lib/pagination";
import { fetchAllTagPosts, groupPostsByTag } from "../../lib/tagPosts";

export async function getStaticPaths() {
  const byTag = groupPostsByTag(await fetchAllTagPosts());

  return [...byTag.entries()].map(([tag, tagged]) => ({
    params: { tag },
    props: {
      posts: tagged.slice(0, PAGE_SIZE),
      currentPage: 1,
      totalPages: Math.max(1, Math.ceil(tagged.length / PAGE_SIZE)),
    },
  }));
}

const { tag } = Astro.params;
const { posts, currentPage, totalPages } = Astro.props;
const pageDescription = `Browse all blog posts tagged with "${tag}".`;
const tagPath = encodeURIComponent(tag);
---

<BaseLayout pageTitle={tag} description={pageDescription}>
  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Tags", url: "/tags/" },
      { name: tag, url: `/tags/${tagPath}/` },
    ]}
  />
  <p>Posts tagged with "{tag}"</p>
  <PostGrid posts={posts} />
  <PaginationNav
    currentPage={currentPage}
    totalPages={totalPages}
    basePath={`/tags/${tagPath}/page`}
    firstPageUrl={`/tags/${tagPath}/`}
  />
</BaseLayout>
