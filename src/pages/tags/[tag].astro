---
import Breadcrumb from "../../components/Breadcrumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPost from "../../components/BlogPost.astro";
import { supabase } from "../../lib/supabase";

export async function getStaticPaths() {
  const { data: allPosts } = await supabase
    .from("posts")
    .select("*")
    .eq("status", "published");

  const posts = allPosts ?? [];

  const uniqueTags = [
    ...new Set(posts.map((post) => post.tags as string[]).flat()),
  ];

  return uniqueTags.map((tag) => {
    const filteredPosts = posts.filter((post) =>
      (post.tags as string[]).includes(tag),
    );
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const pageDescription = `Browse all blog posts tagged with "${tag}".`;
---

<BaseLayout pageTitle={tag} description={pageDescription}>
  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Tags", url: "/tags/" },
      { name: tag, url: `/tags/${encodeURIComponent(tag)}/` },
    ]}
  />
  <p>Posts tagged with "{tag}"</p>
  <ul>
    {
      posts.map((post) => (
        <BlogPost url={`/blog/${post.slug}/`} title={post.title} />
      ))
    }
  </ul>
</BaseLayout>
