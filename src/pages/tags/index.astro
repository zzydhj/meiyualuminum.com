---
import Breadcrumb from "../../components/Breadcrumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase } from "../../lib/supabase";

const { data: allPosts } = await supabase
  .from("posts")
  .select("tags")
  .eq("status", "published");

const posts = allPosts ?? [];

// tags is an array type, flatten and deduplicate
const tags = [...new Set(
  posts
    .map((post) => post.tags ?? [])
    .flat()
)];

const pageTitle = "Tags";
const pageDescription = "Browse all blog post tags and topics.";
---

<BaseLayout pageTitle={pageTitle} description={pageDescription}>
  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Tags", url: "/tags/" },
    ]}
  />
  <div class="tags">
    {
      tags.map((tag) => (
        <p class="tag">
          <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
        </p>
      ))
    }
  </div>
</BaseLayout>

<style>
  a {
    color: #00539f;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
  }
  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: 0.5em;
    padding: 0.5em 1em;
    font-size: 1.15em;
    background-color: #f8fcfd;
  }
</style>
