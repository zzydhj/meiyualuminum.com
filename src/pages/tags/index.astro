---
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase } from "../../lib/supabase";

// SSR：标签是从已发布文章聚合出来的，文章一进 draft 本页就该跟着空掉。
// 转静态的话它会停在旧标签列表上，点进去全是 404 —— 改库即生效。
export const prerender = false;

const { data: allPosts } = await supabase
  .from("posts")
  .select("tags")
  .eq("status", "published");

const posts = allPosts ?? [];

// tags is an array type, flatten and deduplicate
const tags = [...new Set(posts.map((post) => post.tags ?? []).flat())];

const pageTitle = "Tags";
const pageDescription = "Browse all blog post tags and topics.";
---

<BaseLayout pageTitle={pageTitle} description={pageDescription} hideTitle>
  <PageHero
    slim
    imageAlt={pageTitle}
    titleWhite="All"
    titleGold="Tags"
    crumb={{
      items: [
        { name: "Home", url: "/" },
        { name: "Tags", url: "/tags/" },
      ],
    }}
  />
  <div class="tags">
    {
      tags.map((tag) => (
        <p class="tag">
          <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
        </p>
      ))
    }
  </div>
</BaseLayout>

<style>
  a {
    color: #00539f;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
  }
  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: 0.5em;
    padding: 0.5em 1em;
    font-size: 1.15em;
    background-color: #f8fcfd;
  }
</style>
