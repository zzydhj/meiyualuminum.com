---
/**
 * tags/[tag]/page/[page].astro — 标签文章列表第 2~N 页（SSR）
 *
 * - 第 1 页由 tags/[tag].astro 渲染（/tags/{tag}/ 为规范地址），本页只负责第 2 页起
 * - 页码非法或超出范围一律 302 回第 1 页：不留空页，也不产生重复内容
 */
import PageHero from "../../../../components/PageHero.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PostGrid from "../../../../components/PostGrid.astro";
import PaginationNav from "../../../../components/PaginationNav.astro";
import { PAGE_SIZE, resolvePage } from "../../../../lib/pagination";
import { getPostsForTag } from "../../../../lib/tagPosts";

// SSR：跟 tags/[tag].astro 同一个理由 —— 文章量一变，分页边界就得重算。
export const prerender = false;

const { tag, page } = Astro.params;
const tagName = decodeURIComponent(tag ?? "");
const tagPath = encodeURIComponent(tagName);
const tagged = await getPostsForTag(tag ?? "");

if (!tagged) {
  return Astro.redirect("/tags/");
}

const totalPages = Math.ceil(tagged.length / PAGE_SIZE);
const currentPage = resolvePage(page, totalPages);

// 非整数页码 / 小于 2 / 超出总页数，全部回第 1 页（规则见 lib/pagination 的 resolvePage）。
if (currentPage === null) {
  return Astro.redirect(`/tags/${tagPath}/`);
}

const start = (currentPage - 1) * PAGE_SIZE;
const posts = tagged.slice(start, start + PAGE_SIZE);
const pageDescription = `Browse all blog posts tagged with "${tagName}" - page ${currentPage}.`;
---

<BaseLayout
  pageTitle={`${tagName} - Page ${currentPage}`}
  description={pageDescription}
  hideTitle
>
  <PageHero
    slim
    imageAlt={tagName}
    titleWhite="Tag"
    titleGold={tagName}
    subtitle={`Posts tagged with "${tagName}" — Page ${currentPage}`}
    crumb={{
      items: [
        { name: "Home", url: "/" },
        { name: "Tags", url: "/tags/" },
        { name: tagName, url: `/tags/${tagPath}/` },
        {
          name: `Page ${currentPage}`,
          url: `/tags/${tagPath}/page/${currentPage}/`,
        },
      ],
    }}
  />
  <PostGrid posts={posts} />
  <PaginationNav
    currentPage={currentPage}
    totalPages={totalPages}
    basePath={`/tags/${tagPath}/page`}
    firstPageUrl={`/tags/${tagPath}/`}
  />
</BaseLayout>
