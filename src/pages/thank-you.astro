---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const pageTitle = "Thank You";
const pageDescription = "Your inquiry has been sent. Our team will get back to you soon.";
---

<BaseLayout pageTitle={pageTitle} description={pageDescription}>
  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Contact", url: "/contact/" },
      { name: "Thank You", url: "/thank-you/" },
    ]}
  />

  <div class="thank-you">
    <div class="icon" aria-hidden="true">✓</div>
    <h2>Inquiry Sent Successfully</h2>
    <p>
      Thank you for reaching out. Our team has received your inquiry and will
      reply to your email within 24 hours.
    </p>
    <p class="sub">
      If your request is urgent, please email us directly and we will
      prioritize it.
    </p>
    <a href="/" class="back-link">← Back to Home</a>
  </div>
</BaseLayout>

<style>
  .thank-you {
    text-align: center;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    padding: 3rem 1.5rem;
    max-width: 560px;
    margin: 1rem auto;
  }

  .icon {
    width: 64px;
    height: 64px;
    line-height: 64px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: #dcfce7;
    color: #16a34a;
    font-size: 2rem;
    font-weight: bold;
  }

  .thank-you h2 {
    margin: 0 0 0.75rem;
    color: #0d0950;
  }

  .thank-you p {
    color: #475569;
    line-height: 1.7;
    margin: 0 0 0.75rem;
  }

  .thank-you .sub {
    font-size: 0.9rem;
    color: #94a3b8;
  }

  .back-link {
    display: inline-block;
    margin-top: 1rem;
    color: #0053a0;
    text-decoration: none;
    font-weight: 600;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
