    { value: companyFacts.plantArea, label: "Plant in Dongguan" },
    { value: companyFacts.productionLines, label: "Production lines" },
    { value: companyFacts.staff, label: "Staff incl. QC & engineering" },
];

const heroBadges = certBadges;

const storyPoints = [
    "Own plant and own lines — 15,000 m² and 15 production lines in Dongguan City, Guangdong",
