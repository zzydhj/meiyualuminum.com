<script>
    /* 工厂视频原地播放（2026-10-13 用户指定）：点封面的大播放按钮，
     就给本卡 video 加 controls 并在当前页当前位置起播，不跳详情页；
     标题链接仍去详情页（想看全屏/评论时）。
     同一时刻只播一条：新的起播前先暂停别的，避免十几条流同时抢带宽。 */
    const abVideos = Array.from(
        document.querySelectorAll("video[data-ab-video]"),
    ) as HTMLVideoElement[];

    for (const v of abVideos) {
        v.addEventListener("play", () => {
            for (const other of abVideos) if (other !== v) other.pause();
            v.closest(".ab-video-thumb")?.setAttribute("data-playing", "true");
        });
        v.addEventListener("pause", () => {
            v.closest(".ab-video-thumb")?.removeAttribute("data-playing");
        });
    }

    document.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest?.("[data-ab-play]");
        if (!btn) return;
        const video = btn
            .closest(".ab-video-thumb")
            ?.querySelector("video[data-ab-video]") as HTMLVideoElement | null;
        if (!video) return;
        video.controls = true;
        video.muted = false; // 显式点击属用户手势，允许解除静音
        video.play().catch(() => {
            // 个别浏览器仍拦截时退回收音静音再试
            video.muted = true;
            video.play().catch(() => {});
        });
    });
</script>
