const qcTests = [
    {
        t: "Coating adhesion",
        d: "Cross-cut and pull-off checks on every coating batch.",
    },
    {
        t: "Salt spray",
        d: "Corrosion exposure testing for coastal and high-humidity specs.",
    },
    {
        t: "Sag resistance",
        d: "Film sag evaluated under standard simulated conditions.",
    },
];

/* ── 证据索引（回应采购评审缺口 1、2：性能描述要有可核验的对应证据）──
   只列附录 A 已有的真实认证与自有 QC 项目；没做过的不列、不编。
   评审点名要求：ASTM E84 与 EN 13501-1 分属两套体系，不能互替，此处写明。 */
const evidenceIndex = [
    {
        item: "ISO 9001",
        asks: "Is quality held by a system, or by whoever is on shift?",
        scope: "Company-wide quality management system.",
        obtain: "Certificate copy issued at quotation stage.",
    },
    {
        item: "CE marking + Declaration of Performance",
        asks: "Can this be lawfully installed on an EU project?",
        scope: "EU market access under the Construction Products Regulation, declared per product family and its applicable standard.",
        obtain: "Supplied with the submittal pack.",
    },
    {
        item: "ASTM E84 Class A",
        asks: "What is the surface burning behaviour for a US or Gulf specification?",
        scope: "Flame spread index 0–25 by the Steiner tunnel method. A North American result — it does not substitute for EN 13501-1.",
        obtain: "Test report on request; report numbers are not published.",
    },
    {
        item: "EN 13501-1 B-s1,d0",
        asks: "What is the European reaction-to-fire class of the finished panel?",
        scope: "European classification of the coated assembly. It does not substitute for an ASTM E84 result — we supply whichever your specification calls for, or both.",
        obtain: "Report on request, naming the tested build-up.",
    },
    {
        item: "EN 13964 declarations",
        asks: "Are dimensions, tolerances, load class and corrosion class actually stated?",
        scope: "Suspended ceiling system characteristics declared for your configuration — we do not quote generic figures for a specific project.",
        obtain: "Written into the shop drawings and submittal.",
    },
    {
        item: "Coating adhesion · salt spray · sag",
        asks: "Will the finish hold in a coastal or humid building?",
        scope: "Run in our own QC lab on site against standard exposure conditions, logged per coating batch.",
        obtain: "Batch records shared on request.",
    },
    {
        item: "Alloy and temper evidence",
        asks: "Is it really the stated 3003 / 5052 at the stated gauge?",
        scope: "Material traceability linked to the batch rolled into your order.",
        obtain: "On request — confirm the exact document set at quotation.",
    },
    {
        item: "Panel barcode → drawing position",
        asks: "If a panel is wrong, can we find where it belongs and who signed it off?",
        scope: "Each panel carries a code tied to its setting-out position, its production stage and its inspection record.",
        obtain: "A sample traceability record is available before you commit.",
    },
];

/* ── 出口交付文档包（回应评审缺口 3、6：海外能不能装、出问题找谁）──
   评审给的诚实回退路径：暂无可核验海外项目记录时，改为展示完整英文文档与远程支持流程。
   本块只写站内已真实存在的能力；差旅与现场服务写成“按项目书面约定”，不承诺到场。 */
const exportPack = [
    {
        t: "English shop drawings",
        d: "Setting-out layout, reflected-ceiling coordination and edge, joint and cut-out details — drawn and agreed with your team before a single panel is cut.",
        icon: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h5",
    },
    {
        t: "Panel-by-panel packing list",
        d: "Every crate and bundle listed against its drawing position, so your crew knows which box holds which panel before anything is opened.",
        icon: "M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01",
    },
    {
        t: "English installation manual",
        d: "Order of work, fixing details, tooling and the demount method for routine service access — written so a local crew can build from it without translating.",
        icon: "M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z",
    },
    {
        t: "Remote support before and during installation",
        d: "A live screen-share over the grid setting-out before your crew starts, then WhatsApp or email support while they build. First reply within 1 hour.",
        icon: "M23 7l-7 5 7 5V7zM14 5H3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2z",
    },
    {
        t: "What we supply vs what you buy locally",
        d: "Panels always. Carriers, hangers, perimeter trim and fixings are itemised line by line in the quotation, so nothing arrives missing and nothing gets double-ordered on site.",
        icon: "M12 3v18M5 8l7-5 7 5M5 16l7 5 7-5",
    },
    {
        t: "Site attendance, stated not assumed",
        d: "Where an installation genuinely needs factory supervision, the scope, duration and travel terms are agreed in writing per project rather than implied by marketing.",
        icon: "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75",
    },
];

/* ── 为什么直接找工厂 ── */
const whyCards = [
    {
        t: "Factory-Direct Pricing",
        d: "Your quote comes off the production line, not through a trader's margin.",
        icon: "M3 21V10l6 4V10l6 4V6l6 3v12zM3 21h18",
    },
    {
        t: "In-House Engineering",
        d: "Shop drawing review, CAD layout and detail fixes before a single panel is cut.",
        icon: "M10 2v7.5L4.7 19.5a2 2 0 0 0 1.8 3h11a2 2 0 0 0 1.8-3L14 9.5V2M8.5 2h7M7 16h10",
    },
    {
        t: "OEM & ODM Ready",
        d: "Your alloy, thickness, perforation, colour and packaging — developed on site.",
        icon: "M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5M3 17l9 5 9-5",
    },
    {
        t: "Predictable Lead Time",
        d: "20–25 working days for standard items, 30–40 for custom work, stated up front.",
        icon: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2",
    },
    {
        t: "Export Documentation",
        d: "Delivered across Southeast Asia, the Middle East, Africa and South America.",
        icon: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z",
    },
    {
        t: "Written Warranty",
        d: "10 years on PE coating, 15 years on PVDF, 1 year on materials and workmanship.",
        icon: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM9 12l2 2 4-4",
    },
];

/* ── FAQ（同一份数据渲染 + 输出 FAQPage 结构化数据）── */
const faqs = [
    {
        q: "Where is your factory, and can I visit?",
        a: "Dongguan City, Guangdong Province, China. In-person visits and live video walk-throughs both work — message us on WhatsApp and we will send directions plus a walk-through of the line before you book anything.",
    },
    {
        q: "Are you a manufacturer or a trading company?",
        a: "Manufacturer. We run 15 production lines in our own 15,000 m² plant; forming, perforation, coating and packing all happen on that site, which is why lead times and tolerances are ours to control.",
    },
    {
        q: "Can I get samples before ordering?",
        a: "Yes. Colour, perforation and surface finish can be confirmed on physical samples before production. Tell us the RAL reference or the texture you want and our team matches it in-house.",
    },
    {
        q: "What is your minimum order quantity?",
        a: "Our standard offer is 50 m² per item for standard products and 1,000 m² for custom perforation or special profiles. Smaller trial quantities can be discussed at quotation stage.",
    },
    {
        q: "How long does production take?",
        a: "Standard items typically run 20–25 working days; custom perforation or special surfaces 30–40 days, depending on order size and production schedule. Confirm the date against your quotation.",
    },
    {
        q: "Do the panels meet fire regulations?",
        a: "Aluminium is non-combustible. Finished panels are supplied and tested to EN 13501-1 Class B-s1,d0 and ASTM E84 Class A. Test reports and the Declaration of Performance are provided on request at the quotation stage.",
    },
    {
        q: "Which fire standard applies to my project — ASTM or EN?",
        a: "They answer different authorities and are not interchangeable. US and most Gulf specifications look for ASTM E84 surface-burning data; European specifications look for an EN 13501-1 reaction-to-fire class plus a Declaration of Performance under the Construction Products Regulation. Tell us which your project is being approved against and we supply that one — or both if your consultant wants a cross-check.",
    },
    {
        q: "What exactly is included in a MEIYU quotation?",
        a: "A line-by-line specification (alloy and temper, gauge, panel size, perforation and open area, finish system and colour reference), unit rate and quantity, MOQ per item, lead time, and packing data. Just as importantly it names what is excluded — carriers, hangers, perimeter trim and fixings are listed explicitly as supplied or not supplied, so you can price the whole system rather than guess at the gap. Trade terms, payment stages and port of loading are confirmed on the same document.",
    },
    {
        q: "What happens if panels arrive damaged, short or off-colour?",
        a: "Send photographs, the affected barcode positions and the quantity. Because each panel is traceable to its production and inspection record, we can separate a manufacturing deviation from transit damage without guessing. You get a first reply within 1 hour and a written proposal — replacement, repair or credit — with the freight and labour split stated in it rather than left to argue about later. The claim route and warranty limits are issued with your contract.",
    },
    {
        q: "Do you have references outside China?",
        a: "Our documented project references to date are domestic. For overseas orders we work from the documentation rather than a site-visit history: English shop drawings, a panel-by-panel packing list, an English installation manual and remote support during installation. We would rather show you that pack and a live run on the line than send photographs of a building you cannot verify.",
    },
];

const faqJsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

/* ── 工厂视频：About 只放自托管素材（R2 / 同源）——
   12 段工序视频已上传至 file.meiyualuminum.com/home/video/，slug 统一以 factory- 开头。
   两条约束：
   1) 按 slug 升序而不按 pub_date —— 12 条同一天上传，按日期排等于随机取，
      工序顺序（切割→折弯→喷涂→质检→包装）会整个乱掉。
   2) 过滤下推到数据库（like），不在拉回后才 filter：
      原先 limit(3) 先于 filter 执行，一旦表里混进非自托管条目，本页就会凑不满。
   3) 不设 limit：视频墙 6 列 × 2 行一次全展 12 段（2026-10-13 用户指定）。 */
const { data: dbVideos } = await supabase
    .from("videos")
    .select("slug,title,video_url,thumbnail_url")
    .eq("status", "published")
    .like("slug", "factory-*")
    .order("slug", { ascending: true });

const videos = (dbVideos ?? [])
    .filter((v) => isSelfHostedVideo(v.video_url))
    .map((v, i) => ({
        slug: v.slug,
        title: `${String(i + 1).padStart(2, "0")} · ${v.title}`,
        cover: v.thumbnail_url || firstFrameSrc(v.video_url!),
    }));

/** 索片钩子：没有自有视频时，把“缺视频”变成一次 WhatsApp 对话 */
const tourHooks = [
    {
        label: "Coating line",
        msg: "Hi, please send me a video of your aluminium coating line",
    },
    {
        label: "Perforation & acoustic fleece",
        msg: "Hi, please send me a video of your perforation line and acoustic fleece",
    },
    {
        label: "Packing & container loading",
        msg: "Hi, please send me a video of your packing and container loading",
    },
];
---

<BaseLayout
    pageTitle={pageTitle}
    description={pageDescription}
    keywords={keywords}
    image={IMG_STORY}
    hideTitle
>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <!-- ══════ 1. Hero ══════ -->
    <PageHero
        imageAlt="MEIYU aluminium facade and ceiling projects"
        eyebrow={`About ${companyFacts.brand} · Est. ${companyFacts.established} · Dongguan, Guangdong`}
        titleWhite="A Real Factory Behind"
        titleGold="Every Panel"
        subtitle="MEIYU Aluminum Co., Ltd. forms, perforates, coats and packs architectural aluminium ceiling and facade panels in our own plant — 15,000 m², 15 lines, and an engineering team that answers shop drawings, samples and quotations directly."
        stats={heroStats}
        flush
        crumb={{
            items: [
                { name: "Home", url: "/" },
                { name: "About Us", url: "/about/" },
            ],
        }}
    >
        <button
            type="button"
            class="ab-btn ab-btn--light"
            data-open-inquiry-modal
        >
            Get a Free Quote
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
            >
        </button>
        <a
            class="ab-btn ab-btn--outline-light"
            href={waUrl("Hi, please send me your factory video tour")}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-source="about_hero"
        >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><path d="M8 5.5v13l11-6.5-11-6.5z"></path></svg
            >
            Watch the Factory
        </a>
        <a class="ab-btn ab-btn--ghost-light" href="/products/"
            >Browse Products</a
        >
        {
            /* 认证徽章条：页头的一部分（2026-10-13 用户指定），挂在数据行下方；
            半透明白胶囊适配深色页头底图，样式随 slot 作用域由本页 .ab-badges 提供。 */
        }
        <ul class="ab-badges" slot="badges">
            {heroBadges.map((b) => <li>{b}</li>)}
        </ul>
    </PageHero>

    <!-- ══════ 2. Factory Tour ══════ -->
    <!-- 深色带：与首页工序带/项目带同一套暗色语言，黑白交替提升高级感
         （2026-10-13 用户指定）；页头按深色带惯例走金 eyebrow + 白标题。 -->
    <section class="ab-band ab-band--dark">
        <div class="ab-wrap">
            <div class="ab-head">
                <span class="ab-eyebrow ab-eyebrow--gold">Factory Tour</span>
                <div class="ab-head-rule"></div>
                <h2 class="ab-h2 ab-h2--light">
                    See the Plant <span class="ab-hl">Before You Buy</span>
                </h2>
                <p class="ab-sub">
                    Photos can be staged, so watch the line instead. Anything
                    you need that is not in this list — a specific profile, a
                    coating booth, a packing sequence — we will film it for you.
                </p>
            </div>

            {
                videos.length > 0 ? (
                    <ul class="ab-video-grid">
                        {videos.map((v) => (
                            <li class="ab-video-card">
                                {/* 原地播放、不跳页（2026-10-13 用户指定）：封面区是播放按钮，
                                    点击给 video 加 controls 并在当前卡片内起播；标题保留详情页链接。
                                    cover 是第一帧地址（mp4#t=0.1），必须用 <video>，用 img 会裂图。
                                    竖屏槽与工序视频同比例，整帧入画，烧录字幕不被裁。 */}
                                <div class="ab-video-box">
                                    <span class="ab-video-thumb">
                                        <video
                                            src={v.cover}
                                            muted
                                            playsinline
                                            preload="metadata"
