        href: "/categories/aluminum-honeycomb-core-panel/",
    },
];

/* ── 下单到出货 ── */
const processSteps = [
    {
        n: "01",
        t: "Enquiry & Drawings",
        d: "Send architectural drawings, a BOQ or simply a room size. We come back with a specification recommendation and a quotation.",
    },
    {
        n: "02",
        t: "Sample & Approval",
        d: "Colour, perforation and surface are confirmed on physical samples before tooling or mass production starts.",
    },
    {
        n: "03",
        t: "Production",
        d: "Forming, perforation and coating run on our own 15 lines — standard items typically 20–25 working days.",
    },
    {
        n: "04",
        t: "QC & Packing",
        d: "Each lot is inspected, then packed for export: panels flat in cartons on pallets, carriers and trim boxed separately.",
    },
