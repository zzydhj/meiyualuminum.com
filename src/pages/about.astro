/** WhatsApp 与 FloatingWhatsApp 同一号码；BaseLayout 已全局埋 whatsapp_click 事件 */
const WHATSAPP_NUMBER = "8613509838008";
const waUrl = (msg: string) =>
    `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`;

const pageTitle =
    "About MEIYU Aluminum | Ceiling & Facade Panel Manufacturer in Dongguan";
const pageDescription =
