const keywords = [
    "about meiyu aluminum",
    "aluminum ceiling manufacturer",
    "aluminum facade panel factory",
    "metal ceiling manufacturer china",
    "aluminum panel supplier dongguan",
    "oem aluminum ceiling panels",
];

/* ── 公司数据统一取自 src/lib/companyProfile.ts（单一来源，对齐附录 A）── */
const heroStats = [
