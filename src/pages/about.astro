    },
];

/* ── 认证与自有检测（附录 A 口径，不写证书编号）── */
const certCards = [
    { n: "ISO 9001", s: "Quality management system" },
    { n: "CE", s: "EU conformity under the Construction Products Regulation" },
    {
        n: "ASTM E84 Class A",
        s: "Flame spread index 0–25, Steiner tunnel method",
    },
    {
        n: "EN 13501-1 B-s1,d0",
        s: "Reaction to fire: low smoke, no flaming droplets",
