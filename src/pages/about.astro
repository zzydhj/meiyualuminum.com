        desc: "Open linear baffles and tube ceilings that conceal services above.",
        href: "/categories/aluminum-square-tube/",
    },
    {
        img: `${CDN}home/mega-menu/aluminum-veneer.webp`,
        name: "Veneer & Facade Panel",
        desc: "CNC-formed single-panel veneer for facades, soffits and feature walls.",
        href: "/categories/aluminum-veneer/",
    },
    {
        img: `${CDN}home/mega-menu/fluted-aluminum-panel.webp`,
        name: "Fluted Wall Panel",
        desc: "Ribbed aluminium cladding for interiors and exterior accents.",
