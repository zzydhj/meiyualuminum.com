/* ── 产品族（图与首页 MegaMenu 同源，链到分类页）── */
const productCards = [
    {
        img: `${CDN}home/mega-menu/aluminum-ceiling-tile.webp`,
        name: "Aluminum Ceiling Tile",
        desc: "Clip-in and lay-in modules from 300×300 to 600×1200 mm, solid or perforated.",
        href: "/categories/aluminum-ceiling-tile/",
    },
    {
        img: `${CDN}home/mega-menu/aluminum-strip-panel.webp`,
        name: "Strip & Linear Ceiling",
