---
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase } from "../../lib/supabase";
import {
  getCategoryChain,
  getChildCategoryIds,
  isThinCategory,
  type CategoryNode,
} from "../../lib/categoryPath";
import { currentLang } from "../../lib/i18n";

// SSR：分类页是全站关键词价值最高的着陆页。转静态时新发布一个产品，
// 它所属分类页不会自动列出这个产品，必须重建部署 —— 改库即生效才对。
export const prerender = false;

const lang = currentLang(Astro.locals);

// select 必须带上 seo_title / seo_description / keywords：下面渲染 meta 时要读这三列。
// 以前漏选过，导致数据库里填好的 14 条分类 SEO 文案从未生效、也不报错。
const { data: allCategoriesData } = await supabase
  .from("categories")
  .select(
    "id, name, slug, parent_id, description, seo_title, seo_description, keywords",
  );

const allCategories = (allCategoriesData ?? []) as CategoryNode[];

const slug = decodeURIComponent(Astro.params.slug ?? "");
const category = allCategories.find((c) => c.slug === slug);

// 分类不存在（URL 拼错、或分类被删）→ 302 回分类索引，与标签页同一做法。
if (!category) {
  return Astro.redirect("/categories/");
}

// Build breadcrumb chain from parent categories
const parentChain = await getCategoryChain(category.parent_id);

// Build middle items (parent categories of current)
const middleItems = parentChain;

// Get all child category IDs (including self) for querying products
const allChildIds = getChildCategoryIds(category.id, allCategories);

// Get direct children for display
const children = allCategories.filter(
  (c: CategoryNode) => c.parent_id === category.id,
);

// Query products that belong to any of the category IDs in the tree
// 必须按 lang 过滤：products 表里躺着多语言版本（现在只有 id=8 的铝墙板 zh 行），
// 而 /zh/ 前缀路由已被 i18n 的 MULTILINGUAL_ENABLED=false 停发，中文行在英文站上
// 没有对应页面。不滤的话它会在 /categories/aluminum-wall-panels/ 里多出
// 一张中文卡片并把「Products (N)」的计数一起带错。products 的各个列表路由都有这个过滤，
// 以前只有这一页漏了。
const { data: allProducts, error } = await supabase
  .from("products")
  .select("*")
  .eq("status", "published")
  .eq("lang", lang)
  .order("created_at", { ascending: false });

if (error) {
  console.error("Failed to fetch products for category:", error);
}

const products = (allProducts ?? []).filter((p) => {
  if (!p.category_ids) return false;
  // category_ids may be string[] or number[] from Supabase JSON column
  return (p.category_ids as (string | number)[]).some((id: string | number) =>
    allChildIds.includes(Number(id)),
  );
});

// Use seo_description if available, otherwise fall back to description
const pageDescription = category.seo_description || category.description || "";
const pageTitle = category.seo_title || category.name;
const keywords = category.keywords ?? [];

// 薄分类退出索引：子树里只剩一个产品时，这一页实质就是那个产品页的目录页，
// 而两边填的是同一个主攻词（mesh 那组连 seo_title 都一字不差），等于自己跟自己抢排名。
// noindex 仍是 follow：页面照常被读到，产品页也照常被这一页发现与传递权重。
// 阈值与 sitemap.xml.ts 共用 lib/categoryPath 一份 —— 以后往这一类分类里补上第二个
// 产品，两页不再重复，分类页自动恢复收录，不需要再回来改代码或手工维护名单。
const thinCategory = isThinCategory(products.length);
---

<BaseLayout
  pageTitle={pageTitle}
  headingTitle={category.name}
  description={pageDescription}
  keywords={keywords}
  hideTitle
  noindex={thinCategory}
>
  <PageHero
    imageAlt={category.name}
    titleWhite={category.name}
    subtitle={category.description || ""}
    crumb={{
      root: { name: "Categories", url: "/categories/" },
      middleItems,
      current: category.name,
      currentUrl: `/categories/${category.slug}/`,
    }}
  />

  <!-- Subcategories -->
  {
    children.length > 0 && (
      <div class="subcategories">
        <h2>Subcategories</h2>
        <div class="sub-list">
          {children.map((child: CategoryNode) => (
            <a href={`/categories/${child.slug}/`} class="sub-tag">
              {child.name}
            </a>
          ))}
        </div>
      </div>
    )
  }

  <!-- Products in this category -->
  <h2>Products ({products.length})</h2>
  {
    products.length === 0 ? (
      <p>No products in this category yet.</p>
    ) : (
      <ul class="product-list">
        {products.map((product) => (
          <li class="product-card">
            {/* 外层不能用 <a>：内部询盘 <button> 属交互元素嵌套，非法且点击会连带跳转 */}
            <div class="card-box">
              {product.image_url && (
                <a
                  class="card-media"
                  href={`/products/${product.slug}/`}
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <img
                    src={product.image_url}
                    alt={product.image_alt || product.title}
                    width="300"
                    height="180"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="product-info">
                <h3>
                  <a class="card-title" href={`/products/${product.slug}/`}>
                    {product.title}
                  </a>
                </h3>
                {product.description && (
                  <p class="desc">{product.description}</p>
                )}
                <div class="card-footer">
                  {product.part_code && (
                    <span class="part-code">Part No: {product.part_code}</span>
                  )}
                  <button
                    type="button"
                    class="card-inquiry"
                    data-open-inquiry-modal
                  >
                    Inquiry
                  </button>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .subcategories {
    margin-bottom: 1.5rem;
  }

  .subcategories h2 {
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }

  .sub-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sub-tag {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 0.25rem;
    color: #0053a0;
    text-decoration: none;
    font-size: 0.9rem;
    transition: background-color 0.2s;
  }

  .sub-tag:hover {
    background-color: #e2e8f0;
  }

  .product-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    grid-auto-rows: 1fr; /* 所有行等高 → 全部卡片统一高度 */
    gap: 1.5rem;
  }

  .product-card {
    display: flex; /* 让内部 <a> 能撑满网格行高 */
  }

  .card-box {
    position: relative; /* stretched-link 的定位基准 */
    display: flex;
    flex-direction: column;
    flex: 1;
    border: 1px solid #e9edf2;
    border-radius: 0.625rem;
    overflow: hidden;
    background: #fff;
    /* 静置即有柔和投影 → 卡片从一开始就像浮在平面上的独立物体 */
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.06),
      0 2px 8px rgba(15, 23, 42, 0.05);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .card-box:hover {
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.14);
    transform: translateY(-3px);
  }

  .card-media {
    display: block;
  }

  .card-media img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }

  /* 标题链接铺满整卡（stretched-link），实现整卡可点 */
  .card-title {
    color: inherit;
    text-decoration: none;
  }
  .card-title::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .product-info {
    padding: 0.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .product-info h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Part No 沉到底行左侧，作为 muted 信息平衡右下询盘按钮 */
  .part-code {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-size: 0.75rem;
    color: #94a3b8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .desc {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: #475569;
    display: -webkit-box;
    -webkit-line-clamp: 2; /* 描述默认只保留两行 */
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 卡片底行：Part No 左、询盘按钮右；沉底对齐 */
  .card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .card-inquiry {
    position: relative;
    z-index: 1; /* 浮在 stretched-link 之上，保证按钮可点 */
    flex-shrink: 0;
    border: none;
    border-radius: 999px;
    background: #69574a;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
    transition:
      background-color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }

  .card-inquiry:hover {
    background: #5a4a3e;
    transform: translateY(-1px) scale(1.05);
    box-shadow: 0 4px 10px rgba(105, 87, 74, 0.35);
  }

  .card-inquiry:active {
    transform: translateY(0) scale(0.98);
    box-shadow: none;
  }

  /* 移动端：两列紧凑卡片，提升浏览效率 */
  @media (max-width: 640px) {
    .product-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    .card-media img {
      height: 110px;
    }
    .product-info {
      padding: 0.5rem;
    }
    .product-info h2,
    .product-info h3 {
      font-size: 0.82rem;
      margin-bottom: 0.25rem;
    }
    /* 窄列下描述/型号/分类标签过挤，隐藏以保证两列紧凑可读 */
    .part-code,
    .desc,
    .category {
      display: none;
    }
    .card-footer {
      justify-content: flex-end;
    }
    .card-inquiry {
      font-size: 0.7rem;
      padding: 0.25rem 0.6rem;
    }
  }
</style>
