---
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase } from "../../lib/supabase";
import {
  countSubtreeProducts,
  type CategoryNode,
  type CategoryProductRow,
} from "../../lib/categoryPath";
import { currentLang } from "../../lib/i18n";

// SSR：分类树读 categories / products 两张表，改库即生效，不需要重建部署。
export const prerender = false;

const lang = currentLang(Astro.locals);

const { data: allCategories, error } = await supabase
  .from("categories")
  .select("id, name, slug, parent_id, description")
  .order("name");

if (error) {
  console.error("Failed to fetch categories:", error);
}

const categories = (allCategories ?? []) as CategoryNode[];

// Get product counts per category
// 同样必须按 lang 过滤（与分类详情页同一原因）：这里的数既当每个分类后面的
// 「N products」显示，也当页头「Products Listed」的总数，混进中文行就是虚高。
const { data: allProducts } = await supabase
  .from("products")
  .select("slug, category_ids")
  .eq("status", "published")
  .eq("lang", lang);

const products = (allProducts ?? []) as CategoryProductRow[];

/* 薄分类（子树英文已发布产品 ≤ 1）这里照样列。2026-10-31 一度把它们过滤掉，
   理由是「本页被收录，不该给 noindex 页发链」——那个理由是错的：那些页是
   noindex, follow，本来就是「不收录但欢迎被链被爬」，产品页靠它们被发现；
   而且 Mega Menu 现在就在链其中的 mesh / honeycomb / open-cell。买家找
   「Mesh Ceilings」时这是一个真实存在的产品线，从「全部分类」里删掉只会让人少看到。
   子树计数用共用的 countSubtreeProducts：以前本页自己写了一份 getProductCount，
   与 lib 里那份逻辑一模一样，改一处就会漏另一处。 */

/* 分类树不止两层。2026-10-31 查到：aluminum-ceilings → baffle-blade-ceilings →
   aluminum-square-tube / u-shaped-aluminum-square-tube 是第三层，而旧模板只渲染
   「根 + 直接子级」，那两个页（各 2 个产品）从来就没在这页出现过 —— 它们也不在
   菜单里，等于只剩产品页面包屑一条路。所以改成递归展开，不再写死层数。 */
type Entry = { node: CategoryNode; depth: number };
function descendantsOf(rootId: number, depth = 1): Entry[] {
  const out: Entry[] = [];
  for (const k of categories) {
    if (k.parent_id !== rootId) continue;
    out.push({ node: k, depth });
    out.push(...descendantsOf(k.id, depth + 1));
  }
  return out;
}

// Separate root categories (parent_id = null)
const rootCategories = categories.filter((c) => !c.parent_id);

// 遍历子树要用全量 categories（含第三层），否则厚页会少算孙辈的产品
function getProductCount(categoryId: number): number {
  return countSubtreeProducts(categoryId, categories, products);
}

// 标题与描述都得重写：以前 description 是建站模板留下的「brake systems, engine parts,
// filters」——我们是铝幕墙/铝吊顶厂，与汽车配件毫无关系，而这句话会直接出现在搜索结果的
// 摘要行上（/blog/ 那两处同类残留早在 lib/pageCopy.ts 里记下已清）。以前标题就是
// "Categories"，渲染后 18 字，在 sitemap 里却没占到一个像样的标题位。
const pageTitle = "Aluminium Ceiling & Facade Product Categories";
const pageDescription =
  "Browse our aluminium ceiling, facade and wall panel families — each links to its product list with specifications, finishes and installation guidance.";
---

<BaseLayout pageTitle={pageTitle} description={pageDescription} hideTitle>
  <PageHero
    imageAlt={pageTitle}
    titleWhite="Product"
    titleGold="Categories"
    subtitle="Browse our aluminum ceiling, wall panel and facade cladding systems by application family. Every family links to its full product list with specifications, finishes and installation guidance."
    stats={[
      { value: String(rootCategories.length), label: "Product Families" },
      { value: String(products.length), label: "Products Listed" },
    ]}
    crumb={{
      items: [
        { name: "Home", url: "/" },
        { name: "Categories", url: "/categories/" },
      ],
    }}
  />

  {
    rootCategories.length === 0 ? (
      <p>No categories available at the moment.</p>
    ) : (
      <div class="category-tree">
        {rootCategories.map((root) => {
          const descendants = descendantsOf(root.id);
          return (
            <div class="category-group">
              <a href={`/categories/${root.slug}/`} class="category-root">
                <h2>{root.name}</h2>
                {root.description && <p>{root.description}</p>}
                <span class="count">{getProductCount(root.id)} products</span>
              </a>
              {descendants.length > 0 && (
                <div class="subcategories">
                  {descendants.map(({ node, depth }) => (
                    <a
                      href={`/categories/${node.slug}/`}
                      class:list={[
                        "subcategory",
                        { "subcategory--deep": depth > 1 },
                      ]}
                    >
                      {node.name}
                      <span class="count">{getProductCount(node.id)}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>
    )
  }
</BaseLayout>

<style>
  .category-tree {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .category-group {
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    background: #fff;
    overflow: hidden;
  }

  .category-root {
    display: block;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.2s;
  }

  .category-root:hover {
    background-color: #f8fafc;
  }

  .category-root h2 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    color: #0d0950;
  }

  .category-root p {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: #64748b;
  }

  .count {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .subcategories {
    border-top: 1px solid #e2e8f0;
    padding: 0.5rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .subcategory {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: #0053a0;
    text-decoration: none;
    padding: 0.25rem 0.6rem;
    background: #f1f5f9;
    border-radius: 0.25rem;
    transition: background-color 0.2s;
  }

  .subcategory:hover {
    background-color: #e2e8f0;
  }

  /* 第三层及更深：左边一条竖线标出层级，不另开一种颜色 */
  .subcategory--deep {
    border-left: 2px solid #cbd5e1;
    padding-left: 0.6rem;
  }
</style>
