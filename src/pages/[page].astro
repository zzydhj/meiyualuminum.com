---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import NotFoundPanel from "../components/NotFoundPanel.astro";
import { supabase } from "../lib/supabase";
import { currentLang } from "../lib/i18n";

// SSR 按需渲染
export const prerender = false;

const lang = currentLang(Astro.locals);

const { page: pageSlug } = Astro.params;
const { data: page, error } = await supabase
  .from("pages")
  .select("*")
  .eq("slug", pageSlug)
  .eq("lang", lang)
  .eq("status", "published")
  .maybeSingle();

if (error) {
  console.error(`[page] query failed for "${pageSlug}":`, error);
}

// page 为空表示这个单段路径在 pages 表里没有已发布记录（拼错 / 草稿 / 已删除）。
// 以前这里直接 return new Response("Page not found", { status: 404 })，
// 买家看到的是一整张 14 字节空白页；现在保留 404 状态码，但渲染带出路的兜底面板。
const notFound = !page;
if (notFound) {
  Astro.response.status = 404;
  // 404 不进边缘缓存（astro.config 的 routeRules 会给 /[page] 加缓存头）：
  // 否则草稿页被先访问一次后，发布后的首抓会在 swr 窗口里继续拿到这份 404。
  Astro.cache.set(false);
}

// Use seo_title if available, otherwise fall back to title
const pageTitle = page?.seo_title || page?.title || "Page Not Found";
const pageDescription = page?.seo_description || "";
const keywords = page?.keywords ?? [];

// Custom per-page code (plain text columns: custom_css / custom_js)
const customCss = page?.custom_css ?? "";
const customJs = page?.custom_js ?? "";

// 特殊页面类型检测
const isProjectGallery = page?.slug === "project-gallery";

// 标题自动拆双色（供 PageHero）：优先按 "|" 拆；无则按空格把最后一个词染金；单词标题全白
const splitHeroTitle = (t: string) => {
  const s = (t || "").trim();
  if (s.includes("|")) {
    const i = s.indexOf("|");
    return { white: s.slice(0, i).trim(), gold: s.slice(i + 1).trim() };
  }
  const parts = s.split(/\s+/);
  if (parts.length > 1)
    return {
      white: parts.slice(0, -1).join(" "),
      gold: parts[parts.length - 1],
    };
  return { white: s, gold: "" };
};
const heroTitleParts = splitHeroTitle(page?.title ?? "");

// 正文 HTML 若自带 <h1> 会与页头 H1 冲突（全页仅一个 H1），渲染时降级为 h2（不改数据库）
const safeContent = (page?.content || "")
  .replace(/<h1(\s|>)/gi, "<h2$1")
  .replace(/<\/h1>/gi, "</h2>");
---

<BaseLayout
  pageTitle={pageTitle}
  headingTitle={page?.title ?? ""}
  hideTitle
  description={pageDescription}
  keywords={keywords}
  customCss={customCss}
  customJs={customJs}
  noindex={notFound}
>
  {
    page ? (
      <>
        <PageHero
          imageAlt={page.title}
          titleWhite={heroTitleParts.white}
          titleGold={heroTitleParts.gold}
          subtitle={page.hero_subtitle || ""}
          crumb={{
            items: [
              { name: "Home", url: "/" },
              { name: page.title, url: `/${page.slug}/` },
            ],
          }}
        />

        {/* hero_title 作为正文引导标题（hero_subtitle 已并入 PageHero 副标题） */}
        {
          page.hero_title && (
            <section class="hero">
              <h2>{page.hero_title}</h2>
            </section>
          )
        }

        <!-- Hero image -->
        {
          page.image_url && (
            <img
              src={page.image_url}
              alt={page.image_alt || page.title}
              width="800"
              height="400"
              class="hero-image"
              loading="lazy"
            />
          )
        }

        <!-- Page content (HTML from database) -->
        {page.content && <div class="page-content" set:html={safeContent} />}

        {/* Project Gallery (动态渲染 posts 表中 primary_tag='projects' 的文章) */}
        {isProjectGallery && <ProjectGallery />}
      </>
    ) : (
      <NotFoundPanel />
    )
  }
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 2rem 0;
    margin-bottom: 1.5rem;
  }

  .hero h2 {
    font-size: 2rem;
    margin: 0 0 0.75rem;
    color: #0d0950;
  }

  .hero .subtitle {
    font-size: 1.15rem;
    color: #475569;
    margin: 0;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .hero-image {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    border-radius: 0.5rem;
    margin-bottom: 2rem;
  }

  .page-content {
    line-height: 1.8;
    font-size: 1rem;
  }

  .page-content h2 {
    margin-top: 2rem;
    color: #1e293b;
  }

  .page-content h3 {
    margin-top: 1.5rem;
    color: #334155;
  }

  .page-content p {
    margin-bottom: 1rem;
    color: #475569;
  }

  .page-content ul,
  .page-content ol {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .page-content li {
    margin-bottom: 0.5rem;
  }

  .page-content a {
    color: #0053a0;
  }

  .page-content img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }
</style>
