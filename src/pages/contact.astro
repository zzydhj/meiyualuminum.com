---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import InquiryForm from "../components/InquiryForm.astro";

const pageTitle = "Contact Us";
const pageDescription =
  // ≤ 160 字（改前 166，只多了“linear”一个词就被截断）
  "Request a quote or send an inquiry about aluminium ceiling tiles, strip ceilings, wall cladding and facade systems. Our engineering team replies within 1 hour.";
---

<BaseLayout pageTitle={pageTitle} description={pageDescription} hideTitle>
  <PageHero
    imageAlt={pageTitle}
    titleWhite="Contact"
    titleGold="Us"
    subtitle="Have a question or need a quote? Fill in the form below and our team will get back to you within 1 hour. For large drawings or specifications, please share a cloud-drive link (Google Drive, Dropbox, etc.) in your message."
    crumb={{
      items: [
        { name: "Home", url: "/" },
        { name: "Contact", url: "/contact/" },
      ],
    }}
  />

  <InquiryForm />
</BaseLayout>
