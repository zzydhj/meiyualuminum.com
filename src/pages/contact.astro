---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

/**
 * Contact / Inquiry page powered by FormSubmit (https://formsubmit.co)
 *
 * ⚠️ IMPORTANT — use your REAL inbox(es):
 *    FormSubmit supports MULTIPLE recipients, just add more emails to the array.
 *    The first submission sends an activation email to EACH address.
 *    You MUST click every activation link before real inquiries arrive.
 */
const FORM_EMAILS = [
  "zzydhj@outlook.com",
  // "zzydhj@gmail.com", // ← add more recipients here
];
const formAction = `https://formsubmit.co/${FORM_EMAILS.join(",")}`;

const pageTitle = "Contact Us";
const pageDescription =
  "Request a quote or send us an inquiry about aluminum profiles and automotive parts. Attach drawings or specifications — our team replies within 24 hours.";
---

<BaseLayout pageTitle={pageTitle} description={pageDescription}>
  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Contact", url: "/contact/" },
    ]}
  />

  <p class="intro">
    Have a question or need a quote? Fill in the form below and our team will
    get back to you within 24 hours. You can also attach drawings or
    specification sheets.
  </p>

  <!--
    FormSubmit config (hidden fields):
    _subject  → email subject line
    _captcha  → anti-spam captcha page (free plan feature)
    _template → format the email as a readable table
    _next     → redirect to our own thank-you page after submit
                (requires the domain to be activated with FormSubmit)
    _honey    → honeypot field; bots fill it, humans never see it
  -->
  <form
    action={formAction}
    method="POST"
    enctype="multipart/form-data"
    class="inquiry-form"
  >
    <input type="hidden" name="_subject" value="New Inquiry — Meiyu Aluminum Website" />
    <input type="hidden" name="_captcha" value="true" />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_next" value="https://www.meiyualuminum.com/thank-you/" />
    <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

    <div class="form-grid">
      <label class="field">
        <span class="label">Name <em>*</em></span>
        <input type="text" name="name" required placeholder="Your name" />
      </label>

      <label class="field">
        <span class="label">Email <em>*</em></span>
        <input type="email" name="email" required placeholder="you@company.com" />
      </label>

      <label class="field">
        <span class="label">Company</span>
        <input type="text" name="company" placeholder="Company name" />
      </label>

      <label class="field">
        <span class="label">Product Model</span>
        <input type="text" name="product_model" placeholder="e.g. 6061-T6 aluminum profile" />
      </label>
    </div>

    <label class="field">
      <span class="label">Inquiry Details <em>*</em></span>
      <textarea
        name="message"
        required
        rows="6"
        placeholder="Describe the products, quantities, dimensions, or any questions you have..."
      ></textarea>
    </label>

    <label class="field">
      <span class="label">Attachment</span>
      <input
        type="file"
        id="attachment"
        name="attachment[]"
        multiple
        accept=".pdf,.doc,.docx,.xls,.xlsx,.dwg,.jpg,.jpeg,.png,.zip"
      />
      <span class="hint">Drawings or specs (PDF, DWG, images, ZIP). Total size up to 10MB. For larger files, please share a cloud-drive link in the message.</span>
      <p id="file-error" class="file-error" hidden></p>
    </label>

    <button type="submit" class="submit-btn">Send Inquiry</button>
    <p class="note"><em>*</em> Required fields. Your information is only used to respond to your inquiry.</p>
  </form>

  <!--
    Client-side file size validation.
    FormSubmit rejects submissions whose total attachment size exceeds 10MB
    with an unfriendly 500 page, so we block oversized uploads up front.
  -->
  <script>
    const MAX_TOTAL_MB = 10; // FormSubmit free-plan attachment limit
    const form = document.querySelector(".inquiry-form") as HTMLFormElement | null;
    const fileInput = document.getElementById("attachment") as HTMLInputElement | null;
    const errorBox = document.getElementById("file-error");

    function totalSizeMB(): number {
      let bytes = 0;
      if (fileInput?.files) {
        for (const f of Array.from(fileInput.files)) bytes += f.size;
      }
      return bytes / (1024 * 1024);
    }

    function validateFiles(): boolean {
      const sizeMB = totalSizeMB();
      if (sizeMB > MAX_TOTAL_MB) {
        if (errorBox) {
          errorBox.textContent = `Attachments total ${sizeMB.toFixed(1)}MB, which exceeds the ${MAX_TOTAL_MB}MB limit. Please compress or remove some files, or share a cloud-drive link instead.`;
          errorBox.hidden = false;
        }
        return false;
      }
      if (errorBox) errorBox.hidden = true;
      return true;
    }

    fileInput?.addEventListener("change", validateFiles);
    form?.addEventListener("submit", (e) => {
      if (!validateFiles()) e.preventDefault();
    });
  </script>
</BaseLayout>

<style>
  .intro {
    color: #475569;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 60ch;
  }

  .inquiry-form {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    padding: 1.5rem;
    max-width: 720px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  @media screen and (max-width: 636px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .form-grid .field {
    margin-bottom: 0;
  }

  .label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #334155;
  }

  .label em {
    color: #e11d48;
    font-style: normal;
  }

  .field input,
  .field textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.375rem;
    background: #fff;
    color: #0f172a;
    width: 100%;
  }

  .field input:focus,
  .field textarea:focus {
    outline: 2px solid #0053a0;
    outline-offset: 1px;
    border-color: #0053a0;
  }

  .field textarea {
    resize: vertical;
    min-height: 140px;
  }

  .field input[type="file"] {
    padding: 0.4rem;
    border-style: dashed;
    background: #f8fafc;
    cursor: pointer;
  }

  .hint {
    font-size: 0.8rem;
    color: #64748b;
  }

  .file-error {
    font-size: 0.85rem;
    color: #dc2626;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
    margin: 0.25rem 0 0;
  }

  .submit-btn {
    background-color: #0d0950;
    color: #fff;
    border: none;
    border-radius: 0.375rem;
    padding: 0.75rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .submit-btn:hover {
    background-color: #0053a0;
  }

  .note {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-top: 0.75rem;
  }
</style>
