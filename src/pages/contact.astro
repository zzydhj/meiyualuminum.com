---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import InquiryForm from "../components/InquiryForm.astro";

const pageTitle = "Contact Us";
const pageDescription =
  "Request a quote or send us an inquiry about aluminum profiles and automotive parts. Our team replies within 24 hours.";
---

<BaseLayout pageTitle={pageTitle} description={pageDescription}>
  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Contact", url: "/contact/" },
    ]}
  />

  <p class="intro">
    Have a question or need a quote? Fill in the form below and our team will get back to you within 24 hours. For large drawings or specifications,
    please share a cloud-drive link (Google Drive, Dropbox, etc.) in your
    message.
  </p>

  <InquiryForm />
</BaseLayout>

<style>
  .intro {
    color: #475569;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
</style>
