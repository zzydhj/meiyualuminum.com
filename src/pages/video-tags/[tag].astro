---
/**
 * video-tags/[tag].astro — 视频标签列表第 1 页
 *
 * - 第 2~N 页由 video-tags/[tag]/page/[page].astro 生成（/video-tags/{tag}/page/N/）
 * - 每页 PAGE_SIZE 条，与博客/视频列表共用分页配置与导航组件
 */
import Breadcrumb from "../../components/Breadcrumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoGrid from "../../components/VideoGrid.astro";
import PaginationNav from "../../components/PaginationNav.astro";
import { PAGE_SIZE } from "../../lib/pagination";
import { fetchAllVideos, groupVideosByTag } from "../../lib/videoTags";

export async function getStaticPaths() {
  const byTag = groupVideosByTag(await fetchAllVideos());

  return [...byTag.entries()].map(([tag, tagged]) => ({
    params: { tag },
    props: {
      videos: tagged.slice(0, PAGE_SIZE),
      currentPage: 1,
      totalPages: Math.max(1, Math.ceil(tagged.length / PAGE_SIZE)),
    },
  }));
}

const { tag } = Astro.params;
const { videos, currentPage, totalPages } = Astro.props;
const pageDescription = `Browse all videos tagged with "${tag}".`;
const tagPath = encodeURIComponent(tag);
---

<BaseLayout pageTitle={tag} description={pageDescription}>
  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Video Tags", url: "/video-tags/" },
      { name: tag, url: `/video-tags/${tagPath}/` },
    ]}
  />
  <p>Videos tagged with "{tag}"</p>
  <VideoGrid videos={videos} />
  <PaginationNav
    currentPage={currentPage}
    totalPages={totalPages}
    basePath={`/video-tags/${tagPath}/page`}
    firstPageUrl={`/video-tags/${tagPath}/`}
  />
</BaseLayout>
