---
/**
 * products/index.astro — 产品列表第 1 页
 *
 * - 第 2~N 页由 products/page/[page].astro 生成（/products/page/N/）
 * - 每页 PAGE_SIZE 个，与博客/视频列表共用分页配置与导航组件
 * - 卡片网格抽到 ProductGrid 组件，与分页页共用，避免 markup+CSS 复制
 */
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import PaginationNav from "../../components/PaginationNav.astro";

// SSR：列表读 products 表，新增/下线产品后改库即生效，不需要重建部署。
export const prerender = false;
import { supabase } from "../../lib/supabase";
import { currentLang, loc, SUPPORTED_LANGS } from "../../lib/i18n";
import { PAGE_SIZE } from "../../lib/pagination";

// 当前语言（[lang] 包装会写入 locals.lang；无前缀根路由为 'en'）
const lang = currentLang(Astro.locals);

// 已发布产品总数（轻量 count 查询，不拉取行数据）
const { count } = await supabase
  .from("products")
  .select("*", { count: "exact", head: true })
  .eq("status", "published")
  .eq("lang", lang);

const totalPages = Math.max(1, Math.ceil((count ?? 0) / PAGE_SIZE));

// 按语言过滤 + 数据库层分页：本页只取前 PAGE_SIZE 个
// 次级排序 slug：保证 created_at 相同时跨页顺序稳定，不重不漏
const result = await supabase
  .from("products")
  .select("*")
  .eq("status", "published")
  .eq("lang", lang)
  .order("created_at", { ascending: false })
  .order("slug", { ascending: true })
  .range(0, PAGE_SIZE - 1);

if (result.error) {
  console.error("Failed to fetch products:", result.error);
}

const products = result.data ?? [];

// Fetch all categories for display
const { data: allCategories } = await supabase
  .from("categories")
  .select("id, name, slug");

const categoryMap = new Map<number, { name: string; slug: string }>();
for (const cat of allCategories ?? []) {
  categoryMap.set(cat.id, { name: cat.name, slug: cat.slug });
}
// 页面框架文案（轻量本地化；完整站点词典见后续 i18n 工作）
const UI = {
  en: {
    products: "Products",
    home: "Home",
    empty: "No products available at the moment.",
    heroWhite: "Our",
    heroGold: "Products",
    heroSub:
      "Aluminum ceiling, wall panel and facade cladding systems engineered for commercial and architectural projects worldwide. Standard modules and fully custom fabrication, produced to project drawings and shipped worldwide.",
    statProducts: "Products Listed",
    statCategories: "Categories",
    statLanguages: "Languages",
  },
  zh: {
    products: "产品",
    home: "首页",
    empty: "暂无产品。",
    heroWhite: "我们的",
    heroGold: "产品",
    heroSub:
      "面向全球商业与建筑项目的铝天花、墙板与幕墙系统。标准模块与全定制加工，按项目图纸生产、全球发货。",
    statProducts: "在售产品",
    statCategories: "产品分类",
    statLanguages: "种语言",
  },
} as const;
const t = UI[lang as keyof typeof UI] ?? UI.en;
const pageTitle = t.products;
---

<BaseLayout pageTitle={pageTitle} lang={lang} hideTitle>
  <PageHero
    imageAlt={t.products}
    titleWhite={t.heroWhite}
    titleGold={t.heroGold}
    subtitle={t.heroSub}
    stats={[
      { value: String(count ?? 0), label: t.statProducts },
      { value: String(categoryMap.size), label: t.statCategories },
      { value: String(SUPPORTED_LANGS.length), label: t.statLanguages },
    ]}
    crumb={{
      items: [
        { name: t.home, url: loc(lang, "/") },
        { name: t.products, url: loc(lang, "/products/") },
      ],
    }}
  />

  {
    products.length === 0 ? (
      <p>{t.empty}</p>
    ) : (
      <>
        <ProductGrid
          products={products}
          categoryMap={categoryMap}
          lang={lang}
        />
        <PaginationNav
          currentPage={1}
          totalPages={totalPages}
          basePath="/products/page"
          firstPageUrl="/products/"
        />
      </>
    )
  }
</BaseLayout>
