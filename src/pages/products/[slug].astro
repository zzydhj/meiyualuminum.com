---
import Breadcrumb from "../../components/Breadcrumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import InquiryButton from "../../components/InquiryButton.astro";
import InquiryFormSection from "../../components/InquiryFormSection.astro";
import { supabase } from "../../lib/supabase";
import { getCategoryChain } from "../../lib/categoryPath";
import { productKnowledge, type ProductEnrichedSpecs, type ProductKnowledge } from "../../lib/productKnowledge";
import { standardTerms, termsNote } from "../../lib/companyProfile";
import { currentLang } from "../../lib/i18n";

// SSR 按需渲染
export const prerender = false;

const lang = currentLang(Astro.locals);

const { slug } = Astro.params;
const { data: product, error } = await supabase
  .from("products")
  .select("*")
  .eq("slug", slug)
  .eq("lang", lang)
  .eq("status", "published")
  .maybeSingle();

if (error || !product) {
  return Astro.redirect("/products/");
}

const primaryCategoryId = product.primary_category_id ?? null;
const categoryChain = await getCategoryChain(primaryCategoryId);

/**
 * 同一品类下的其他已发布产品（不含自己）。
 * Docs & Guides 面板用它做站内内链：超级链接策略下，一个产品页要承接整个品类的搜索意图。
 */
const { data: siblingRows } = await supabase
  .from("products")
  .select("slug,title")
  .eq("primary_category_id", primaryCategoryId ?? -1)
  .eq("lang", lang)
  .eq("status", "published")
  .neq("slug", slug)
  .order("title", { ascending: true })
  .limit(6);
const siblings = siblingRows ?? [];

const pageTitle = product.seo_title || product.title;
const pageDescription = product.seo_description || product.description;
const keywords = product.keywords ?? [];

// Look up enriched knowledge by the first category slug in the chain
const categorySlug = categoryChain.length > 0 ? categoryChain[categoryChain.length - 1].slug : null;
const knowledge: ProductKnowledge | undefined = categorySlug ? productKnowledge[categorySlug] : undefined;

// ── enriched_specs 合并逻辑 ──
// 优先使用产品专属的 enriched_specs，没有则回退到品类级 knowledge
const es: ProductEnrichedSpecs | null = (product.enriched_specs as ProductEnrichedSpecs | null) ?? null;
const displaySpecs = (es?.specs && es.specs.length > 0) ? es.specs : (knowledge?.technicalSpecs ?? []);
const displayFeatures = (es?.features && es.features.length > 0) ? es.features : (knowledge?.keyFeatures ?? []);
const displaySummary = es?.summary || null; // 产品专属概述（可选）
const displayApps = (es?.applications && es.applications.length > 0) ? es.applications : null; // 产品专属适用场景标签（可选）
const displaySizes = (es?.standardSizes && es.standardSizes.length > 0) ? es.standardSizes : (knowledge?.standardSizes ?? []);
const displayInstallSteps = (es?.installationSteps && es.installationSteps.length > 0) ? es.installationSteps : (knowledge?.installationSteps ?? []);
const displayInstallTips = (es?.installationTips && es.installationTips.length > 0) ? es.installationTips : (knowledge?.installationTips ?? []);
const hasProductSpecificData = !!es; // 标记：当前产品有专属数据
/** 是否有图集：决定画廊是否预留左侧缩略图槽位 */
const hasThumbs = !!(product.gallery && product.gallery.length > 0);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.title,
  "description": product.description,
  "image": product.image_url,
  "sku": product.part_code,
  "brand": product.brand ? { "@type": "Brand", name: product.brand } : undefined,
  "category": categoryChain.length > 0 ? categoryChain.map(c => c.name).join(" > ") : undefined,
};
---

<BaseLayout
  pageTitle={pageTitle}
  lang={lang}
  headingTitle={product.title}
  description={pageDescription}
  image={product.image_url}
  type="article"
  pubDate={product.created_at ? new Date(product.created_at) : undefined}
  keywords={keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Breadcrumb
    root={{ name: "Products", url: "/products/" }}
    middleItems={categoryChain}
    current={product.title}
    currentUrl={`/products/${product.slug}/`}
  />

  <!-- ══════ PRODUCT HERO ══════ -->
  <div class="pk-hero">
    <div class:list={["pk-hero-gallery", { "with-thumbs": hasThumbs }]}>
      {product.image_url && (
        <div class="img-watermark">
          <img id="main-image" src={product.image_url} alt={product.image_alt || product.title} width="600" height="400" />
        </div>
      )}
      {(product.gallery && product.gallery.length > 0) && (
        <>
          <div class="pk-thumbs" id="pk-thumbs">
            {product.image_url && (
              <img src={product.image_url} alt={product.image_alt || product.title} class="pk-thumb active" data-full={product.image_url} width="80" height="60" />
            )}
            {product.gallery.map((url: string, i: number) => (
              <img src={url} alt={`${product.title} - image ${i + 2}`} class="pk-thumb" data-full={url} width="80" height="60" loading="lazy" />
            ))}
          </div>
          <!-- 缩略图列上下箭头：列高 = 大图高，装不下的靠箭头滚 -->
          <button type="button" class="pk-thumb-nav pk-thumb-up" id="pk-thumb-up" aria-label="Scroll to previous images" aria-controls="pk-thumbs" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6" /></svg>
          </button>
          <button type="button" class="pk-thumb-nav pk-thumb-down" id="pk-thumb-down" aria-label="Scroll to more images" aria-controls="pk-thumbs" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </button>
        </>
      )}
    </div>

    <div class="pk-hero-info">
      {product.part_code && <p class="pk-part-code">Part No: {product.part_code}</p>}
      <p class="pk-desc"><em>{product.description}</em></p>

      <!-- Certifications badges：先给信任，紧接下面就是行动按钮 -->
      {knowledge && knowledge.certifications.length > 0 && (
        <div class="pk-certs">
          {knowledge.certifications.slice(0, 4).map((cert) => (
            <span class="pk-cert-badge">✓ {cert}</span>
          ))}
        </div>
      )}

      <!-- CTA Buttons：放在右栏顶部（首屏必现）。
           不能靠后：hero 从文档 ~217px 起，右栏内容高 ~800px，按钮若排在规格表之后
           会落在文档 y≈950，在 845 高（及更矮的笔记本）视口里首屏完全看不到。 -->
      <div class="pk-cta-row">
        <InquiryButton label="Get a Free Quote" class="pk-cta-primary" />
        <InquiryButton label="Request Sample" class="pk-cta-secondary" />
      </div>

      {/* 规格表不放在首屏：左栏画廊只有 ~584px（列宽 668 扣掉 84 缩略图槽，1:1 即高），
           而一张表格每行要 ~54px，任何摘要表都会把右栏撑到 +37~48%。完整表格在下方
           Technical Specs Tab（全宽，读长值更舒服），这里只留一行入口。
           预告用 label 而不是 value：label 永远是短词，value 才是撑高度的元凶。 */}
      {displaySpecs.length > 0 && (
        <a class="pk-specs-jump" href="#product-specs" data-tab="specs">
          <span class="pk-specs-jump-lead">Technical specification</span>
          <span class="pk-specs-jump-list">
            {displaySpecs.slice(0, 3).map((s: { label: string }) => s.label).join(" · ")}
            {displaySpecs.length > 3 ? ` · +${displaySpecs.length - 3} more` : ""}
          </span>
          <span class="pk-specs-jump-arrow" aria-hidden="true">→</span>
        </a>
      )}

      <!-- 公司级标准条款：只列影响报价的 3 行（MOQ / 交期 / 质保）；
           standardTerms 第 4 条 Samples 不在此展示，因为紧邻的 Request Sample 按钮就是它的入口，重复写反而多占一行 -->
      <div class="pk-terms">
        <p class="pk-specs-label">Ordering &amp; Terms</p>
        <table class="pk-terms-table">
          {
            standardTerms.slice(0, 3).map((t) => (
              <tr>
                <th>{t.label}</th>
                <td>{t.value}</td>
              </tr>
            ))
          }
        </table>
        <p class="pk-terms-note">{termsNote}</p>
      </div>
    </div>
  </div>

  <!-- ══════ KEY FEATURES: enriched_specs 优先，回退品类通用 ══════ -->
  {displayFeatures.length > 0 && (
    <section class="pk-features">
      <h2>Key Features</h2>
      <ul class="pk-features-list">
        {displayFeatures.map((f: string) => (
          <li>
            <svg viewBox="0 0 20 20" width="18" height="18" fill="none"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" fill="#c09020"/></svg>
            {f}
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- ══════ TABBED CONTENT ══════ -->
  {(knowledge || displaySpecs.length > 0) && (
    <section class="pk-tabs" id="product-specs">
      <div class="pk-tab-nav" role="tablist">
        <button class="pk-tab-btn active" data-tab="overview" role="tab" aria-selected="true">Overview</button>
        <button class="pk-tab-btn" data-tab="specs" role="tab" aria-selected="false">Technical Specs</button>
        <button class="pk-tab-btn" data-tab="surface" role="tab" aria-selected="false">Surface Options</button>
        <button class="pk-tab-btn" data-tab="install" role="tab" aria-selected="false">Installation</button>
        <button class="pk-tab-btn" data-tab="applications" role="tab" aria-selected="false">Applications</button>
        <button class="pk-tab-btn" data-tab="docs" role="tab" aria-selected="false">Docs &amp; Guides</button>
      </div>

      <!-- Tab: Overview -->
      <div class="pk-tab-panel active" data-panel="overview" role="tabpanel">
        {displaySummary && <p class="pk-overview pk-overview-product"><strong>Product Overview:</strong> {displaySummary}</p>}
        {knowledge && <p class="pk-overview">{knowledge.overview}</p>}
        {displaySizes.length > 0 && (
          <>
            <h3>Standard Sizes &amp; Profiles</h3>
            <table class="pk-spec-table">
              {displaySizes.map((s) => (
                <tr><th>{s.label}</th><td>{s.value}</td></tr>
              ))}
            </table>
          </>
        )}
      </div>

      <!-- Tab: Technical Specs -->
      <div class="pk-tab-panel" data-panel="specs" role="tabpanel">
        <h3>Full Technical Specifications</h3>
        {hasProductSpecificData && <p class="pk-specs-note">These specifications are for this specific product. <a href="/installation-guides/">View installation guides →</a></p>}
        <table class="pk-spec-table">
          {displaySpecs.map((s: { label: string; value: string }) => (
            <tr><th>{s.label}</th><td>{s.value}</td></tr>
          ))}
        </table>
      </div>

      <!-- Tab: Surface Options -->
      <div class="pk-tab-panel" data-panel="surface" role="tabpanel">
        <h3>Available Surface Treatments</h3>
        <p class="pk-surface-intro">Choose the right coating system for your project's environment, budget, and design requirements. <a href="/surface-treatment-comparison/">Compare all surface treatments →</a></p>
        {knowledge?.surfaceOptions && (
        <div class="pk-surface-cards">
          {knowledge.surfaceOptions.map((opt) => (
            <div class="pk-surface-card">
              <h4>{opt.name}</h4>
              <p>{opt.description}</p>
              <dl class="pk-surface-dl">
                <dt>Film Thickness</dt><dd>{opt.thickness}</dd>
                <dt>Warranty</dt><dd>{opt.warranty}</dd>
                <dt>Best For</dt>
                <dd>
                  <div class="pk-tags">
                    {opt.suitableFor.map((t) => (<span class="pk-tag">{t}</span>))}
                  </div>
                </dd>
              </dl>
            </div>
          ))}
        </div>
        )}
      </div>
      <!-- Tab: Installation -->
      <div class="pk-tab-panel" data-panel="install" role="tabpanel">
        <h3>Installation Guide</h3>
        <div class="pk-steps">
          {displayInstallSteps.map((s) => (
            <div class="pk-step">
              <span class="pk-step-num">{s.step}</span>
              <div class="pk-step-body">
                <h4>{s.title}</h4>
                <p>{s.description}</p>
              </div>
            </div>
          ))}
        </div>
        {displayInstallTips.length > 0 && (
          <div class="pk-tips">
            <h4>Installation Tips</h4>
            <ul>
              {displayInstallTips.map((tip) => (<li>{tip}</li>))}
            </ul>
          </div>
        )}
      </div>
      <div class="pk-tab-panel" data-panel="applications" role="tabpanel">
        <h3>Application Scenarios</h3>
        {displayApps && (
          <div class="pk-product-apps">
            <p class="pk-product-apps-title">Recommended Applications for This Product:</p>
            <div class="pk-tags pk-app-tags">
              {displayApps.map((a: string) => (<span class="pk-tag pk-app-tag">{a}</span>))}
            </div>
          </div>
        )}
        {knowledge && (
          <div class="pk-app-cards">
            {knowledge.applications.map((app) => (
              <div class="pk-app-card">
                <h4>{app.type}</h4>
                <p class="pk-app-why">{app.whyUse}</p>
                <div class="pk-app-products">
                  <strong>Recommended:</strong>
                  <ul>{app.recommendedProducts.map((r) => (<li>{r}</li>))}</ul>
                </div>
                <p class="pk-app-benefit"><strong>Key Benefit:</strong> {app.keyBenefit}</p>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Tab: Docs & Guides —— 只链站内真实存在的资料；没有的文件不挂链接（原 Spec/CAD/BIM 三组均为 href="#" 占位，已删）-->
      <div class="pk-tab-panel" data-panel="docs" role="tabpanel">
        <h3>Documents &amp; Guides</h3>
        <div class="pk-docs">
          <a class="pk-doc-item" href="/installation-guides/">
            <span class="pk-doc-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </span>
            <span class="pk-doc-body">
              <strong>Installation &amp; Suspension Guides</strong>
              <small>Step-by-step setting-out, carrier fixing, expansion allowance and levelling by product category.</small>
            </span>
            <span class="pk-doc-meta">On-site guide</span>
          </a>

          <a class="pk-doc-item" href="/surface-treatment-comparison/">
            <span class="pk-doc-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s6 5.4 6 10a6 6 0 0 1-12 0c0-4.6 6-10 6-10z"/></svg>
            </span>
            <span class="pk-doc-body">
              <strong>Surface Treatment Comparison</strong>
              <small>PVDF, powder, anodised, PE and wood-grain: durability, weathering, warranty and cost trade-offs side by side.</small>
            </span>
            <span class="pk-doc-meta">5 systems</span>
          </a>

          <a class="pk-doc-item" href="/procurement-guide/">
            <span class="pk-doc-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6a1 1 0 0 1 1 1v2H8V3a1 1 0 0 1 1-1zM4 6h16v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6zM8 11h8M8 15h5"/></svg>
            </span>
            <span class="pk-doc-body">
              <strong>Procurement Guide</strong>
              <small>MOQ counting basis, lead-time milestones, what a quotation includes and excludes, packing data, trade terms and the claim route.</small>
            </span>
            <span class="pk-doc-meta">Terms &amp; claims</span>
          </a>

          <a class="pk-doc-item" href="/tools/">
            <span class="pk-doc-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.7 2.7-2-2z"/></svg>
            </span>
            <span class="pk-doc-body">
              <strong>Free Calculators</strong>
              <small>Size a room, weigh a shipment or work out perforation open area — every result shows its own formula so you can check it.</small>
            </span>
            <span class="pk-doc-meta">3 tools</span>
          </a>

          {
            siblings.length > 0 && (
              <div class="pk-doc-group">
                <h4>Other Products in This System Family</h4>
                <div class="pk-doc-links">
                  {siblings.map((s: { slug: string; title: string }) => (
                    <a class="pk-doc-link" href={`/products/${s.slug}/`}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                      {s.title}
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          <div class="pk-doc-request">
            <strong>Need a data sheet, edge detail or test report?</strong>
            <p>
              Specification summaries, carrier and edge details, plus fire and acoustic test
              reports are prepared per project and issued with your quotation — send the
              drawings or a room size and we will put the pack together.
            </p>
            <button type="button" class="pk-dl-btn" data-open-inquiry-modal>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="M9 15l3 3 3-3"/></svg>
              Request Documents with an Enquiry
            </button>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ══════ DB CONTENT (legacy) ══════ -->
  {product.content && (
    <div class="pk-db-content" set:html={product.content} />
  )}

  <!-- ══════ BOTTOM INQUIRY FORM ══════ -->
  <InquiryFormSection
    source={Astro.url.pathname}
    regarding={product.title}
    title="Need Help Selecting the Right Product?"
    desc="Our engineering team provides free technical consultation, shop drawing support, and custom quotations. Tell us about your project and we'll recommend the optimal solution."
  />
</BaseLayout>

<script>
  // Thumbnail click: swap main image
  const mainImage = document.getElementById('main-image') as HTMLImageElement | null;
  document.querySelectorAll<HTMLImageElement>('.pk-thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      if (!mainImage) return;
      mainImage.src = thumb.dataset.full || thumb.src;
      mainImage.alt = thumb.alt;
      document.querySelectorAll('.pk-thumb').forEach((t) => t.classList.remove('active'));
      thumb.classList.add('active');
    });
  });

  // Tab switching：.pk-tab-btn 与右栏「See all specifications」链接共用 data-tab
  function activateTab(tabId: string) {
    document.querySelectorAll<HTMLElement>(".pk-tab-btn").forEach((b) => {
      const on = b.dataset.tab === tabId;
      b.classList.toggle("active", on);
      b.setAttribute("aria-selected", on ? "true" : "false");
    });
    document.querySelectorAll<HTMLElement>(".pk-tab-panel").forEach((p) => {
      p.classList.toggle("active", p.dataset.panel === tabId);
    });
  }
  document.querySelectorAll<HTMLElement>("[data-tab]").forEach((el) => {
    el.addEventListener("click", () => activateTab(el.dataset.tab!));
  });

  // 缩略图列上下箭头：列高 = 大图高，装不下的部分用箭头滚动；滚到顶/底自动隐藏对应箭头
  const thumbs = document.getElementById("pk-thumbs") as HTMLElement | null;
  const upBtn = document.getElementById("pk-thumb-up") as HTMLButtonElement | null;
  const downBtn = document.getElementById("pk-thumb-down") as HTMLButtonElement | null;
  if (thumbs && upBtn && downBtn) {
    const STEP = 62; // 一张 54 + gap 8，一次滚 3 张
    const syncNav = () => {
      const max = thumbs.scrollHeight - thumbs.clientHeight;
      const top = thumbs.scrollTop;
      upBtn.hidden = top <= 1;
      downBtn.hidden = top >= max - 1;
    };
    upBtn.addEventListener("click", () => thumbs.scrollBy({ top: -STEP * 3, behavior: "smooth" }));
    downBtn.addEventListener("click", () => thumbs.scrollBy({ top: STEP * 3, behavior: "smooth" }));
    thumbs.addEventListener("scroll", () => requestAnimationFrame(syncNav), { passive: true });
    // 缩略图多为 lazy 加载，load 后 scrollHeight 会变，需重新同步（capture 捕获 img 的 load）
    thumbs.addEventListener("load", syncNav, true);
    window.addEventListener("resize", syncNav);
    syncNav();
  }
</script>

<style>
  /* ═══ HERO ═══ */
  /* minmax(0,1fr) 而非 1fr：1fr 的下限是 min-content，当右栏文字很长或左栏图片有 intrinsic 宽度时
     两栏会被撑成不等宽（实测 lay-in 页 772 / 559）；锁 0 下限后永远对分。 */
  .pk-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; margin-bottom: 2.5rem; }
  @media (max-width: 768px) { .pk-hero { grid-template-columns: 1fr; } }
  /* 画廊内部：缩略图竖排在左 + 大图在右（对齐 Alibaba/Amazon 的商品图布局）。
     1:1 大图单独占满整列时高度达 608px，会把缩略图整个顶到折叠线以下，
     买家首屏看不出“还有很多张图”；改成左侧 72px 竖排后大图降到 ~516px，首屏能同时装下两者。

     实现要点：缩略图列用 position:absolute 脱离文档流，只靠 padding-left 预留槽位。
     若用 flex + align-items:stretch，14 张缩略图的固有高度（860px）会反过来把舞台拉高、
     导致 aspect-ratio:1/1 失效（实测大图变 516×860、上下各 172px 白边）。
     脱离流后：画廊高度 = 大图高度，缩略图列 top/bottom 钉到同一个 0 → 高度自然等于大图，
     装不下的部分在列内滚动。 */
  .pk-hero-gallery { position: relative; align-self: start; }
  /* 有缩略图时才预留左侧槽位（无 gallery 的产品主图要占满整列） */
  .pk-hero-gallery.with-thumbs { padding-left: 84px; } /* 72 列宽 + 12 间距 */

  /* 主图舞台固定 1:1：画廊里图片原始比例不一（方形细节图 / 1200×501 色卡条 / 竖幅实景图），
     若用 height:auto 切换缩略图时容器高度会变，整页跟着跳。
     固定比例 + object-fit:contain 保证既不拉伸变形、也不跳。
     用子选择器 > 限定：watermark.js 会把每张缩略图也包一层 .img-watermark，不能误用舞台规则。 */
  .pk-hero-gallery > .img-watermark { position: relative; aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: 8px; overflow: hidden; border: 1px solid #e2e8f0; }
  .pk-hero-gallery > .img-watermark > img { width: 100%; height: 100%; object-fit: contain; display: block; }

  .pk-thumbs { position: absolute; left: 0; top: 0; bottom: 0; width: 72px;
    display: flex; flex-direction: column; gap: 8px;
    overflow-y: auto; overflow-x: hidden;
    /* 隐藏原生 scrollbar：它占 10px 宽，会把 72px 缩略图裁成 62px、切掉 active 金边；
       可滚动的提示改由下面的上下箭头承担 */
    scrollbar-width: none; -ms-overflow-style: none; }
  .pk-thumbs::-webkit-scrollbar { width: 0; height: 0; }
  .pk-thumbs > * { flex: 0 0 auto; }

  /* 缩略图列上下箭头（贴在列的两端，白底带阴影，滚到顶/底自动隐藏） */
  .pk-thumb-nav { position: absolute; left: 0; width: 72px; height: 28px; z-index: 2;
    display: flex; align-items: center; justify-content: center; padding: 0;
    background: #fff; border: 1px solid #e2e8f0; color: #69574a; cursor: pointer;
    transition: background-color .2s, color .2s; }
  .pk-thumb-nav[hidden] { display: none; }
  .pk-thumb-nav svg { width: 16px; height: 16px; }
  .pk-thumb-nav:hover { background: #f5f0eb; color: #c09020; }
  /* 全站 reset 把 outline 关了，新加的按钮必须自带键盘焦点环，否则 Tab 上去看不见 */
  .pk-thumb-nav:focus-visible { outline: 2px solid #c09020; outline-offset: -2px; }
  .pk-thumb-up { top: 0; border-radius: 0 0 6px 6px; box-shadow: 0 2px 5px rgba(16, 19, 26, 0.08); }
  .pk-thumb-down { bottom: 0; border-radius: 6px 6px 0 0; box-shadow: 0 -2px 5px rgba(16, 19, 26, 0.08); }
  .pk-thumb { width: 72px; height: 54px; object-fit: cover; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color .2s; }
  .pk-thumb.active { border-color: #c09020; }
  .pk-thumb:hover { border-color: #c09020; opacity: .85; }

  /* 窄屏退回“大图在上、缩略图横排在下”：竖排列在单列布局下会吃掉宝贵的宽度 */
  @media (max-width: 768px) {
    .pk-hero-gallery.with-thumbs { padding-left: 0; }
