---
import Breadcrumb from "../../components/Breadcrumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import InquiryButton from "../../components/InquiryButton.astro";
import { supabase } from "../../lib/supabase";
import { getCategoryChain } from "../../lib/categoryPath";
import { productKnowledge, type ProductKnowledge } from "../../lib/productKnowledge";
import { currentLang } from "../../lib/i18n";

// SSR 按需渲染
export const prerender = false;

const lang = currentLang(Astro.locals);

const { slug } = Astro.params;
const { data: product, error } = await supabase
  .from("products")
  .select("*")
  .eq("slug", slug)
  .eq("lang", lang)
  .eq("status", "published")
  .maybeSingle();

if (error || !product) {
  return Astro.redirect("/products/");
}

const primaryCategoryId = product.primary_category_id ?? null;
const categoryChain = await getCategoryChain(primaryCategoryId);

const pageTitle = product.seo_title || product.title;
const pageDescription = product.seo_description || product.description;
const keywords = product.keywords ?? [];

// Look up enriched knowledge by the first category slug in the chain
const categorySlug = categoryChain.length > 0 ? categoryChain[categoryChain.length - 1].slug : null;
const knowledge: ProductKnowledge | undefined = categorySlug ? productKnowledge[categorySlug] : undefined;

// ── enriched_specs 合并逻辑 ──
// 优先使用产品专属的 enriched_specs，没有则回退到品类级 knowledge
const es = product.enriched_specs ?? null;
const displaySpecs = (es?.specs && es.specs.length > 0) ? es.specs : (knowledge?.technicalSpecs ?? []);
const displayFeatures = (es?.features && es.features.length > 0) ? es.features : (knowledge?.keyFeatures ?? []);
const displaySummary = es?.summary || null; // 产品专属概述（可选）
const displayApps = (es?.applications && es.applications.length > 0) ? es.applications : null; // 产品专属适用场景标签（可选）
const hasProductSpecificData = !!es; // 标记：当前产品有专属数据

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.title,
  "description": product.description,
  "image": product.image_url,
  "sku": product.part_code,
  "brand": product.brand ? { "@type": "Brand", name: product.brand } : undefined,
  "category": categoryChain.length > 0 ? categoryChain.map(c => c.name).join(" > ") : undefined,
  "offers": product.price != null ? {
    "@type": "Offer",
    "price": product.price,
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
  } : undefined,
};
---

<BaseLayout
  pageTitle={pageTitle}
  headingTitle={product.title}
  description={pageDescription}
  image={product.image_url}
  type="article"
  pubDate={product.created_at ? new Date(product.created_at) : undefined}
  keywords={keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Breadcrumb
    root={{ name: "Products", url: "/products/" }}
    middleItems={categoryChain}
    current={product.title}
    currentUrl={`/products/${product.slug}/`}
  />

  <!-- ══════ PRODUCT HERO ══════ -->
  <div class="pk-hero">
    <div class="pk-hero-gallery">
      {product.image_url && (
        <div class="img-watermark">
          <img id="main-image" src={product.image_url} alt={product.image_alt || product.title} width="600" height="400" />
        </div>
      )}
      {(product.gallery && product.gallery.length > 0) && (
        <div class="pk-thumbs">
          {product.image_url && (
            <img src={product.image_url} alt={product.image_alt || product.title} class="pk-thumb active" data-full={product.image_url} width="80" height="60" />
          )}
          {product.gallery.map((url: string, i: number) => (
            <img src={url} alt={`${product.title} - image ${i + 2}`} class="pk-thumb" data-full={url} width="80" height="60" loading="lazy" />
          ))}
        </div>
      )}
    </div>

    <div class="pk-hero-info">
      {product.part_code && <p class="pk-part-code">Part No: {product.part_code}</p>}
      <p class="pk-desc"><em>{product.description}</em></p>
      {product.price != null && <p class="pk-price">Starting from <strong>${product.price}</strong></p>}

      <!-- Quick Specs: enriched_specs 优先，回退品类通用 -->
      {displaySpecs.length > 0 && (
        <>
          {hasProductSpecificData && <p class="pk-specs-label">This Product's Specs</p>}
          <table class="pk-quick-specs">
            {displaySpecs.slice(0, 5).map((s: { label: string; value: string }) => (
              <tr><th>{s.label}</th><td>{s.value}</td></tr>
            ))}
          </table>
        </>
      )}

      <!-- CTA Buttons -->
      <div class="pk-cta-row">
        <InquiryButton label="Get a Free Quote" class="pk-cta-primary" />
        <InquiryButton label="Request Sample" class="pk-cta-secondary" />
      </div>

      <!-- Certifications badges -->
      {knowledge && knowledge.certifications.length > 0 && (
        <div class="pk-certs">
          {knowledge.certifications.slice(0, 4).map((cert) => (
            <span class="pk-cert-badge">✓ {cert}</span>
          ))}
        </div>
      )}
    </div>
  </div>

  <!-- ══════ KEY FEATURES: enriched_specs 优先，回退品类通用 ══════ -->
  {displayFeatures.length > 0 && (
    <section class="pk-features">
      <h2>Key Features</h2>
      <ul class="pk-features-list">
        {displayFeatures.map((f: string) => (
          <li>
            <svg viewBox="0 0 20 20" width="18" height="18" fill="none"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" fill="#c09020"/></svg>
            {f}
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- ══════ TABBED CONTENT ══════ -->
  {(knowledge || displaySpecs.length > 0) && (
    <section class="pk-tabs">
      <div class="pk-tab-nav" role="tablist">
        <button class="pk-tab-btn active" data-tab="overview" role="tab" aria-selected="true">Overview</button>
        <button class="pk-tab-btn" data-tab="specs" role="tab" aria-selected="false">Technical Specs</button>
        <button class="pk-tab-btn" data-tab="surface" role="tab" aria-selected="false">Surface Options</button>
        <button class="pk-tab-btn" data-tab="install" role="tab" aria-selected="false">Installation</button>
        <button class="pk-tab-btn" data-tab="applications" role="tab" aria-selected="false">Applications</button>
        <button class="pk-tab-btn" data-tab="downloads" role="tab" aria-selected="false">Downloads</button>
      </div>

      <!-- Tab: Overview -->
      <div class="pk-tab-panel active" data-panel="overview" role="tabpanel">
        {displaySummary && <p class="pk-overview pk-overview-product"><strong>Product Overview:</strong> {displaySummary}</p>}
        {knowledge && <p class="pk-overview">{knowledge.overview}</p>}
        {knowledge && knowledge.standardSizes.length > 0 && (
          <>
            <h3>Standard Sizes &amp; Profiles</h3>
            <table class="pk-spec-table">
              {knowledge.standardSizes.map((s) => (
                <tr><th>{s.label}</th><td>{s.value}</td></tr>
              ))}
            </table>
          </>
        )}
      </div>

      <!-- Tab: Technical Specs -->
      <div class="pk-tab-panel" data-panel="specs" role="tabpanel">
        <h3>Full Technical Specifications</h3>
        {hasProductSpecificData && <p class="pk-specs-note">These specifications are for this specific product. <a href="/installation-guides/">View installation guides →</a></p>}
        <table class="pk-spec-table">
          {displaySpecs.map((s: { label: string; value: string }) => (
            <tr><th>{s.label}</th><td>{s.value}</td></tr>
          ))}
        </table>
      </div>

      <!-- Tab: Surface Options -->
      <div class="pk-tab-panel" data-panel="surface" role="tabpanel">
        <h3>Available Surface Treatments</h3>
        <p class="pk-surface-intro">Choose the right coating system for your project's environment, budget, and design requirements. <a href="/surface-treatment-comparison/">Compare all surface treatments →</a></p>
        {knowledge?.surfaceOptions && (
        <div class="pk-surface-cards">
          {knowledge.surfaceOptions.map((opt) => (
            <div class="pk-surface-card">
              <h4>{opt.name}</h4>
              <p>{opt.description}</p>
              <dl class="pk-surface-dl">
                <dt>Film Thickness</dt><dd>{opt.thickness}</dd>
                <dt>Warranty</dt><dd>{opt.warranty}</dd>
                <dt>Best For</dt>
                <dd>
                  <div class="pk-tags">
                    {opt.suitableFor.map((t) => (<span class="pk-tag">{t}</span>))}
                  </div>
                </dd>
              </dl>
            </div>
          ))}
        </div>
        )}
      </div>
      <!-- Tab: Installation -->
      <div class="pk-tab-panel" data-panel="install" role="tabpanel">
        <h3>Installation Guide</h3>
        {knowledge?.installationSteps && (
        <div class="pk-steps">
          {knowledge.installationSteps.map((s) => (
            <div class="pk-step">
              <span class="pk-step-num">{s.step}</span>
              <div class="pk-step-body">
                <h4>{s.title}</h4>
                <p>{s.description}</p>
              </div>
            </div>
          ))}
        </div>
        )}
        {knowledge?.installationTips && knowledge.installationTips.length > 0 && (
          <div class="pk-tips">
            <h4>Installation Tips</h4>
            <ul>
              {knowledge.installationTips.map((tip) => (<li>{tip}</li>))}
            </ul>
          </div>
        )}
      </div>
      <div class="pk-tab-panel" data-panel="applications" role="tabpanel">
        <h3>Application Scenarios</h3>
        {displayApps && (
          <div class="pk-product-apps">
            <p class="pk-product-apps-title">Recommended Applications for This Product:</p>
            <div class="pk-tags pk-app-tags">
              {displayApps.map((a: string) => (<span class="pk-tag pk-app-tag">{a}</span>))}
            </div>
          </div>
        )}
        {knowledge && (
          <div class="pk-app-cards">
            {knowledge.applications.map((app) => (
              <div class="pk-app-card">
                <h4>{app.type}</h4>
                <p class="pk-app-why">{app.whyUse}</p>
                <div class="pk-app-products">
                  <strong>Recommended:</strong>
                  <ul>{app.recommendedProducts.map((r) => (<li>{r}</li>))}</ul>
                </div>
                <p class="pk-app-benefit"><strong>Key Benefit:</strong> {app.keyBenefit}</p>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Tab: Downloads -->
      <div class="pk-tab-panel" data-panel="downloads" role="tabpanel">
        <h3>Technical Downloads</h3>
        {knowledge ? (
        <div class="pk-downloads">
          <div class="pk-dl-group">
            <h4>Specification Sheet</h4>
            <a href={knowledge.specSheetUrl} class="pk-dl-btn">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              Download PDF Spec Sheet
            </a>
          </div>
          {knowledge.cadFiles.length > 0 && (
            <div class="pk-dl-group">
              <h4>CAD Drawings</h4>
              {knowledge.cadFiles.map((f) => (
                <a href={f.url} class="pk-dl-btn">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                  {f.name} <span class="pk-dl-fmt">({f.format})</span>
                </a>
              ))}
            </div>
          )}
          {knowledge.bimFiles.length > 0 && (
            <div class="pk-dl-group">
              <h4>BIM Models</h4>
              {knowledge.bimFiles.map((f) => (
                <a href={f.url} class="pk-dl-btn">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                  {f.name} <span class="pk-dl-fmt">({f.format})</span>
                </a>
              ))}
            </div>
          )}
        </div>
        ) : (
          <p class="pk-no-data">Technical downloads coming soon. <a href="/contact/">Contact us</a> for immediate access to spec sheets and CAD files.</p>
        )}
      </div>
    </section>
  )}

  <!-- ══════ DB CONTENT (legacy) ══════ -->
  {product.content && (
    <div class="pk-db-content" set:html={product.content} />
  )}

  <!-- ══════ BOTTOM CTA ══════ -->
  <section class="pk-bottom-cta">
    <h2>Need Help Selecting the Right Product?</h2>
    <p>Our engineering team provides free technical consultation, shop drawing support, and custom quotations. Tell us about your project and we'll recommend the optimal solution.</p>
    <div class="pk-bottom-cta-btns">
      <InquiryButton label="Get a Free Quote" class="pk-cta-primary" />
      <a href="/contact/" class="pk-cta-outline">Contact Our Team</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Thumbnail click: swap main image
  const mainImage = document.getElementById('main-image') as HTMLImageElement | null;
  document.querySelectorAll<HTMLImageElement>('.pk-thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      if (!mainImage) return;
      mainImage.src = thumb.dataset.full || thumb.src;
      mainImage.alt = thumb.alt;
      document.querySelectorAll('.pk-thumb').forEach((t) => t.classList.remove('active'));
      thumb.classList.add('active');
    });
  });

  // Tab switching
  document.querySelectorAll<HTMLButtonElement>('.pk-tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabId = btn.dataset.tab;
      document.querySelectorAll('.pk-tab-btn').forEach((b) => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
      document.querySelectorAll('.pk-tab-panel').forEach((p) => p.classList.remove('active'));
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      document.querySelector(`.pk-tab-panel[data-panel="${tabId}"]`)?.classList.add('active');
    });
  });
</script>

<style>
  /* ═══ HERO ═══ */
  .pk-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2.5rem; }
  @media (max-width: 768px) { .pk-hero { grid-template-columns: 1fr; } }

  .pk-hero-gallery .img-watermark { border-radius: 8px; overflow: hidden; border: 1px solid #e2e8f0; }
  .pk-hero-gallery .img-watermark > img { width: 100%; height: auto; display: block; }

  .pk-thumbs { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
  .pk-thumb { width: 72px; height: 54px; object-fit: cover; border-radius: 4px; border: 2px solid transparent; cursor: pointer; transition: border-color .2s; }
  .pk-thumb.active { border-color: #c09020; }
  .pk-thumb:hover { border-color: #c09020; opacity: .85; }

  .pk-part-code { font-size: .85rem; color: #64748b; margin: 0 0 .5rem; }
  .pk-desc { color: #475569; margin: 0 0 .75rem; line-height: 1.6; }
  .pk-price { font-size: 1.1rem; color: #1e293b; margin: 0 0 1rem; }
  .pk-price strong { font-size: 1.35rem; color: #0d0950; }

  .pk-quick-specs { border-collapse: collapse; width: 100%; margin: 0 0 1.25rem; }
  .pk-quick-specs th, .pk-quick-specs td { text-align: left; padding: 6px 10px; border-bottom: 1px solid #f1f5f9; font-size: .85rem; }
  .pk-quick-specs th { color: #64748b; font-weight: 500; width: 38%; }
  .pk-specs-label { font-size: .78rem; font-weight: 600; color: #c09020; margin: 0 0 6px; text-transform: uppercase; letter-spacing: .5px; }

  .pk-cta-row { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1rem; }
  .pk-cta-row :global(.pk-cta-primary) { background-color: #69574a !important; padding: .7rem 1.5rem !important; font-size: 1rem !important; }
  .pk-cta-row :global(.pk-cta-secondary) { background-color: transparent !important; color: #69574a !important; border: 2px solid #69574a !important; box-shadow: none !important; padding: .65rem 1.5rem !important; font-size: 1rem !important; }
  .pk-cta-row :global(.pk-cta-secondary:hover) { background-color: #69574a !important; color: #fff !important; }

  .pk-certs { display: flex; flex-wrap: wrap; gap: 6px; }
  .pk-cert-badge { display: inline-block; font-size: .72rem; font-weight: 600; color: #69574a; background: #f5f0eb; border: 1px solid #e2d6c8; border-radius: 4px; padding: 3px 10px; }

  /* ═══ KEY FEATURES ═══ */
  .pk-features { margin-bottom: 2.5rem; }
  .pk-features h2 { font-size: 1.5rem; margin: 0 0 1rem; color: #1e293b; }
  .pk-features-list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; }
  @media (max-width: 640px) { .pk-features-list { grid-template-columns: 1fr; } }
  .pk-features-list li { display: flex; align-items: flex-start; gap: 8px; font-size: .9rem; color: #334155; line-height: 1.5; }
  .pk-features-list svg { flex-shrink: 0; margin-top: 2px; }

  /* ═══ TABS ═══ */
  .pk-tabs { margin-bottom: 2.5rem; }
  .pk-tab-nav { display: flex; gap: 0; border-bottom: 2px solid #e2e8f0; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .pk-tab-btn { padding: 12px 20px; font-size: .88rem; font-weight: 600; color: #64748b; background: none; border: none; border-bottom: 2px solid transparent; margin-bottom: -2px; cursor: pointer; white-space: nowrap; transition: color .2s, border-color .2s; }
  .pk-tab-btn:hover { color: #334155; }
  .pk-tab-btn.active { color: #c09020; border-bottom-color: #c09020; }

  .pk-tab-panel { display: none; padding: 1.5rem 0; }
  .pk-tab-panel.active { display: block; }
  .pk-tab-panel h3 { font-size: 1.25rem; margin: 0 0 1rem; color: #1e293b; }

  /* Overview */
  .pk-overview { font-size: .95rem; line-height: 1.8; color: #475569; margin-bottom: 1.5rem; }
  .pk-overview-product { background: #fefce8; border-left: 3px solid #c09020; padding: 12px 16px; border-radius: 0 6px 6px 0; color: #78350f; margin-bottom: 1rem; }
  .pk-specs-note { font-size: .85rem; color: #64748b; margin-bottom: 1rem; }
  .pk-specs-note a { color: #c09020; }
  .pk-product-apps { margin-bottom: 1.5rem; }
  .pk-product-apps-title { font-size: .9rem; font-weight: 600; color: #1e293b; margin: 0 0 8px; }
  .pk-app-tags { margin-bottom: 1rem; }
  .pk-app-tag { background: #fef3c7; color: #92400e; font-weight: 500; font-size: .82rem; }

  /* Spec tables */
  .pk-spec-table { border-collapse: collapse; width: 100%; }
  .pk-spec-table th, .pk-spec-table td { text-align: left; padding: 10px 14px; border-bottom: 1px solid #f1f5f9; font-size: .88rem; }
  .pk-spec-table th { color: #64748b; font-weight: 500; width: 32%; background: #fafafa; }
  .pk-spec-table tr:hover { background: #fafbfc; }

  /* Surface cards */
  .pk-surface-intro { color: #64748b; font-size: .9rem; margin-bottom: 1rem; }
  .pk-surface-intro a { color: #c09020; }
  .pk-surface-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .pk-surface-card { border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; background: #fff; transition: box-shadow .2s, border-color .2s; }
  .pk-surface-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.08); border-color: #c09020; }
  .pk-surface-card h4 { margin: 0 0 8px; font-size: 1rem; color: #1e293b; }
  .pk-surface-card p { font-size: .85rem; color: #64748b; line-height: 1.6; margin: 0 0 12px; }
  .pk-surface-dl { margin: 0; }
  .pk-surface-dl dt { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; color: #94a3b8; margin-top: 8px; }
  .pk-surface-dl dd { margin: 2px 0 0; font-size: .85rem; color: #334155; }
  .pk-tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .pk-tag { display: inline-block; font-size: .72rem; background: #f0f4f8; color: #475569; border-radius: 3px; padding: 2px 8px; }

  /* Installation steps */
  .pk-steps { display: flex; flex-direction: column; gap: 16px; }
  .pk-step { display: flex; gap: 14px; align-items: flex-start; }
  .pk-step-num { flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; background: #c09020; color: #fff; font-size: .8rem; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .pk-step-body h4 { margin: 0 0 4px; font-size: .95rem; color: #1e293b; }
  .pk-step-body p { margin: 0; font-size: .88rem; color: #475569; line-height: 1.6; }
  .pk-tips { margin-top: 1.5rem; padding: 16px 20px; background: #fefce8; border: 1px solid #fde68a; border-radius: 8px; }
  .pk-tips h4 { margin: 0 0 8px; font-size: .95rem; color: #92400e; }
  .pk-tips ul { margin: 0; padding: 0 0 0 18px; }
  .pk-tips li { font-size: .85rem; color: #78350f; margin-bottom: 4px; line-height: 1.5; }

  /* Application cards */
  .pk-app-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .pk-app-card { border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; background: #fff; }
  .pk-app-card h4 { margin: 0 0 8px; font-size: 1.05rem; color: #1e293b; }
  .pk-app-why { font-size: .88rem; color: #475569; line-height: 1.6; margin: 0 0 12px; }
  .pk-app-products { margin-bottom: 8px; }
  .pk-app-products strong { font-size: .8rem; color: #64748b; }
  .pk-app-products ul { margin: 4px 0 0; padding: 0 0 0 16px; }
  .pk-app-products li { font-size: .85rem; color: #334155; margin-bottom: 2px; }
  .pk-app-benefit { font-size: .85rem; color: #334155; margin: 8px 0 0; }

  /* Downloads */
  .pk-downloads { display: flex; flex-direction: column; gap: 20px; }
  .pk-dl-group h4 { margin: 0 0 10px; font-size: .95rem; color: #1e293b; }
  .pk-dl-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; margin-bottom: 6px; border: 1px solid #e2e8f0; border-radius: 6px; text-decoration: none; color: #334155; font-size: .88rem; font-weight: 500; transition: border-color .2s, background .2s; }
