---
/**
 * products/page/[page].astro — 产品列表第 2~N 页（SSR）
 *
 * - 第 1 页由 products/index.astro 渲染（/products/ 为规范地址），本路由只负责 /products/page/2/ 起
 * - 页码非法或超出总页数一律 302 回第 1 页：不留空页，也不产生重复内容
 * - 卡片网格与第 1 页共用 ProductGrid 组件
 */
import PageHero from "../../../components/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProductGrid from "../../../components/ProductGrid.astro";
import PaginationNav from "../../../components/PaginationNav.astro";
import { supabase } from "../../../lib/supabase";
import { currentLang, loc } from "../../../lib/i18n";
import { PAGE_SIZE, resolvePage } from "../../../lib/pagination";

// SSR：新增/下线产品会改变总页数，转静态会让第 2 页停在旧总数上。
export const prerender = false;

const lang = currentLang(Astro.locals);

// 只取总数计算页数，不拉取产品数据（停放期仅英语）
const { count } = await supabase
    .from("products")
    .select("*", { count: "exact", head: true })
    .eq("status", "published")
    .eq("lang", "en");

const totalPages = Math.ceil((count ?? 0) / PAGE_SIZE);
const currentPage = resolvePage(Astro.params.page, totalPages);

if (currentPage === null) {
    return Astro.redirect("/products/");
}

// 本页对应的数据切片（.range() 两端含，数据库层分页）
const from = (currentPage - 1) * PAGE_SIZE;
const to = from + PAGE_SIZE - 1;

const result = await supabase
    .from("products")
    .select("*")
    .eq("status", "published")
    .eq("lang", lang)
    .order("created_at", { ascending: false })
    .order("slug", { ascending: true })
    .range(from, to);

if (result.error) {
    console.error(
        `Failed to fetch products for page ${currentPage}:`,
        result.error,
    );
}

const products = result.data ?? [];

// Fetch all categories for display
const { data: allCategories } = await supabase
    .from("categories")
    .select("id, name, slug");

const categoryMap = new Map<number, { name: string; slug: string }>();
for (const cat of allCategories ?? []) {
    categoryMap.set(cat.id, { name: cat.name, slug: cat.slug });
}
---

<BaseLayout pageTitle={`Products - Page ${currentPage}`} lang={lang} hideTitle>
    <PageHero
        slim
        imageAlt={`Products - Page ${currentPage}`}
        titleWhite="Products"
        titleGold={`Page ${currentPage}`}
        crumb={{
            items: [
                { name: "Home", url: loc(lang, "/") },
                { name: "Products", url: loc(lang, "/products/") },
                {
                    name: `Page ${currentPage}`,
                    url: `/products/page/${currentPage}/`,
                },
            ],
        }}
    />
    <ProductGrid products={products} categoryMap={categoryMap} lang={lang} />
    <PaginationNav
        currentPage={currentPage}
        totalPages={totalPages}
        basePath="/products/page"
        firstPageUrl="/products/"
    />
</BaseLayout>
