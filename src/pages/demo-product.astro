---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import InquiryButton from "../components/InquiryButton.astro";
import { productKnowledge } from "../lib/productKnowledge";

/**
 * 产品详情页 Demo — 用 Aluminum Veneer 的知识库数据展示完整布局。
 * 这个页面仅用于预览和开发调试，正式上线后可删除。
 * URL: /demo-product/
 */
const knowledge = productKnowledge["aluminum-veneer"];

// ── 模拟 enriched_specs 数据（相当于数据库里填的内容）──
const enriched_specs = {
    summary:
        "2.5mm PVDF aluminum veneer panel designed for mid-to-high-rise exterior facade applications. Factory CNC formed with concealed fix bracket system for clean, screw-free appearance. Available in full RAL and custom color matching.",
    specs: [
        { label: "Panel Thickness", value: "2.5mm" },
        { label: "Alloy Grade", value: "AA3003-H24" },
        { label: "Standard Width", value: "1000 / 1220 / 1500mm" },
        { label: "Max Length", value: "4000mm" },
        { label: "Weight", value: "6.8 kg/m²" },
        { label: "Tensile Strength", value: "≥ 130 MPa" },
        { label: "Coating", value: "2-coat PVDF (Kynar 500®)" },
        { label: "Film Thickness", value: "30μm" },
        { label: "Color Warranty", value: "25 years (AAMA 2605)" },
        { label: "Fire Rating", value: "A2-s1,d0" },
        { label: "Wind Load", value: "Up to 4.5 kPa @ 1200mm span" },
        { label: "Flatness", value: "≤ 1.5mm per 1000mm" },
    ],
    features: [
        "Custom CNC formed: flat, curved, folded, or parametric shapes",
        "PVDF Kynar 500® coating — 25-year color retention (AAMA 2605)",
        "Concealed fix bracket system — no visible screws on facade",
        "Lightweight at 6.8 kg/m² — 30% lighter than stone cladding",
        "Full RAL color range + custom color matching",
    ],
    applications: [
        "Commercial high-rise facades (10–50 stories)",
        "Airport terminals and transit stations",
        "Coastal environment buildings",
        "Hospital and institutional facades",
    ],
};

// ── 与 [slug].astro 完全相同的合并逻辑 ──
const es = enriched_specs;
const displaySpecs =
    es?.specs && es.specs.length > 0
        ? es.specs
        : (knowledge?.technicalSpecs ?? []);
const displayFeatures =
    es?.features && es.features.length > 0
        ? es.features
        : (knowledge?.keyFeatures ?? []);
const displaySummary = es?.summary || null;
const displayApps =
    es?.applications && es.applications.length > 0 ? es.applications : null;
const hasProductSpecificData = !!es;

const pageTitle = `Demo: ${displaySpecs[0]?.value || ""} ${knowledge.categoryName} — Product Page with enriched_specs`;
const pageDescription = (displaySummary || knowledge.overview).substring(
    0,
    160,
);

// Demo product data
const product = {
    title: "2.5mm PVDF Coated Aluminum Veneer Panel",
    part_code: "MY-AV-2500-PVDF",
    description:
        "High-quality 2.5mm aluminum veneer panel with PVDF fluorocarbon coating for exterior facade applications. Custom CNC formed to project specifications with full color matching.",
    price: "35.00",
    image_url:
        "https://file.meiyualuminum.com/home/mega-menu/aluminum-veneer.webp",
    gallery: [
        "https://file.meiyualuminum.com/home/custom-aluminum-single-panel-design-factory-installation-building-facade.webp",
        "https://file.meiyualuminum.com/home/aluminum-facade/avant-garde-skyscraper-dark-fins-gold-trim-under-construction.webp",
        "https://file.meiyualuminum.com/home/aluminum-facade/modern-stadium-white-canopy-colonnade-exterior-architecture.webp",
    ],
};
---

<BaseLayout
    pageTitle={pageTitle}
    headingTitle={product.title}
    description={pageDescription}
>
    <Breadcrumb
        items={[
            { name: "Home", url: "/" },
            { name: "Products", url: "/products/" },
            { name: "Aluminum Veneer", url: "/categories/aluminum-veneer/" },
            { name: product.title, url: "/demo-product/" },
        ]}
    />

    <!-- ══════ PRODUCT HERO ══════ -->
    <div class="pk-hero">
        <div class="pk-hero-gallery">
            <div class="img-watermark">
                <img
                    id="main-image"
                    src={product.image_url}
                    alt={product.title}
                    width="600"
                    height="400"
                />
            </div>
            <div class="pk-thumbs">
                <img
                    src={product.image_url}
                    alt={product.title}
                    class="pk-thumb active"
                    data-full={product.image_url}
                    width="80"
                    height="60"
                />
                {
                    product.gallery.map((url, i) => (
                        <img
                            src={url}
                            alt={`${product.title} - image ${i + 2}`}
                            class="pk-thumb"
                            data-full={url}
                            width="80"
                            height="60"
                            loading="lazy"
                        />
                    ))
                }
            </div>
        </div>

        <div class="pk-hero-info">
            <p class="pk-part-code">Part No: {product.part_code}</p>
            <p class="pk-desc"><em>{product.description}</em></p>
            <p class="pk-price">
                Starting from <strong>${product.price}/m²</strong>
            </p>

            {
                hasProductSpecificData && (
                    <p class="pk-specs-label">This Product's Specs</p>
                )
            }
            <table class="pk-quick-specs">
                {
                    displaySpecs
                        .slice(0, 5)
                        .map((s: { label: string; value: string }) => (
                            <tr>
                                <th>{s.label}</th>
                                <td>{s.value}</td>
                            </tr>
                        ))
                }
            </table>

            <div class="pk-cta-row">
                <InquiryButton
                    label="Get a Free Quote"
                    class="pk-cta-primary"
                />
                <InquiryButton
                    label="Request Sample"
                    class="pk-cta-secondary"
                />
            </div>

            <div class="pk-certs">
                {
                    knowledge.certifications
                        .slice(0, 4)
                        .map((cert) => (
                            <span class="pk-cert-badge">✓ {cert}</span>
                        ))
                }
            </div>
        </div>
    </div>

    <!-- ══════ KEY FEATURES: enriched_specs 优先 ══════ -->
    {
        displayFeatures.length > 0 && (
            <section class="pk-features">
                <h2>Key Features</h2>
                <ul class="pk-features-list">
                    {displayFeatures.map((f: string) => (
                        <li>
                            <svg
                                viewBox="0 0 20 20"
                                width="18"
                                height="18"
                                fill="none"
                            >
                                <path
                                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                    fill="#c09020"
                                />
                            </svg>
                            {f}
                        </li>
                    ))}
                </ul>
            </section>
        )
    }

    <!-- ══════ TABBED CONTENT ══════ -->
    <section class="pk-tabs">
        <div class="pk-tab-nav" role="tablist">
            <button
                class="pk-tab-btn active"
                data-tab="overview"
                role="tab"
                aria-selected="true">Overview</button
            >
            <button
                class="pk-tab-btn"
                data-tab="specs"
                role="tab"
                aria-selected="false">Technical Specs</button
            >
            <button
                class="pk-tab-btn"
                data-tab="surface"
                role="tab"
                aria-selected="false">Surface Options</button
            >
            <button
                class="pk-tab-btn"
                data-tab="install"
                role="tab"
                aria-selected="false">Installation</button
            >
            <button
                class="pk-tab-btn"
                data-tab="applications"
                role="tab"
                aria-selected="false">Applications</button
            >
            <button
                class="pk-tab-btn"
                data-tab="downloads"
                role="tab"
                aria-selected="false">Downloads</button
            >
        </div>

        <!-- Tab: Overview -->
        <div class="pk-tab-panel active" data-panel="overview" role="tabpanel">
            {
                displaySummary && (
                    <p class="pk-overview pk-overview-product">
                        <strong>Product Overview:</strong> {displaySummary}
                    </p>
                )
            }
            <p class="pk-overview">{knowledge.overview}</p>
            <h3>Standard Sizes &amp; Profiles</h3>
            <table class="pk-spec-table">
                {
                    knowledge.standardSizes.map((s) => (
                        <tr>
                            <>
                                <th>{s.label}</th>
                                <td>{s.value}</td>
                            </>
                        </tr>
                    ))
                }
            </table>
        </div>

        <!-- Tab: Technical Specs -->
        <div class="pk-tab-panel" data-panel="specs" role="tabpanel">
            <h3>Full Technical Specifications</h3>
            {
                hasProductSpecificData && (
                    <p class="pk-specs-note">
                        These specifications are for this specific product.{" "}
                        <a href="/installation-guides/">
                            View installation guides →
                        </a>
                    </p>
                )
            }
            <table class="pk-spec-table">
                {
                    displaySpecs.map((s: { label: string; value: string }) => (
                        <tr>
                            <th>{s.label}</th>
                            <td>{s.value}</td>
                        </tr>
                    ))
                }
            </table>
        </div>

        <!-- Tab: Surface Options -->
        <div class="pk-tab-panel" data-panel="surface" role="tabpanel">
            <h3>Available Surface Treatments</h3>
            <p class="pk-surface-intro">
                Choose the right coating system for your project. <a
                    href="/surface-treatment-comparison/"
                    >Compare all surface treatments →</a
                >
            </p>
            <div class="pk-surface-cards">
                {
                    knowledge.surfaceOptions.map((opt) => (
                        <div class="pk-surface-card">
                            <h4>{opt.name}</h4>
                            <p>{opt.description}</p>
                            <dl class="pk-surface-dl">
                                <>
                                    <dt>Film Thickness</dt>
                                    <dd>{opt.thickness}</dd>
                                </>
                                <>
                                    <dt>Warranty</dt>
                                    <dd>{opt.warranty}</dd>
                                </>
                                <dt>Best For</dt>
                                <dd>
                                    <div class="pk-tags">
                                        {opt.suitableFor.map((t) => (
                                            <span class="pk-tag">{t}</span>
                                        ))}
                                    </div>
                                </dd>
                            </dl>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Tab: Installation -->
        <div class="pk-tab-panel" data-panel="install" role="tabpanel">
            <h3>Installation Guide</h3>
            <div class="pk-steps">
                {
                    knowledge.installationSteps.map((s) => (
                        <div class="pk-step">
                            <span class="pk-step-num">{s.step}</span>
                            <div class="pk-step-body">
                                <h4>{s.title}</h4>
                                <p>{s.description}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
            <div class="pk-tips">
                <h4>Installation Tips</h4>
                <ul>
                    {knowledge.installationTips.map((tip) => <li>{tip}</li>)}
                </ul>
            </div>
        </div>

        <!-- Tab: Applications -->
        <div class="pk-tab-panel" data-panel="applications" role="tabpanel">
            <h3>Application Scenarios</h3>
            {
                displayApps && (
                    <div class="pk-product-apps">
                        <p class="pk-product-apps-title">
                            Recommended Applications for This Product:
                        </p>
                        <div class="pk-tags pk-app-tags">
                            {displayApps.map((a: string) => (
                                <span class="pk-tag pk-app-tag">{a}</span>
                            ))}
                        </div>
                    </div>
                )
            }
            <div class="pk-app-cards">
                {
                    knowledge.applications.map((app) => (
                        <div class="pk-app-card">
                            <h4>{app.type}</h4>
                            <p class="pk-app-why">{app.whyUse}</p>
                            <div class="pk-app-products">
                                <strong>Recommended:</strong>
                                <ul>
                                    {app.recommendedProducts.map((r) => (
                                        <li>{r}</li>
                                    ))}
                                </ul>
                            </div>
                            <p class="pk-app-benefit">
                                <strong>Key Benefit:</strong> {app.keyBenefit}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Tab: Downloads -->
        <div class="pk-tab-panel" data-panel="downloads" role="tabpanel">
            <h3>Technical Downloads</h3>
            <div class="pk-downloads">
                <div class="pk-dl-group">
                    <h4>Specification Sheet</h4>
                    <a href="#" class="pk-dl-btn">
                        <svg
                            viewBox="0 0 24 24"
                            width="16"
                            height="16"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            ><path
                                d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"
                            ></path></svg
                        >
                        Download PDF Spec Sheet
                    </a>
                </div>
                <div class="pk-dl-group">
                    <h4>CAD Drawings</h4>
                    {
                        knowledge.cadFiles.map((f) => (
                            <a href="#" class="pk-dl-btn">
                                <svg
                                    viewBox="0 0 24 24"
                                    width="16"
                                    height="16"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" />
                                </svg>
                                {f.name}{" "}
                                <span class="pk-dl-fmt">({f.format})</span>
                            </a>
                        ))
                    }
                </div>
                <div class="pk-dl-group">
                    <h4>BIM Models</h4>
                    {
                        knowledge.bimFiles.map((f) => (
                            <a href="#" class="pk-dl-btn">
                                <svg
                                    viewBox="0 0 24 24"
                                    width="16"
                                    height="16"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" />
                                </svg>
                                {f.name}{" "}
                                <span class="pk-dl-fmt">({f.format})</span>
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- ══════ BOTTOM CTA ══════ -->
    <section class="pk-bottom-cta">
        <h2>Need Help Selecting the Right Product?</h2>
        <p>
            Our engineering team provides free technical consultation, shop
            drawing support, and custom quotations. Tell us about your project
            and we'll recommend the optimal solution.
        </p>
        <div class="pk-bottom-cta-btns">
            <InquiryButton label="Get a Free Quote" class="pk-cta-primary" />
            <a href="/contact/" class="pk-cta-outline">Contact Our Team</a>
        </div>
    </section>
</BaseLayout>

<script>
    const mainImage = document.getElementById(
        "main-image",
    ) as HTMLImageElement | null;
    document
        .querySelectorAll<HTMLImageElement>(".pk-thumb")
        .forEach((thumb) => {
            thumb.addEventListener("click", () => {
                if (!mainImage) return;
                mainImage.src = thumb.dataset.full || thumb.src;
                mainImage.alt = thumb.alt;
                document
                    .querySelectorAll(".pk-thumb")
                    .forEach((t) => t.classList.remove("active"));
                thumb.classList.add("active");
            });
        });

    document
        .querySelectorAll<HTMLButtonElement>(".pk-tab-btn")
        .forEach((btn) => {
            btn.addEventListener("click", () => {
                const tabId = btn.dataset.tab;
                document.querySelectorAll(".pk-tab-btn").forEach((b) => {
                    b.classList.remove("active");
                    b.setAttribute("aria-selected", "false");
                });
                document
                    .querySelectorAll(".pk-tab-panel")
                    .forEach((p) => p.classList.remove("active"));
                btn.classList.add("active");
                btn.setAttribute("aria-selected", "true");
                document
                    .querySelector(`.pk-tab-panel[data-panel="${tabId}"]`)
                    ?.classList.add("active");
            });
        });
</script>

<style>
    /* ═══ HERO ═══ */
    .pk-hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-bottom: 2.5rem;
    }
    @media (max-width: 768px) {
        .pk-hero {
            grid-template-columns: 1fr;
        }
    }

    .pk-hero-gallery .img-watermark {
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }
    .pk-hero-gallery .img-watermark > img {
        width: 100%;
        height: auto;
        display: block;
    }

    .pk-thumbs {
        display: flex;
        gap: 8px;
        margin-top: 10px;
        flex-wrap: wrap;
    }
    .pk-thumb {
        width: 72px;
        height: 54px;
        object-fit: cover;
        border-radius: 4px;
        border: 2px solid transparent;
        cursor: pointer;
        transition: border-color 0.2s;
    }
    .pk-thumb.active {
        border-color: #c09020;
    }
    .pk-thumb:hover {
        border-color: #c09020;
        opacity: 0.85;
    }

    .pk-part-code {
        font-size: 0.85rem;
        color: #64748b;
        margin: 0 0 0.5rem;
    }
    .pk-desc {
        color: #475569;
        margin: 0 0 0.75rem;
        line-height: 1.6;
    }
    .pk-price {
        font-size: 1.1rem;
        color: #1e293b;
        margin: 0 0 1rem;
    }
    .pk-price strong {
        font-size: 1.35rem;
        color: #0d0950;
    }

    .pk-quick-specs {
        border-collapse: collapse;
        width: 100%;
        margin: 0 0 1.25rem;
    }
    .pk-quick-specs th,
    .pk-quick-specs td {
        text-align: left;
        padding: 6px 10px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.85rem;
    }
    .pk-quick-specs th {
        color: #64748b;
        font-weight: 500;
        width: 38%;
    }
    .pk-specs-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #c09020;
        margin: 0 0 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .pk-cta-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }
    .pk-cta-row :global(.pk-cta-primary) {
        background-color: #69574a !important;
        padding: 0.7rem 1.5rem !important;
        font-size: 1rem !important;
    }
    .pk-cta-row :global(.pk-cta-secondary) {
        background-color: transparent !important;
        color: #69574a !important;
        border: 2px solid #69574a !important;
        box-shadow: none !important;
        padding: 0.65rem 1.5rem !important;
        font-size: 1rem !important;
    }
    .pk-cta-row :global(.pk-cta-secondary:hover) {
        background-color: #69574a !important;
        color: #fff !important;
    }

    .pk-certs {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
    .pk-cert-badge {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 600;
        color: #69574a;
        background: #f5f0eb;
        border: 1px solid #e2d6c8;
        border-radius: 4px;
        padding: 3px 10px;
    }

    /* ═══ KEY FEATURES ═══ */
    .pk-features {
        margin-bottom: 2.5rem;
    }
    .pk-features h2 {
        font-size: 1.5rem;
        margin: 0 0 1rem;
        color: #1e293b;
    }
    .pk-features-list {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px 24px;
    }
    @media (max-width: 640px) {
        .pk-features-list {
            grid-template-columns: 1fr;
        }
    }
    .pk-features-list li {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 0.9rem;
        color: #334155;
        line-height: 1.5;
    }
    .pk-features-list svg {
        flex-shrink: 0;
        margin-top: 2px;
    }

    /* ═══ TABS ═══ */
    .pk-tabs {
        margin-bottom: 2.5rem;
    }
    .pk-tab-nav {
        display: flex;
        gap: 0;
        border-bottom: 2px solid #e2e8f0;
        overflow-x: auto;
    }
    .pk-tab-btn {
        padding: 12px 20px;
        font-size: 0.88rem;
        font-weight: 600;
        color: #64748b;
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        cursor: pointer;
        white-space: nowrap;
        transition:
            color 0.2s,
            border-color 0.2s;
    }
    .pk-tab-btn:hover {
        color: #334155;
    }
    .pk-tab-btn.active {
        color: #c09020;
        border-bottom-color: #c09020;
    }
    .pk-tab-panel {
        display: none;
        padding: 1.5rem 0;
    }
    .pk-tab-panel.active {
        display: block;
    }
    .pk-tab-panel h3 {
        font-size: 1.25rem;
        margin: 0 0 1rem;
        color: #1e293b;
    }

    .pk-overview {
        font-size: 0.95rem;
        line-height: 1.8;
        color: #475569;
        margin-bottom: 1.5rem;
    }
    .pk-overview-product {
        background: #fefce8;
        border-left: 3px solid #c09020;
        padding: 12px 16px;
        border-radius: 0 6px 6px 0;
        color: #78350f;
        margin-bottom: 1rem;
    }
    .pk-specs-note {
        font-size: 0.85rem;
        color: #64748b;
        margin-bottom: 1rem;
    }
    .pk-specs-note a {
        color: #c09020;
    }
    .pk-product-apps {
        margin-bottom: 1.5rem;
    }
    .pk-product-apps-title {
        font-size: 0.9rem;
        font-weight: 600;
        color: #1e293b;
        margin: 0 0 8px;
    }
    .pk-app-tags {
        margin-bottom: 1rem;
    }
    .pk-app-tag {
        background: #fef3c7;
        color: #92400e;
        font-weight: 500;
        font-size: 0.82rem;
    }
    .pk-spec-table {
        border-collapse: collapse;
        width: 100%;
    }
    .pk-spec-table th,
    .pk-spec-table td {
        text-align: left;
        padding: 10px 14px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.88rem;
    }
    .pk-spec-table th {
        color: #64748b;
        font-weight: 500;
        width: 32%;
        background: #fafafa;
    }
    .pk-spec-table tr:hover {
        background: #fafbfc;
    }

    .pk-surface-intro {
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 1rem;
