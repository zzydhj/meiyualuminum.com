---
/**
 * videos/page/[page].astro — 视频列表第 2~N 页（SSR）
 *
 * - 第 1 页由 videos.astro 渲染（/videos/ 为规范地址），本路由只负责 /videos/page/2/ 起
 * - 页码非法或超出总页数一律 302 回第 1 页：不留空页，也不产生重复内容
 */
import PageHero from "../../../components/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import VideoGrid from "../../../components/VideoGrid.astro";
import VideoFilterBar from "../../../components/VideoFilterBar.astro";
import PaginationNav from "../../../components/PaginationNav.astro";
import { supabase } from "../../../lib/supabase";
import { PAGE_SIZE, resolvePage } from "../../../lib/pagination";

// SSR：视频数一变总页数就得重算，理由同 blog/page/[page].astro。
export const prerender = false;

// 只取总数计算页数，不拉取视频数据
const { count } = await supabase
  .from("videos")
  .select("*", { count: "exact", head: true })
  .eq("status", "published");

const totalPages = Math.ceil((count ?? 0) / PAGE_SIZE);
const currentPage = resolvePage(Astro.params.page, totalPages);

if (currentPage === null) {
  return Astro.redirect("/videos/");
}

// 本页对应的数据切片（.range() 两端含，数据库层分页）
const from = (currentPage - 1) * PAGE_SIZE;
const to = from + PAGE_SIZE - 1;

const result = await supabase
  .from("videos")
  .select(
    "slug, title, video_url, thumbnail_url, description, duration, pub_date, author, primary_tag",
  )
  .eq("status", "published")
  .order("pub_date", { ascending: false })
  .order("slug", { ascending: true })
  .range(from, to);

if (result.error) {
  console.error(
    `Failed to fetch videos for page ${currentPage}:`,
    result.error,
  );
}

const videos = result.data ?? [];
---

<BaseLayout
  pageTitle={`Videos - Page ${currentPage}`}
  description="Watch our factory tours, project cases, installation guides and more."
  hideTitle
>
  <PageHero
    slim
    imageAlt={`Videos - Page ${currentPage}`}
    titleWhite="Videos"
    titleGold={`Page ${currentPage}`}
    crumb={{
      items: [
        { name: "Home", url: "/" },
        { name: "Videos", url: "/videos/" },
        {
          name: `Page ${currentPage}`,
          url: `/videos/page/${currentPage}/`,
        },
      ],
    }}
  />
  <VideoFilterBar />
  <VideoGrid videos={videos} />
  <PaginationNav
    currentPage={currentPage}
    totalPages={totalPages}
    basePath="/videos/page"
    firstPageUrl="/videos/"
  />
</BaseLayout>
