---
import Breadcrumb from "../components/Breadcrumb.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostGrid from "../components/PostGrid.astro";
import PaginationNav from "../components/PaginationNav.astro";
import { supabase } from "../lib/supabase";
import { PAGE_SIZE } from "../lib/pagination";
import { BLOG_LIST_DESCRIPTION } from "../lib/pageCopy";

// SSR：列表数据全部来自 posts 表。转静态的话，发布/下线文章后详情页会立刻变，
// 但本页不会 —— 会出现“文章能直链打开、列表里却找不到”的裂缝。改库即生效。
export const prerender = false;

// 已发布文章总数（轻量 count 查询，不拉取行数据）
const { count } = await supabase
  .from("posts")
  .select("*", { count: "exact", head: true })
  .eq("status", "published");

const totalPages = Math.max(1, Math.ceil((count ?? 0) / PAGE_SIZE));

// 本页只取前 PAGE_SIZE 篇（数据库层分页，不受 Supabase 单次 1000 行上限影响）
// 次级排序 slug：保证 pub_date 相同时跨页顺序稳定，不重不漏
const result = await supabase
  .from("posts")
  .select("slug, title, image_url, description, pub_date, author, primary_tag")
  .eq("status", "published")
  .order("pub_date", { ascending: false })
  .order("slug", { ascending: true })
  .range(0, PAGE_SIZE - 1);

if (result.error) {
  console.error("Failed to fetch posts:", result.error);
}

const posts = result.data ?? [];
const pageTitle = "Blog";
const pageDescription = BLOG_LIST_DESCRIPTION;
---

<BaseLayout pageTitle={pageTitle} description={pageDescription}>
  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Blog", url: "/blog/" },
    ]}
  />
  <PostGrid posts={posts} />
  <PaginationNav currentPage={1} totalPages={totalPages} />
</BaseLayout>
