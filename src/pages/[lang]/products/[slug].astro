---
// [lang]/products/[slug].astro — 多语言产品详情
// 瘦包装：设置 locals.lang 后复用根路由组件，零模板重复。
export const prerender = false;
import Product from "../../products/[slug].astro";
import { isValidLang, DEFAULT_LANG } from "../../../lib/i18n";

Astro.locals.lang = isValidLang(Astro.params.lang)
    ? Astro.params.lang
    : DEFAULT_LANG;
---

<Product />
