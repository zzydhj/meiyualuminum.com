---
/**
 * blog/page/[page].astro — 博客列表第 2~N 页（SSR）
 *
 * - 第 1 页由 blog.astro 渲染（/blog/ 为规范地址），本路由只负责 /blog/page/2/ 起
 * - 页码非法或超出总页数一律 302 回第 1 页：不留空页，也不产生重复内容
 */
import Breadcrumb from "../../../components/Breadcrumb.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostGrid from "../../../components/PostGrid.astro";
import PaginationNav from "../../../components/PaginationNav.astro";
import { supabase } from "../../../lib/supabase";
import { PAGE_SIZE, resolvePage } from "../../../lib/pagination";
import { BLOG_LIST_DESCRIPTION } from "../../../lib/pageCopy";

// SSR：文章总数一变，总页数就得重算。转静态会让第 2 页停在旧文章数上，
// 要么多出一个空页、要么少一页翻不到。
export const prerender = false;

// 只取总数计算页数，不拉取文章数据
const { count } = await supabase
  .from("posts")
  .select("*", { count: "exact", head: true })
  .eq("status", "published");

const totalPages = Math.ceil((count ?? 0) / PAGE_SIZE);
const currentPage = resolvePage(Astro.params.page, totalPages);

if (currentPage === null) {
  return Astro.redirect("/blog/");
}

// 本页对应的数据切片（.range() 两端含，数据库层分页）
const from = (currentPage - 1) * PAGE_SIZE;
const to = from + PAGE_SIZE - 1;

const result = await supabase
  .from("posts")
  .select("slug, title, image_url, description, pub_date, author, primary_tag")
  .eq("status", "published")
  .order("pub_date", { ascending: false })
  .order("slug", { ascending: true })
  .range(from, to);

if (result.error) {
  console.error(`Failed to fetch posts for page ${currentPage}:`, result.error);
}

const posts = result.data ?? [];
---

<BaseLayout
  pageTitle={`Blog - Page ${currentPage}`}
  description={BLOG_LIST_DESCRIPTION}
>
  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Blog", url: "/blog/" },
      {
        name: `Page ${currentPage}`,
        url: `/blog/page/${currentPage}/`,
      },
    ]}
  />
  <PostGrid posts={posts} />
  <PaginationNav currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
