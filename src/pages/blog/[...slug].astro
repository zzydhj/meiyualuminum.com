---
import Breadcrumb from '../../components/Breadcrumb.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: posts } = await supabase
    .from('posts')
    .select('*')
    .eq('status', 'published')

  if (!posts) return []

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Use seo_title/seo_description if available
const pageTitle = post.seo_title || post.title;
const pageDescription = post.seo_description || post.description;
const keywords = post.keywords ?? [];

// BlogPosting JSON-LD
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const articleUrl = `${siteUrl}/blog/${post.slug}/`;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.description,
  "datePublished": post.pub_date || undefined,
  "author": post.author ? { "@type": "Person", "name": post.author } : undefined,
  "image": post.image_url || undefined,
  "url": articleUrl,
  "keywords": post.tags ?? [],
  "publisher": {
    "@type": "Organization",
    "name": "Meiyu Aluminum",
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/favicon.svg` }
  }
};
---

<BaseLayout
  pageTitle={pageTitle}
  description={pageDescription}
  image={post.image_url}
  type="article"
  pubDate={post.pub_date ? new Date(post.pub_date) : undefined}
  author={post.author}
  keywords={keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <Breadcrumb
    root={{ name: "Blog", url: "/blog/" }}
    primaryTag={post.primary_tag
      ? { name: post.primary_tag, url: `/tags/${encodeURIComponent(post.primary_tag)}/` }
      : undefined
    }
    current={post.title}
    currentUrl={`/blog/${post.slug}/`}
  />
  <p>{post.pub_date ? new Date(post.pub_date).toLocaleDateString() : ''}</p>
  <p><em>{post.description}</em></p>
  <p>Author: {post.author}</p>
  {post.image_url && <img src={post.image_url} width="300" height="200" alt={post.image_alt || ''} loading="lazy" />}

  {post.tags && post.tags.length > 0 && (
    <div class="tags">
      {post.tags.map((tag: string) => (
        <p class="tag"><a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a></p>
      ))}
    </div>
  )}

  <div set:html={post.content} />
</BaseLayout>
