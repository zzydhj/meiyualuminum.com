---
import Breadcrumb from '../../components/Breadcrumb.astro';
import RecommendedPosts from '../../components/RecommendedPosts.astro';
import SidebarTags from '../../components/SidebarTags.astro';
import Tag from '../../components/Tag.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  // 路由生成只查 slug：不拉 content 等大字段，
  // 文章上万篇时构建期内存/网络开销不随总量膨胀
  const { data: posts } = await supabase
    .from('posts')
    .select('slug')
    .eq('status', 'published')

  if (!posts) return []

  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

// 当前文章全量数据按需单查：每页只查 1 条，构建成本与文章总数解耦
// 用 .limit(1) 而非 .maybeSingle()：数据库可能存在重复 slug，取其一即可，避免多行报错
const { slug } = Astro.params;
const { data: matches } = await supabase
  .from('posts')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'published')
  .limit(1);

const post = matches?.[0];

if (!post) {
  return Astro.redirect('/blog/');
}

// Use seo_title/seo_description if available
const pageTitle = post.seo_title || post.title;
const pageDescription = post.seo_description || post.description;
const keywords = post.keywords ?? [];

// BlogPosting JSON-LD
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const articleUrl = `${siteUrl}/blog/${post.slug}/`;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.description,
  "datePublished": post.pub_date || undefined,
  "author": post.author ? { "@type": "Person", "name": post.author } : undefined,
  "image": post.image_url || undefined,
  "url": articleUrl,
  "keywords": post.tags ?? [],
  "publisher": {
    "@type": "Organization",
    "name": "Meiyu Aluminum",
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/favicon.svg` }
  }
};
---

<BaseLayout
  pageTitle={pageTitle}
  description={pageDescription}
  image={post.image_url}
  type="article"
  pubDate={post.pub_date ? new Date(post.pub_date) : undefined}
  author={post.author}
  keywords={keywords}
  hideTitle
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <Breadcrumb
    root={{ name: "Blog", url: "/blog/" }}
    primaryTag={post.primary_tag
      ? { name: post.primary_tag, url: `/tags/${encodeURIComponent(post.primary_tag)}/` }
      : undefined
    }
    current={post.title}
    currentUrl={`/blog/${post.slug}/`}
  />

  <div class="blog-layout">
    <!-- 左栏：文章正文（头部结构与视频详情页保持一致） -->
    <article class="blog-article">
      {post.image_url && (
        <div class="post-hero-img">
          <img src={post.image_url} alt={post.image_alt || post.title} loading="lazy" />
        </div>
      )}

      <h1 class="blog-detail-title">{post.title}</h1>

      <div class="blog-detail-meta">
        {post.pub_date && <time datetime={post.pub_date}>{new Date(post.pub_date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time>}
        {post.author && <span>· {post.author}</span>}
      </div>

      {post.tags && post.tags.length > 0 && (
        <div class="blog-detail-tags">
          {post.tags.map((tag: string) => (
            <Tag tag={tag} href={`/tags/${encodeURIComponent(tag)}/`} />
          ))}
        </div>
      )}

      {post.description && <p class="blog-detail-desc"><em>{post.description}</em></p>}

      <div class="article-content" set:html={post.content} />
    </article>

    <!-- 右栏：推荐文章 + 所有标签（两个并列的独立区块） -->
    <div class="blog-sidebar">
      <RecommendedPosts excludeSlug={post.slug} primaryTag={post.primary_tag} />
      <SidebarTags />
    </div>
  </div>
</BaseLayout>

<style>
  /* 两栏布局：文章自适应 + 侧栏固定 320px */
  .blog-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 24px;
    align-items: start;
  }

  /* ===== 文章头部（镜像视频详情页的设计） ===== */
  /* 特色图：16:9 圆角容器，视觉比例与视频播放器一致 */
  .post-hero-img {
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #f3f4f6;
  }
  .post-hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-detail-title {
    margin: 20px 0 8px;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.35;
    color: #0d0950;
  }

  .blog-detail-meta {
    font-size: 0.85rem;
    color: #9ca3af;
    margin-bottom: 14px;
  }

  /* 标签行：可点击，跳转博客标签页（胶囊样式由 Tag.astro 组件提供） */
  .blog-detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .blog-detail-desc {
    margin: 0 0 20px;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #6b7280;
  }

  /* 侧栏滚动跟随（桌面端）；内部多个区块用 flex 列排布，间距由容器统一控制。
     max-height + overflow 是“保险”：侧栏内容超过可用视口高时（笔记本缩放/小屏）
     改为内部滚动，避免底部标签卡被 sticky 切掉而滚不到。 */
  .blog-sidebar {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-height: calc(100vh - 120px); /* 96px 顶偏移 + 24px 底部余量 */
    overflow-y: auto;
    scrollbar-width: thin; /* Firefox 细滚动条 */
    scrollbar-color: #d6d0ca transparent;
  }

  /* 细滚动条（WebKit）：平时不占视觉，hover 变主题色 */
  .blog-sidebar::-webkit-scrollbar {
    width: 6px;
  }
  .blog-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }
  .blog-sidebar::-webkit-scrollbar-thumb {
    background: #d6d0ca;
    border-radius: 3px;
  }
  .blog-sidebar::-webkit-scrollbar-thumb:hover {
    background: #69574a;
  }

  /* 文章内锚点跳转时避开 sticky header */
  .article-content :global([id]) {
    scroll-margin-top: 96px;
  }

  /* 文章 section 内边距：桌面端宽松，手机端收紧。
     文章 HTML 中不需要写 padding，如需单独覆盖可用内联 style。 */
  .article-content :global(section) {
    padding: 48px 44px;
  }

  /* 防止数据库 HTML 中的图片擑破窄栏 */
  .article-content :global(img) {
    max-width: 100%;
    height: auto;
  }

  /* < 1024px：单栏，侧栏落到文章下方 */
  @media screen and (max-width: 1023px) {
    .blog-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .blog-sidebar {
      position: static;
      max-height: none; /* 移动端侧栏在文章下方正常流，不限高、不内部滚动 */
      overflow-y: visible;
    }
    .article-content :global(section) {
      padding: 32px 18px;
    }
  }
</style>
