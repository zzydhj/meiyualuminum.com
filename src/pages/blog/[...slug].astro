---
import Breadcrumb from '../../components/Breadcrumb.astro';

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';  // ← 加这行

import MarkdownPostLayout from '../../layouts/MarkdownPostLayout.astro';


export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post: CollectionEntry<'blog'>) => ({
    params: { slug: post.id }, props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);


---

<MarkdownPostLayout frontmatter={post.data}>
    <Breadcrumb
     root={{ name: "博客", url: "/blog/" }}
     primaryTag={post.data.primaryTag
       ? { name: post.data.primaryTag, url: `/tags/${post.data.primaryTag}/` }
        : undefined
     }
     current={post.data.title}
     currentUrl={`/blog/${post.id}/`}
   />
  <Content />
</MarkdownPostLayout>