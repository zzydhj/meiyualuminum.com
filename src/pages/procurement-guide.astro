---
export const prerender = true;

/**
 * procurement-guide.astro — 采购须知（静态预渲染）
 *
 * 由来：B2B 采购评审（MEIYU_B2B_Procurement_Review_CN.pdf）指出「商务与物流信息不足以算清
 * 这笔生意」与「赔付与补救边界不清楚」两项缺口，并把「两页采购须知」列为优先 3。
 *
 * 事实红线：数字只来自 src/lib/companyProfile.ts（对齐 docs/blog-prompt-v5.md 附录 A）。
 * 附录 A 没有的项（包装尺寸、装柜量、港口、贸易条件、付款节点、索赔运费与人工分摊）
 * 一律不编造，改为在「Where this stands」列明确标注获取时点，让采购知道该追问什么。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import InquiryButton from "../components/InquiryButton.astro";
import {
    companyFacts,
    standardTerms,
    termsNote,
    responseTime,
} from "../lib/companyProfile";

const pageTitle = "Procurement Guide";
const pageDescription =
    "How MEIYU quotes aluminium ceiling and facade orders: MOQ counting basis, lead time milestones, samples, packing and logistics data, trade terms, warranty limits and the claim route — written for procurement teams who need to cost a full system.";

/** 报价单包含 / 不包含 —— 评审要求「让采购知道报价包含什么」 */
const quoteScope = [
    {
        inc: "Line-by-line panel specification",
        detail: "Alloy and temper, gauge, panel or module size, perforation pattern with hole diameter and open area, finish system and colour reference (RAL or NCS).",
    },
    {
        inc: "Unit rate and quantity",
        detail: "Priced per square metre or per panel as appropriate, against a take-off from your drawing — not a lump sum you cannot interrogate.",
    },
    {
        inc: "MOQ per item and per specification",
        detail: "Stated for each line, so a job mixing three colours reads as three lines with three minima rather than one blended figure.",
    },
    {
        inc: "Lead time",
        detail: "For the specification quoted, with the milestone it is counted from written on the offer.",
    },
    {
        inc: "Packing configuration",
        detail: "How the order is crated or bundled, and the panel-to-position labelling applied before it leaves the plant.",
    },
    {
        inc: "What is excluded, named explicitly",
        detail: "Carriers, hangers, perimeter trim, fixings and sealants are shown as supplied or not supplied. A silent omission is how a site discovers a gap at the wrong moment.",
    },
];

/** 采购需要但常被目录略过的数据 —— 附录 A 无 → 只标获取时点，不给数字 */
const logisticsData = [
    {
        item: "Carton, crate and bundle dimensions",
        why: "Determines whether your storage and lifts can take the delivery.",
        status: "Issued with the packing list for your order",
    },
    {
        item: "Net and gross weight per package",
        why: "Needed for freight rating and for floor-loading limits on scaffolds.",
        status: "Issued with the packing list for your order",
    },
    {
        item: "Packed volume and container load",
        why: "The difference between a per-m² price and a real landed cost.",
        status: "Quoted on request with your destination port",
    },
    {
        item: "Port of loading",
        why: "Sets inland freight and transit assumptions.",
        status: "Confirmed on your quotation",
    },
    {
        item: "Trade terms (EXW / FOB / CIF)",
        why: "Decides where our responsibility ends and yours begins.",
        status: "Quoted in the terms you ask us to price against",
    },
    {
        item: "Payment stages",
        why: "Cash-flow planning on your side, tooling and coil purchase on ours.",
        status: "Confirmed on your quotation",
    },
    {
        item: "Reorder and spare-part quantities",
        why: "Site wastage, future extensions and matching a colour batch years later.",
        status: "Discussed at quotation — tell us the reserve you want held",
    },
];

/** 索赔路径 —— 评审要求「说明需要哪些证据、多久回复、运费与人工谁承担」 */
const claimSteps = [
    {
        n: "01",
        t: "Report it",
        d: "Photographs of the affected panels, the barcode positions from the packing list, the quantity concerned, and a note of whether the issue is visible on the face or only in the section.",
    },
    {
        n: "02",
        t: "We trace it",
        d: "Because each panel carries a code tied to its production stage and inspection record, a manufacturing deviation and transit damage separate cleanly — without anyone having to guess or accept blame.",
    },
    {
        n: "03",
        d: "First reply within 1 hour on WhatsApp or email, and a written proposal — replacement, repair or credit — rather than a conversation that goes cold.",
        t: "You get an answer",
    },
    {
        n: "04",
        t: "The boundary is written down",
        d: "The proposal states who carries freight on the replacement consignment and whether demount and reinstatement labour is covered. These terms are issued with your contract, so the limit is known before it is argued about.",
    },
];

/** RFQ 清单 */
const rfqChecklist = [
    "Architectural or reflected ceiling plan, with areas and ceiling heights — or simply a room sketch with dimensions",
    "Product family and the specification you want quoted, or a reference sample / photograph of an existing panel",
    "Finish system and colour reference (RAL or NCS), plus any sheen or texture requirement",
    "Fire classification your project is approved against — ASTM E84 or EN 13501-1 — and any acoustic target with the consultant's comment",
    "Quantity per specification, and the date the first delivery needs to be on site",
    "Destination port and the trade term you want priced",
    "Whether carriers, hangers and perimeter trim should be included or are being bought locally",
];

const faqs = [
    {
        q: "Is MOQ counted per project or per product?",
        a: `Our standard offer is ${standardTerms[0].value}. That means per item and per specification: a job combining two colours of the same panel is two lines. Smaller trial quantities can be discussed at quotation stage.`,
    },
    {
        q: "When does the lead-time clock actually start?",
        a: `An order runs through drawing approval, then sample approval, then production. Your lead time — ${standardTerms[1].value} — is dated from the milestone written on the quotation, not from the day you first emailed us. If a programme depends on a fixed on-site date, say so at enquiry stage and we will work backwards from it.`,
    },
    {
        q: "Can we get samples, and who pays?",
        a: "Yes — colour, perforation and surface finish can be confirmed on physical samples before production starts, and our team matches an RAL reference in-house. Sample and courier arrangements are confirmed when you request them, since they depend on the destination.",
    },
    {
        q: "Do you provide the documents our technical approval needs?",
        a: "Yes: shop drawings, EN 13964 declarations for the configuration quoted, reaction-to-fire data to the standard your project is approved against, and coating QC records from our own lab. Certificate and report numbers go to partners at quotation stage rather than being published on a website. See the evidence index on our About page for what each document does and does not cover.",
    },
];

const faqJsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const waUrl = (msg: string) =>
    `https://wa.me/8613509838008?text=${encodeURIComponent(msg)}`;
---

<BaseLayout pageTitle={pageTitle} description={pageDescription} hideTitle>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <PageHero
        imageAlt={pageTitle}
        titleWhite="Procurement"
        titleGold="Guide"
        subtitle="Everything on this page exists to answer one question: can you cost this order, get it approved internally, and know who is responsible when something is wrong. Figures here are our standard offer; the binding version is the one issued with your quotation."
        stats={[
            {
                value: companyFacts.productionLines,
                label: "Lines — we control the schedule",
            },
            { value: responseTime, label: "First reply, every enquiry" },
        ]}
        crumb={{
            items: [
                { name: "Home", url: "/" },
                { name: "Resources", url: "/installation-guides/" },
                { name: "Procurement Guide", url: "/procurement-guide/" },
            ],
        }}
    />

    <!-- ══════ 1. 标准条款 ══════ -->
    <section class="pg-band">
        <div class="pg-wrap">
            <div class="pg-head">
                <span class="pg-eyebrow">Standard Offer</span>
                <h2 class="pg-h2">
                    Terms We Start <span class="pg-hl">From</span>
                </h2>
                <p class="pg-sub">
                    These are the numbers we publish because they are real and
                    stable. Anything we cannot state honestly is listed further
                    down with the point at which you will get it, instead of a
                    figure invented to fill a box.
                </p>
            </div>
            <div class="pg-terms">
                {
                    standardTerms.map((t) => (
                        <div class="pg-term">
                            <span class="pg-term-label">{t.label}</span>
                            <p class="pg-term-value">{t.value}</p>
                        </div>
                    ))
                }
            </div>
            <p class="pg-note">{termsNote}</p>
        </div>
    </section>

    <!-- ══════ 2. 报价范围 ══════ -->
    <section class="pg-band pg-band--alt">
        <div class="pg-wrap">
            <div class="pg-head">
                <span class="pg-eyebrow">Quotation Scope</span>
                <h2 class="pg-h2">
                    What a MEIYU Quotation <span class="pg-hl">Contains</span>
                </h2>
                <p class="pg-sub">
                    A low unit rate on a panel is easy to compare. A price you
                    can build a budget from is what you actually need — so the
                    exclusions are stated on the face of the document.
                </p>
            </div>
            <ul class="pg-scope">
                {
                    quoteScope.map((r) => (
                        <li class="pg-scope-row">
                            <span class="pg-scope-inc" aria-label="Included">
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M20 6L9 17l-5-5" />
                                </svg>
                            </span>
                            <div>
                                <strong>{r.inc}</strong>
                                <span>{r.detail}</span>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- ══════ 3. 物流与商务数据 ══════ -->
    <section class="pg-band">
        <div class="pg-wrap">
            <div class="pg-head">
                <span class="pg-eyebrow">Landed Cost</span>
                <h2 class="pg-h2">
                    The Data You Need to <span class="pg-hl"
                        >Cost the Whole Order</span
                    >
                </h2>
                <p class="pg-sub">
                    Freight, packaging and terms are where a per-square-metre
                    price stops resembling the number that leaves your bank.
                    Here is each item and when we hand it over.
                </p>
            </div>
            <div class="pg-table-wrap">
                <table class="pg-table">
                    <thead>
                        <tr>
                            <th scope="col">Data point</th>
                            <th scope="col">Why procurement needs it</th>
                            <th scope="col">Where this stands</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            logisticsData.map((d) => (
                                <tr>
                                    <th scope="row" data-label="Data point">
                                        {d.item}
                                    </th>
                                    <td data-label="Why you need it">
                                        {d.why}
                                    </td>
                                    <td data-label="Where this stands">
                                        {d.status}
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
            <p class="pg-note">
                We deliberately do not print packaging or container figures
                here. They change with panel size, finish and stack height, and
                a generic number on a website is worse than no number — it gets
                quoted onward as if it were yours.
            </p>
        </div>
    </section>

    <!-- ══════ 4. 质保与索赔 ══════ -->
    <section class="pg-band pg-band--alt">
        <div class="pg-wrap">
            <div class="pg-head">
                <span class="pg-eyebrow">Warranty &amp; Claims</span>
                <h2 class="pg-h2">
                    When Something Is <span class="pg-hl">Not Right</span>
                </h2>
                <p class="pg-sub">
                    The uncomfortable part of an overseas purchase is not
                    whether a supplier apologises — it is whether the boundary
                    of responsibility was written down before you needed it.
                </p>
            </div>
            <ol class="pg-claims">
                {
                    claimSteps.map((s) => (
                        <li class="pg-claim">
                            <span class="pg-claim-n">{s.n}</span>
                            <div>
                                <strong>{s.t}</strong>
                                <span>{s.d}</span>
                            </div>
                        </li>
                    ))
                }
            </ol>
            <div class="pg-warranty">
                <h3 class="pg-h3">What the warranty actually covers</h3>
                <ul>
                    <li>
                        <strong>Coating — 10 years PE, 15 years PVDF</strong>,
                        under standard atmospheric exposure. Coastal and
                        high-salt sites may need a different coating
                        specification, and we will say so rather than let a
                        standard system fail there.
                    </li>
                    <li>
                        <strong>Material and workmanship — 1 year</strong> from the
                        date of shipment.
                    </li>
                    <li>
                        <strong
                            >Within stated limits and subject to site
                            conditions.</strong
                        >{" "}
                        Installation practice, exposure and cleaning regime all affect
                        service life, so these are coverage terms, not a blanket promise.
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- ══════ 5. RFQ 清单 + CTA ══════ -->
    <section class="pg-band">
        <div class="pg-wrap">
            <div class="pg-head">
                <span class="pg-eyebrow">Request for Quotation</span>
                <h2 class="pg-h2">
                    Send Us This and We Can <span class="pg-hl"
                        >Price It Properly</span
                    >
                </h2>
            </div>
            <ul class="pg-rfq">
                {rfqChecklist.map((item) => <li>{item}</li>)}
            </ul>
            <p class="pg-missing">
                Missing half of that is normal at an early stage. A room size
                and a photograph of a panel you like is enough to start — the
                point of this list is that you know what a comparable, costable
                quotation needs, from us or from anyone else.
            </p>
            <div class="pg-cta-row">
                <InquiryButton label="Send an Enquiry" />
                <a
                    class="pg-cta-btn"
                    href={waUrl(
                        "Hi MEIYU, I have read your procurement guide and want to discuss an order",
                    )}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-wa-source="procurement_guide">Chat on WhatsApp</a
                >
                <a class="pg-cta-link" href="/about/#evidence"
                    >See the evidence index →</a
                >
            </div>
        </div>
    </section>

    <!-- ══════ 6. FAQ ══════ -->
    <section class="pg-band pg-band--alt">
        <div class="pg-wrap">
            <div class="pg-head">
                <span class="pg-eyebrow">FAQ</span>
                <h2 class="pg-h2">
                    Procurement Questions <span class="pg-hl">We Get Asked</span
                    >
                </h2>
            </div>
            <div class="pg-faq">
                {
                    faqs.map((f) => (
                        <details class="pg-faq-item">
                            <summary>{f.q}</summary>
                            <p>{f.a}</p>
                        </details>
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* About / 安装指南同源自包含约定：全站无全局 design tokens，本块统一 pg- 前缀 */
    .pg-band {
        padding: clamp(48px, 7vw, 84px) clamp(16px, 5vw, 40px);
    }
    .pg-band--alt {
        background: #f8f6f3;
    }
    .pg-wrap {
        max-width: 1120px;
        margin: 0 auto;
    }
    .pg-head {
        max-width: 760px;
        margin: 0 0 clamp(24px, 3.4vw, 36px);
    }
    .pg-eyebrow {
        display: inline-block;
        margin-bottom: 0.6rem;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #c09020;
    }
    .pg-h2 {
        margin: 0 0 0.9rem;
        font-size: clamp(1.5rem, 3.2vw, 2.15rem);
        line-height: 1.28;
        color: #1e293b;
    }
    .pg-h3 {
        margin: 0 0 0.8rem;
        font-size: 1.1rem;
        color: #1e293b;
    }
    .pg-hl {
        color: #69574a;
    }
    .pg-sub {
        margin: 0;
        font-size: 1rem;
        line-height: 1.85;
        color: #475569;
    }
    .pg-note {
        margin: clamp(18px, 2.6vw, 26px) 0 0;
        font-size: 0.88rem;
        line-height: 1.75;
        color: #64748b;
        font-style: italic;
    }

    /* 标准条款 */
    .pg-terms {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: clamp(12px, 1.8vw, 18px);
    }
    .pg-term {
        padding: 1.15rem 1.3rem;
        background: #fff;
        border: 1px solid #e8e4df;
        border-left: 3px solid #c09020;
        border-radius: 0 10px 10px 0;
    }
    .pg-term-label {
        display: block;
        margin-bottom: 0.35rem;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #c09020;
    }
    .pg-term-value {
        margin: 0;
        font-size: 0.93rem;
        line-height: 1.7;
        color: #334155;
    }

    /* 报价范围 */
    .pg-scope {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 10px;
    }
    .pg-scope-row {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 1rem 1.15rem;
        background: #fff;
        border: 1px solid #e8e4df;
        border-radius: 10px;
    }
    .pg-scope-inc {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        margin-top: 2px;
        border-radius: 50%;
        background: #eef7f0;
        border: 1px solid #b7ebc8;
        color: #2d7a4f;
    }
    .pg-scope-inc svg {
        width: 15px;
        height: 15px;
    }
    .pg-scope-row strong {
        display: block;
        font-size: 0.95rem;
        color: #1e293b;
    }
    .pg-scope-row span:not(.pg-scope-inc) {
        display: block;
        margin-top: 3px;
        font-size: 0.88rem;
        line-height: 1.7;
        color: #475569;
    }

    /* 物流表 */
    .pg-table-wrap {
        margin: clamp(20px, 3vw, 30px) 0 0;
        overflow-x: auto;
        background: #fff;
        border: 1px solid #e8e4df;
        border-radius: 12px;
    }
    .pg-table {
        width: 100%;
        min-width: 760px;
        border-collapse: collapse;
        text-align: left;
    }
    .pg-table thead th {
        padding: 14px 16px;
        background: #f5f0eb;
        border-bottom: 1px solid #e2d6c8;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #69574a;
        white-space: nowrap;
    }
    .pg-table tbody th,
    .pg-table tbody td {
        padding: 13px 16px;
        border-bottom: 1px solid #f1ede8;
        font-size: 0.88rem;
        line-height: 1.65;
        color: #475569;
        font-weight: 400;
        vertical-align: top;
    }
    .pg-table tbody th {
        width: 27%;
        font-weight: 700;
        color: #1e293b;
    }
    .pg-table tbody tr:last-child th,
    .pg-table tbody tr:last-child td {
        border-bottom: 0;
    }
    .pg-table tbody tr:nth-child(even) {
        background: #faf8f6;
    }

    /* 索赔四步 */
    .pg-claims {
        list-style: none;
        margin: 0 0 clamp(22px, 3vw, 30px);
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: clamp(12px, 1.8vw, 18px);
    }
    .pg-claim {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 1.15rem 1.25rem;
        background: #fff;
        border: 1px solid #e8e4df;
        border-radius: 10px;
    }
    .pg-claim-n {
        flex-shrink: 0;
        font-size: 1.35rem;
        font-weight: 800;
        line-height: 1;
        color: #d8c9ae;
    }
    .pg-claim strong {
        display: block;
        margin-bottom: 4px;
        font-size: 0.97rem;
        color: #1e293b;
    }
    .pg-claim span:not(.pg-claim-n) {
        display: block;
        font-size: 0.88rem;
        line-height: 1.7;
        color: #475569;
    }
    .pg-warranty {
        padding: clamp(20px, 3vw, 28px);
        background: #fff;
        border: 1px solid #e8e4df;
        border-radius: 12px;
    }
    .pg-warranty ul {
        margin: 0;
        padding-left: 1.15rem;
    }
    .pg-warranty li {
        margin-bottom: 8px;
        font-size: 0.9rem;
        line-height: 1.75;
        color: #475569;
    }
    .pg-warranty strong {
        color: #334155;
    }

    /* RFQ */
    .pg-rfq {
        margin: 0 0 clamp(18px, 2.6vw, 24px);
        padding-left: 1.2rem;
        display: grid;
        gap: 8px;
    }
    .pg-rfq li {
        font-size: 0.93rem;
        line-height: 1.7;
        color: #475569;
    }
    .pg-rfq li::marker {
        color: #c09020;
        font-weight: 700;
    }
    .pg-missing {
        margin: 0;
        padding: 1rem 1.2rem;
        background: #faf6f3;
        border-left: 4px solid #c09020;
        border-radius: 0 8px 8px 0;
        font-size: 0.9rem;
        line-height: 1.75;
        color: #475569;
    }
    .pg-cta-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
        margin-top: clamp(22px, 3vw, 30px);
    }
    .pg-cta-btn {
        display: inline-flex;
        align-items: center;
        padding: 0.72rem 1.5rem;
        border: 2px solid #69574a;
        border-radius: 999px;
        background: transparent;
        color: #69574a;
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        transition:
            background-color 0.2s,
            color 0.2s;
    }
    .pg-cta-btn:hover {
        background: #69574a;
        color: #fff;
    }
    .pg-cta-link {
        font-size: 0.9rem;
        font-weight: 600;
        color: #c09020;
        text-decoration: none;
    }
    .pg-cta-link:hover {
        text-decoration: underline;
    }

    /* FAQ */
    .pg-faq {
        max-width: 820px;
        display: grid;
        gap: 0.75rem;
    }
    .pg-faq-item {
        background: #fff;
        border: 1px solid #e8e4df;
        border-radius: 10px;
        overflow: hidden;
        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }
