---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import InquiryButton from "../components/InquiryButton.astro";
import { productKnowledge } from "../lib/productKnowledge";

const pageTitle = "Installation Guides & Technical Resources";
const pageDescription =
    "Step-by-step installation guides for aluminum ceiling systems, facade panels, baffle ceilings, and skirting boards. Technical drawings, CAD files, and installation tips from MEIYU engineering team.";
---

<BaseLayout pageTitle={pageTitle} description={pageDescription}>
    <Breadcrumb
        items={[
            { name: "Home", url: "/" },
            { name: "Resources", url: "#" },
            { name: "Installation Guides", url: "/installation-guides/" },
        ]}
    />

    <div class="ig-intro">
        <p>
            Proper installation is essential for the long-term performance and
            appearance of aluminum building products. Our installation guides
            provide step-by-step instructions, best practices, and technical
            tips from our engineering team. Each guide covers the specific
            installation requirements for that product category.
        </p>
    </div>

    <!-- ══════ PRODUCT CATEGORY CARDS ══════ -->
    <section class="ig-categories">
        <h2>Installation Guides by Product Category</h2>
        <div class="ig-grid">
            {
                Object.values(productKnowledge).map((pk) => (
                    <div class="ig-card">
                        <div class="ig-card-head">
                            <h3>{pk.categoryName}</h3>
                            <span class="ig-steps-count">
                                {pk.installationSteps.length} Steps
                            </span>
                        </div>
                        <p class="ig-card-overview">
                            {pk.overview.substring(0, 150)}...
                        </p>

                        <div class="ig-card-steps">
                            {pk.installationSteps.slice(0, 3).map((s) => (
                                <div class="ig-mini-step">
                                    <span class="ig-mini-num">{s.step}</span>
                                    <span>{s.title}</span>
                                </div>
                            ))}
                            {pk.installationSteps.length > 3 && (
                                <span class="ig-more">
                                    +{pk.installationSteps.length - 3} more
                                    steps
                                </span>
                            )}
                        </div>

                        <div class="ig-card-footer">
                            <a
                                href={`/categories/${pk.categorySlug}/`}
                                class="ig-view-products"
                            >
                                View Products →
                            </a>
                            {pk.installationTips.length > 0 && (
                                <span class="ig-tips-count">
                                    {pk.installationTips.length} pro tips
                                </span>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- ══════ GENERAL BEST PRACTICES ══════ -->
    <section class="ig-best-practices">
        <h2>General Installation Best Practices</h2>
        <div class="ig-bp-grid">
            <div class="ig-bp-card">
                <div class="ig-bp-icon">📐</div>
                <h4>Pre-Installation Planning</h4>
                <ul>
                    <li>
                        Review all shop drawings before starting installation
                    </li>
                    <li>
                        Verify substrate condition: flat, clean, structurally
                        sound
                    </li>
                    <li>
                        Check panel quantities, colors, and finishes against the
                        order
                    </li>
                    <li>
                        Plan installation sequence to minimize on-site cutting
                    </li>
                    <li>
                        Coordinate with other trades (MEP, fire protection,
                        lighting)
                    </li>
                </ul>
            </div>
            <div class="ig-bp-card">
                <div class="ig-bp-icon">🔧</div>
                <h4>Tools & Equipment</h4>
                <ul>
                    <li>Use carbide-tipped blades for all aluminum cutting</li>
                    <li>
                        Nylon or rubber-tipped tools to prevent surface
                        scratching
                    </li>
                    <li>Laser level for accurate alignment (±1mm tolerance)</li>
                    <li>Suction cups for handling large panels</li>
                    <li>Torque wrench for calibrated bolt tightening</li>
                </ul>
            </div>
            <div class="ig-bp-card">
                <div class="ig-bp-icon">🌡️</div>
                <h4>Thermal Expansion</h4>
                <ul>
                    <li>
                        Aluminum expands 2.4mm per meter per 100°C temperature
                        change
                    </li>
                    <li>Always allow 3–5mm expansion gaps between panels</li>
                    <li>
                        Install panels at mid-range temperature when possible
                    </li>
                    <li>Use slotted holes at one end of fixed connections</li>
                    <li>
                        Never install panels fully constrained — allow movement
                    </li>
                </ul>
            </div>
            <div class="ig-bp-card">
                <div class="ig-bp-icon">🛡️</div>
                <h4>Surface Protection</h4>
                <ul>
                    <li>Leave PE protective film on until final handover</li>
                    <li>
                        Remove film within 30 days of installation (UV
                        degradation)
                    </li>
                    <li>
                        Do not use alkaline or abrasive cleaners on coated
                        surfaces
                    </li>
                    <li>Clean with mild detergent and soft cloth only</li>
                    <li>
                        Protect installed panels from welding spark and concrete
                        splatter
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- ══════ DOWNLOADS ══════ -->
    <section class="ig-downloads">
        <h2>Technical Downloads</h2>
        <div class="ig-dl-grid">
            <div class="ig-dl-card">
                <svg
                    viewBox="0 0 24 24"
                    width="32"
                    height="32"
                    fill="none"
                    stroke="#c09020"
                    stroke-width="1.5"
                    ><rect x="3" y="3" width="18" height="18" rx="2"
                    ></rect><path d="M9 9h6M9 13h6M9 17h4"></path></svg
                >
                <h4>Installation Manuals</h4>
                <p>
                    Comprehensive PDF installation manuals for each product
                    category.
                </p>
                <a href="#" class="ig-dl-link">Request Manual →</a>
            </div>
            <div class="ig-dl-card">
                <svg
                    viewBox="0 0 24 24"
                    width="32"
                    height="32"
                    fill="none"
                    stroke="#c09020"
                    stroke-width="1.5"
                    ><path
                        d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"
                    ></path><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"
                    ></path></svg
                >
                <h4>CAD Drawings (DWG)</h4>
                <p>Standard installation detail drawings in AutoCAD format.</p>
                <a href="#" class="ig-dl-link">Browse CAD Files →</a>
            </div>
            <div class="ig-dl-card">
                <svg
                    viewBox="0 0 24 24"
                    width="32"
                    height="32"
                    fill="none"
                    stroke="#c09020"
                    stroke-width="1.5"
                    ><path
                        d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"
                    ></path></svg
                >
                <h4>BIM Models (Revit)</h4>
                <p>Revit families for our ceiling and facade systems.</p>
                <a href="#" class="ig-dl-link">Browse BIM Files →</a>
            </div>
            <div class="ig-dl-card">
                <svg
                    viewBox="0 0 24 24"
                    width="32"
                    height="32"
                    fill="none"
                    stroke="#c09020"
                    stroke-width="1.5"
                    ><path d="M23 12a11.05 11.05 0 00-22 0"></path><path
                        d="M12 12v7a2 2 0 004 0v-7"></path><circle
                        cx="12"
                        cy="12"
                        r="3"></circle></svg
                >
                <h4>Video Tutorials</h4>
                <p>
                    Step-by-step video installation guides on our YouTube
                    channel.
                </p>
                <a href="/videos/" class="ig-dl-link">Watch Videos →</a>
            </div>
        </div>
    </section>

    <!-- ══════ SUPPORT CTA ══════ -->
    <section class="ig-support">
        <h2>Need On-Site Technical Support?</h2>
        <p>
            Our engineering team provides pre-installation consultation, on-site
            technical guidance, and post-installation inspection services.
            Contact us to discuss your project installation requirements.
        </p>
        <div class="ig-support-btns">
            <InquiryButton
                label="Request Technical Support"
                class="ig-cta-btn"
            />
            <a href="/contact/" class="ig-cta-outline"
                >Contact Engineering Team</a
            >
        </div>
    </section>
</BaseLayout>

<style>
    .ig-intro {
        max-width: 800px;
        margin-bottom: 2rem;
    }
    .ig-intro p {
        font-size: 0.95rem;
        color: #475569;
        line-height: 1.8;
    }

    /* Category cards */
    .ig-categories {
        margin-bottom: 3rem;
    }
    .ig-categories h2 {
        font-size: 1.5rem;
        margin: 0 0 1.25rem;
    }
    .ig-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 16px;
    }
    .ig-card {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
        background: #fff;
        transition:
            box-shadow 0.2s,
            border-color 0.2s;
        display: flex;
        flex-direction: column;
    }
    .ig-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        border-color: #c09020;
    }
    .ig-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    .ig-card-head h3 {
        margin: 0;
        font-size: 1.05rem;
        color: #1e293b;
    }
    .ig-steps-count {
        font-size: 0.7rem;
        font-weight: 600;
        color: #c09020;
        background: #fefce8;
        padding: 3px 8px;
        border-radius: 4px;
        white-space: nowrap;
    }
    .ig-card-overview {
        font-size: 0.85rem;
        color: #64748b;
        line-height: 1.6;
        margin: 0 0 12px;
        flex: 1;
    }

    .ig-card-steps {
        margin-bottom: 12px;
    }
    .ig-mini-step {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
    }
    .ig-mini-num {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #f0f4f8;
        color: #64748b;
        font-size: 0.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .ig-mini-step span:last-child {
        font-size: 0.82rem;
        color: #334155;
    }
    .ig-more {
        font-size: 0.78rem;
        color: #94a3b8;
        padding-left: 30px;
    }

    .ig-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 10px;
        border-top: 1px solid #f1f5f9;
    }
    .ig-view-products {
        font-size: 0.85rem;
        font-weight: 600;
        color: #c09020;
        text-decoration: none;
    }
    .ig-view-products:hover {
        text-decoration: underline;
    }
    .ig-tips-count {
        font-size: 0.75rem;
        color: #94a3b8;
    }

    /* Best practices */
    .ig-best-practices {
        margin-bottom: 3rem;
    }
    .ig-best-practices h2 {
        font-size: 1.5rem;
        margin: 0 0 1.25rem;
    }
    .ig-bp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
    }
    .ig-bp-card {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
        background: #fff;
    }
    .ig-bp-icon {
        font-size: 1.8rem;
        margin-bottom: 10px;
    }
    .ig-bp-card h4 {
        margin: 0 0 10px;
        font-size: 1rem;
        color: #1e293b;
    }
    .ig-bp-card ul {
        margin: 0;
        padding: 0 0 0 16px;
    }
    .ig-bp-card li {
        font-size: 0.85rem;
        color: #475569;
        margin-bottom: 4px;
        line-height: 1.5;
    }

    /* Downloads */
    .ig-downloads {
        margin-bottom: 3rem;
    }
    .ig-downloads h2 {
        font-size: 1.5rem;
        margin: 0 0 1.25rem;
    }
    .ig-dl-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
    }
    .ig-dl-card {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 24px 20px;
        text-align: center;
        background: #fff;
    }
    .ig-dl-card svg {
        margin-bottom: 12px;
    }
    .ig-dl-card h4 {
        margin: 0 0 8px;
        font-size: 0.95rem;
        color: #1e293b;
    }
    .ig-dl-card p {
        font-size: 0.82rem;
        color: #64748b;
        margin: 0 0 12px;
        line-height: 1.5;
    }
    .ig-dl-link {
        font-size: 0.85rem;
        font-weight: 600;
        color: #c09020;
        text-decoration: none;
    }
    .ig-dl-link:hover {
        text-decoration: underline;
    }

    /* Support CTA */
    .ig-support {
        text-align: center;
        padding: 3rem 2rem;
        background: #f8f6f3;
        border-radius: 12px;
        margin: 2rem 0;
    }
    .ig-support h2 {
        margin: 0 0 0.5rem;
        font-size: 1.5rem;
        color: #1e293b;
    }
    .ig-support p {
        font-size: 0.95rem;
        color: #64748b;
        max-width: 600px;
        margin: 0 auto 1.5rem;
        line-height: 1.6;
    }
    .ig-support-btns {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }
    .ig-support-btns :global(.ig-cta-btn) {
        background-color: #69574a !important;
        padding: 0.75rem 2rem !important;
        font-size: 1rem !important;
    }
    .ig-cta-outline {
        display: inline-flex;
        align-items: center;
        padding: 0.65rem 2rem;
        border: 2px solid #69574a;
        border-radius: 999px;
        color: #69574a;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 700;
        transition: all 0.2s;
    }
    .ig-cta-outline:hover {
        background: #69574a;
        color: #fff;
    }
</style>
