---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import InquiryButton from "../components/InquiryButton.astro";
import { productKnowledge } from "../lib/productKnowledge";
import {
    interactiveGuides,
    guideForCategory,
    guidePath,
    guideStepHref,
} from "../lib/interactiveGuides";

// BaseLayout 会拼成 `{pageTitle} | MEIYU`（后缀 8 字），所以这里 ≤ 52 字；description ≤ 160。
// 标题里带 Aluminium：后缀缩短后它不再供材质词，这一页本来一个材质词都没有。
const pageTitle = "Aluminium Installation Guides & Technical Resources";
const pageDescription =
    "Step-by-step installation guides for aluminium ceilings, baffles, facade panels and skirting — setting-out, carrier fixing and levelling details.";
---

<BaseLayout pageTitle={pageTitle} description={pageDescription} hideTitle>
    <PageHero
        imageAlt={pageTitle}
        titleWhite="Installation"
        titleGold="Guides"
        subtitle="Proper installation is essential for the long-term performance and appearance of aluminum building products. Our installation guides provide step-by-step instructions, best practices, and technical tips from our engineering team. Each guide covers the specific installation requirements for that product category."
        stats={[
            {
                value: String(Object.values(productKnowledge).length),
                label: "Product Categories Covered",
            },
        ]}
        crumb={{
            items: [
                { name: "Home", url: "/" },
                { name: "Resources", url: "#" },
                { name: "Installation Guides", url: "/installation-guides/" },
            ],
        }}
    />

    <!-- ══════ PRODUCT CATEGORY CARDS ══════ -->
    <section class="ig-categories" id="categories">
        <h2>Installation Guides by Product Category</h2>
        {
            interactiveGuides.length > 0 && (
                <div class="ig-3d-banner">
                    <svg
                        viewBox="0 0 24 24"
                        width="34"
                        height="34"
                        fill="none"
                        stroke="#c09020"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M12 2.6 21 7v10l-9 4.4L3 17V7z" />
                        <path d="M3 7l9 4.4L21 7M12 21.4V11.4" />
                    </svg>
                    <p>
                        <b>
                            {interactiveGuides.length} of these categories also
                            carry an interactive 3D build-up.
                        </b>{" "}
                        Rotate the assembly, explode it, or jump straight to one
                        operation. The model is generated in code from section
                        geometry — a typical build-up drawn to scale, not a
                        photograph of a completed project.
                    </p>
                    <a href="/interactive-guides/">See the 3D guides →</a>
                </div>
            )
        }
        <div class="ig-grid">
            {
                Object.values(productKnowledge).map((pk) => {
                    const g = guideForCategory(pk.categorySlug);
                    return (
                        <div class="ig-card">
                            <div class="ig-card-head">
                                <h3>{pk.categoryName}</h3>
                                <span class="ig-head-meta">
                                    {g && (
                                        <a
                                            class="ig-3d-badge"
                                            href={guidePath(g.slug)}
                                            title={`Interactive 3D build-up — ${g.stepCount} sequenced steps`}
                                        >
                                            3D
                                        </a>
                                    )}
                                    <span class="ig-steps-count">
                                        {pk.installationSteps.length} Steps
                                    </span>
                                </span>
                            </div>
                            <p class="ig-card-overview">
                                {pk.overview.substring(0, 150)}...
                            </p>

                            <div class="ig-card-steps">
                                {pk.installationSteps.slice(0, 3).map((s) => {
                                    const href = g
                                        ? guideStepHref(g, s.step)
                                        : null;
                                    return (
                                        <div class="ig-mini-step">
                                            <span class="ig-mini-num">
                                                {s.step}
                                            </span>
                                            {href ? (
                                                <a
                                                    class="ig-mini-link"
                                                    href={href}
                                                    title="Open this operation in the 3D build-up"
                                                >
                                                    {s.title}
                                                </a>
                                            ) : (
                                                <span>{s.title}</span>
                                            )}
                                        </div>
                                    );
                                })}
                                {pk.installationSteps.length > 3 && (
                                    <span class="ig-more">
                                        +{pk.installationSteps.length - 3} more
                                        steps
                                    </span>
                                )}
                            </div>

                            <div class="ig-card-footer">
                                <a
                                    href={`/categories/${pk.categorySlug}/`}
                                    class="ig-view-products"
                                >
                                    View Products →
                                </a>
                                <span class="ig-foot-right">
                                    {pk.installationTips.length > 0 && (
                                        <span class="ig-tips-count">
                                            {pk.installationTips.length} pro
                                            tips
                                        </span>
                                    )}
                                    {g && (
                                        <a
                                            class="ig-3d-link"
                                            href={guidePath(g.slug)}
                                        >
                                            3D build-up →
                                        </a>
                                    )}
                                </span>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </section>

    <!-- ══════ GENERAL BEST PRACTICES ══════ -->
    <section class="ig-best-practices">
        <h2>General Installation Best Practices</h2>
        <div class="ig-bp-grid">
            <div class="ig-bp-card">
                <div class="ig-bp-icon">📐</div>
                <h4>Pre-Installation Planning</h4>
                <ul>
                    <li>
                        Review all shop drawings before starting installation
                    </li>
                    <li>
                        Verify substrate condition: flat, clean, structurally
                        sound
                    </li>
                    <li>
                        Check panel quantities, colors, and finishes against the
                        order
                    </li>
                    <li>
                        Plan installation sequence to minimize on-site cutting
                    </li>
                    <li>
                        Coordinate with other trades (MEP, fire protection,
                        lighting)
                    </li>
                </ul>
            </div>
            <div class="ig-bp-card">
                <div class="ig-bp-icon">🔧</div>
                <h4>Tools & Equipment</h4>
                <ul>
                    <li>Use carbide-tipped blades for all aluminum cutting</li>
                    <li>
                        Nylon or rubber-tipped tools to prevent surface
                        scratching
                    </li>
                    <li>Laser level for accurate alignment (±1mm tolerance)</li>
                    <li>Suction cups for handling large panels</li>
                    <li>Torque wrench for calibrated bolt tightening</li>
                </ul>
            </div>
            <div class="ig-bp-card">
                <div class="ig-bp-icon">🌡️</div>
                <h4>Thermal Expansion</h4>
                <ul>
                    <li>
                        Aluminum expands 2.4mm per meter per 100°C temperature
                        change
                    </li>
                    <li>Always allow 3–5mm expansion gaps between panels</li>
                    <li>
                        Install panels at mid-range temperature when possible
                    </li>
                    <li>Use slotted holes at one end of fixed connections</li>
                    <li>
                        Never install panels fully constrained — allow movement
                    </li>
                </ul>
            </div>
            <div class="ig-bp-card">
                <div class="ig-bp-icon">🛡️</div>
                <h4>Surface Protection</h4>
                <ul>
                    <li>Leave PE protective film on until final handover</li>
                    <li>
                        Remove film within 30 days of installation (UV
                        degradation)
                    </li>
                    <li>
                        Do not use alkaline or abrasive cleaners on coated
                        surfaces
                    </li>
                    <li>Clean with mild detergent and soft cloth only</li>
                    <li>
                        Protect installed panels from welding spark and concrete
                        splatter
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- ══════ DOCUMENTS ══════只列真实给得出的东西（原 Manual/CAD/BIM 三张卡都是 href="#" 空链接，BIM 我们根本没有 → 已删）-->
    <section class="ig-downloads">
        <h2>Documents &amp; Support Material</h2>
        <div class="ig-dl-grid">
            <div class="ig-dl-card">
                <svg
                    viewBox="0 0 24 24"
                    width="32"
                    height="32"
                    fill="none"
                    stroke="#c09020"
                    stroke-width="1.5"
                    ><path
                        d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"
                    ></path></svg
                >
                <h4>On-Page Step Guides</h4>
                <p>
                    Each product category above carries its own step-by-step
                    fixing sequence and installation tips.
                </p>
                <a href="#categories" class="ig-dl-link">Jump to the guides →</a
                >
            </div>
            <div class="ig-dl-card">
                <svg
                    viewBox="0 0 24 24"
                    width="32"
                    height="32"
                    fill="none"
                    stroke="#c09020"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M12 2.6 21 7v10l-9 4.4L3 17V7z"></path><path
                        d="M3 7l9 4.4L21 7M12 21.4V11.4"></path></svg
                >
                <h4>Interactive 3D Build-Up</h4>
                <p>
                    Where a system has one, the whole assembly can be rotated,
                    exploded and stepped through to scale.
                </p>
                <a href="/interactive-guides/" class="ig-dl-link"
                    >Open the 3D guides →</a
                >
            </div>
            <div class="ig-dl-card">
                <svg
                    viewBox="0 0 24 24"
                    width="32"
                    height="32"
                    fill="none"
                    stroke="#c09020"
                    stroke-width="1.5"
                    ><path
                        d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"
                    ></path><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"
                    ></path></svg
                >
                <h4>Shop Drawings &amp; Edge Details</h4>
                <p>
                    Carrier sections, perimeter and expansion details are drawn
                    per project — send your drawings and we mark them up.
                </p>
                <button type="button" class="ig-dl-link" data-open-inquiry-modal
                    >Request a Set →</button
                >
            </div>
            <div class="ig-dl-card">
                <svg
                    viewBox="0 0 24 24"
                    width="32"
                    height="32"
                    fill="none"
                    stroke="#c09020"
                    stroke-width="1.5"
                    ><path d="M23 12a11.05 11.05 0 00-22 0"></path><path
                        d="M12 12v7a2 2 0 004 0v-7"></path><circle
                        cx="12"
                        cy="12"
                        r="3"></circle></svg
                >
                <h4>Video Tutorials</h4>
                <p>
                    Installation and product walkthroughs from our video
                    library.
                </p>
                <a href="/videos/" class="ig-dl-link">Watch Videos →</a>
            </div>
        </div>
        <p class="ig-dl-note">
            Print-ready PDF copies of any guide are issued together with your
            quotation.
        </p>
    </section>

    <!-- ══════ SUPPORT CTA ══════ -->
    <section class="ig-support">
        <h2>Need On-Site Technical Support?</h2>
        <p>
            Our engineering team provides pre-installation consultation, on-site
            technical guidance, and post-installation inspection services.
            Contact us to discuss your project installation requirements.
        </p>
        <div class="ig-support-btns">
            <InquiryButton
                label="Request Technical Support"
                class="ig-cta-btn"
            />
            <a href="/contact/" class="ig-cta-outline"
                >Contact Engineering Team</a
            >
        </div>
    </section>
</BaseLayout>

<style>
    .ig-intro {
        max-width: 800px;
        margin-bottom: 2rem;
    }
    .ig-intro p {
        font-size: 0.95rem;
        color: #475569;
        line-height: 1.8;
    }

    /* Category cards */
    .ig-categories {
        margin-bottom: 3rem;
    }
    .ig-categories h2 {
        font-size: 1.5rem;
        margin: 0 0 1.25rem;
    }
    .ig-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 16px;
    }
    .ig-card {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
        background: #fff;
        transition:
            box-shadow 0.2s,
            border-color 0.2s;
        display: flex;
        flex-direction: column;
    }
    .ig-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        border-color: #c09020;
    }
    .ig-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    .ig-card-head h3 {
        margin: 0;
        font-size: 1.05rem;
        color: #1e293b;
    }
    .ig-steps-count {
        font-size: 0.7rem;
        font-weight: 600;
        color: #c09020;
        background: #fefce8;
        padding: 3px 8px;
        border-radius: 4px;
        white-space: nowrap;
    }
    /* 有 3D 装配模型的品类：标题行多一枚徽标，步骤行变成深链 */
    .ig-head-meta {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .ig-3d-badge {
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        color: #fff;
        background: #69574a;
        padding: 3px 7px;
        border-radius: 4px;
        text-decoration: none;
        white-space: nowrap;
    }
    .ig-3d-badge:hover {
        background: #c09020;
    }
    .ig-foot-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .ig-3d-link {
        font-size: 0.75rem;
        font-weight: 600;
        color: #69574a;
        text-decoration: none;
        white-space: nowrap;
    }
    .ig-3d-link:hover {
        color: #c09020;
        text-decoration: underline;
    }
    .ig-3d-banner {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 0 0 18px;
        padding: 15px 20px;
        background: #faf8f6;
        border: 1px solid #e2d6c8;
        border-left: 4px solid #c09020;
        border-radius: 0 10px 10px 0;
    }
    .ig-3d-banner p {
        margin: 0;
        flex: 1;
        font-size: 0.88rem;
        line-height: 1.7;
        color: #475569;
    }
    .ig-3d-banner b {
        color: #334155;
    }
    .ig-3d-banner a {
        font-size: 0.85rem;
        font-weight: 700;
        color: #c09020;
        text-decoration: none;
        white-space: nowrap;
    }
    .ig-3d-banner a:hover {
        text-decoration: underline;
    }
    @media (max-width: 640px) {
        .ig-3d-banner {
            flex-wrap: wrap;
        }
        .ig-3d-banner svg {
            display: none;
        }
    }
    .ig-card-overview {
        font-size: 0.85rem;
        color: #64748b;
        line-height: 1.6;
        margin: 0 0 12px;
        flex: 1;
    }

    .ig-card-steps {
        margin-bottom: 12px;
    }
    .ig-mini-step {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
    }
    .ig-mini-num {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #f0f4f8;
        color: #64748b;
        font-size: 0.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .ig-mini-step span:last-child {
        font-size: 0.82rem;
        color: #334155;
    }
    .ig-mini-link {
        font-size: 0.82rem;
        color: #334155;
        text-decoration: none;
        border-bottom: 1px dashed #c0a882;
    }
    .ig-mini-link:hover {
        color: #c09020;
        border-bottom-color: #c09020;
    }
    .ig-more {
        font-size: 0.78rem;
        color: #94a3b8;
        padding-left: 30px;
    }

    .ig-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 10px;
        border-top: 1px solid #f1f5f9;
    }
    .ig-view-products {
        font-size: 0.85rem;
        font-weight: 600;
        color: #c09020;
        text-decoration: none;
    }
    .ig-view-products:hover {
        text-decoration: underline;
    }
    .ig-tips-count {
        font-size: 0.75rem;
        color: #94a3b8;
    }

    /* Best practices */
    .ig-best-practices {
        margin-bottom: 3rem;
    }
    .ig-best-practices h2 {
        font-size: 1.5rem;
        margin: 0 0 1.25rem;
    }
    .ig-bp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
    }
    .ig-bp-card {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
        background: #fff;
    }
    .ig-bp-icon {
        font-size: 1.8rem;
        margin-bottom: 10px;
    }
    .ig-bp-card h4 {
        margin: 0 0 10px;
        font-size: 1rem;
        color: #1e293b;
    }
    .ig-bp-card ul {
        margin: 0;
        padding: 0 0 0 16px;
    }
    .ig-bp-card li {
        font-size: 0.85rem;
        color: #475569;
        margin-bottom: 4px;
        line-height: 1.5;
    }

    /* Downloads */
    .ig-downloads {
        margin-bottom: 3rem;
    }
    .ig-downloads h2 {
        font-size: 1.5rem;
        margin: 0 0 1.25rem;
    }
    .ig-dl-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
    }
    .ig-dl-card {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 24px 20px;
        text-align: center;
        background: #fff;
    }
    .ig-dl-card svg {
        margin-bottom: 12px;
    }
    .ig-dl-card h4 {
        margin: 0 0 8px;
        font-size: 0.95rem;
        color: #1e293b;
    }
    .ig-dl-card p {
        font-size: 0.82rem;
        color: #64748b;
        margin: 0 0 12px;
        line-height: 1.5;
    }
    .ig-dl-link {
        font-size: 0.85rem;
        font-weight: 600;
        color: #c09020;
        text-decoration: none;
    }
    .ig-dl-link:hover {
        text-decoration: underline;
    }
    /* 同一个类也用于打开询盘弹窗的 <button>，重置默认按钮外观 */
    button.ig-dl-link {
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        cursor: pointer;
    }
    .ig-categories {
        scroll-margin-top: 90px;
    }
    .ig-dl-note {
        margin: 18px 0 0;
        text-align: center;
        font-size: 0.84rem;
        color: #64748b;
    }

    /* Support CTA */
    .ig-support {
        text-align: center;
        padding: 3rem 2rem;
        background: #f8f6f3;
        border-radius: 12px;
        margin: 2rem 0;
    }
    .ig-support h2 {
        margin: 0 0 0.5rem;
        font-size: 1.5rem;
        color: #1e293b;
    }
    .ig-support p {
        font-size: 0.95rem;
        color: #64748b;
        max-width: 600px;
        margin: 0 auto 1.5rem;
        line-height: 1.6;
    }
    .ig-support-btns {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }
    .ig-support-btns :global(.ig-cta-btn) {
        background-color: #69574a !important;
        padding: 0.75rem 2rem !important;
        font-size: 1rem !important;
    }
    .ig-cta-outline {
        display: inline-flex;
        align-items: center;
        padding: 0.65rem 2rem;
        border: 2px solid #69574a;
        border-radius: 999px;
        color: #69574a;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 700;
        transition: all 0.2s;
    }
    .ig-cta-outline:hover {
        background: #69574a;
        color: #fff;
    }
</style>
