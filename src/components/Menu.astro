<button aria-expanded="false" aria-controls="mobile-menu" class="menu" aria-label="Open menu">
  <span class="menu-line"></span>
  <span class="menu-line"></span>
  <span class="menu-line"></span>
</button>

<style>
  .menu {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 40px;
    height: 40px;
    background-color: #69574a;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    padding: 0;
  }

  .menu-line {
    display: block;
    width: 18px;
    height: 2px;
    background-color: #fff;
    border-radius: 1px;
  }

  /* Desktop: hamburger button is hidden, nav shows inline */
  @media screen and (min-width: 1400px) {
    .menu {
      display: none;
    }
  }
</style>