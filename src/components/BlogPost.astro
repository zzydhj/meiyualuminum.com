---
/**
 * BlogPost.astro — 文章卡片（单篇文章的展示组件）
 *
 * - 只负责单张卡片的渲染与样式，布局（宫格）由 PostGrid.astro 控制
 * - 卡片结构：缩略图 → 标签 → 标题 → 摘要 → 日期/作者
 */
import Tag from './Tag.astro';

interface Props {
  post: {
    slug: string;
    title: string;
    image_url?: string | null;
    description?: string | null;
    pub_date?: string | null;
    author?: string | null;
    primary_tag?: string | null;
  };
}

const { post } = Astro.props;

const dateStr = post.pub_date
  ? new Date(post.pub_date).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";
---

<li class="post-card">
  <a href={`/blog/${post.slug}/`} class="post-card-link">
    <div class="post-thumb">
      {
        post.image_url ? (
          <img
            src={post.image_url}
            alt={post.title}
            loading="lazy"
            onerror="this.remove()"
          />
        ) : (
          <div class="post-thumb-fallback" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="40"
              height="40"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="16" y1="13" x2="8" y2="13" />
              <line x1="16" y1="17" x2="8" y2="17" />
            </svg>
          </div>
        )
      }
    </div>
    <div class="post-body">
      {post.primary_tag && (
        <div class="post-tag-row">
          <Tag tag={post.primary_tag} />
        </div>
      )}
      <h2 class="post-title">{post.title}</h2>
      {post.description && <p class="post-excerpt">{post.description}</p>}
      <div class="post-meta">
        {dateStr && <time datetime={post.pub_date}>{dateStr}</time>}
        {post.author && <span>· {post.author}</span>}
      </div>
    </div>
  </a>
</li>

<style>
  .post-card {
    list-style: none;
  }

  .post-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid #e8e4df;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .post-card-link:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(105, 87, 74, 0.14);
  }

  /* 缩略图区域：固定 16:10 比例，无图时显示占位底色 */
  .post-thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f0ede9;
  }
  .post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .post-card-link:hover .post-thumb img {
    transform: scale(1.05);
  }
  .post-thumb-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #c9c2ba;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px 20px 20px;
  }

  /* 标签行：间距由容器控制，胶囊本体样式在 Tag.astro */
  .post-tag-row {
    margin-bottom: 10px;
  }

  .post-title {
    margin: 0 0 8px;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    color: #0d0950;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s;
  }
  .post-card-link:hover .post-title {
    color: #69574a;
  }

  .post-excerpt {
    margin: 0 0 14px;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #6b7280;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* margin-top:auto 让日期始终贴卡片底部，卡片等高对齐 */
  .post-meta {
    margin-top: auto;
    font-size: 0.78rem;
    color: #9ca3af;
  }
</style>