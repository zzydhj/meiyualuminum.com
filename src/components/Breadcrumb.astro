---
/**
 * Breadcrumb.astro
 * Breadcrumb navigation: outputs visible nav + JSON-LD structured data.
 *
 * Usage 1: Pass a full items array (for simple/fixed pages)
 *   <Breadcrumb items={[
 *     { name: "Home", url: "/" },
 *     { name: "About", url: "/about/" },
 *   ]} />
 *
 * Usage 2: Structured data with auto-assembly (supports multi-level middle items)
 *   <Breadcrumb
 *     root={{ name: "Products", url: "/products/" }}
 *     middleItems={[
 *       { name: "Brake System", url: "/categories/brake-system/" },
 *       { name: "Brake Pads", url: "/categories/brake-pads/" },
 *     ]}
 *     current="Product Name"
 *     currentUrl="/products/product-slug/"
 *   />
 *   Result: Home > Products > Brake System > Brake Pads > Product Name
 *
 * Backward compatible: primaryTag still works as a single middle item.
 */

interface BreadcrumbItem {
  name: string;
  /** 省略或空串 = 这一级只是分组标签、没有对应页面（如 Resources）。
      以前调用方用 url: "#" 占位，结果是面包屑里出现死链（Lighthouse 计入
      「无法抓取的链接」），而且同一个 # 会被写进 JSON-LD 的 item，
      new URL("#", site) 算出自指 fragment。现在不链接就干脆不给 url。 */
  url?: string;
}

interface Props {
  // Usage 1: pass a full array directly
  items?: BreadcrumbItem[];

  // Usage 2: structured data, component auto-assembles the chain
  root?: BreadcrumbItem;
  primaryTag?: BreadcrumbItem; // legacy: single middle item
  middleItems?: BreadcrumbItem[]; // new: multiple middle items (for category chains)
  current?: string;
  currentUrl?: string;

  // Visual variant: "default" = light left-aligned; "hero" = centered light-on-dark
  // (for PageHero). JSON-LD output is identical for both variants.
  variant?: "default" | "hero";
}

const {
  items,
  root,
  primaryTag,
  middleItems,
  current,
  currentUrl,
  variant = "default",
} = Astro.props;

// Usage 1: use the provided items array directly
// Usage 2: auto-assemble: Home > root > middleItems (or primaryTag) > current
const resolvedItems: BreadcrumbItem[] = items ?? [
  { name: "Home", url: "/" },
  ...(root ? [root] : []),
  ...(middleItems ? middleItems : []),
  ...(primaryTag ? [primaryTag] : []),
  ...(current && currentUrl ? [{ name: current, url: currentUrl }] : []),
];

// JSON-LD 只收有真实目标的那几级，并重排 position：BreadcrumbList 要求除最后
// 一项外每项都有可用 item，一条指不到任何页面的 crumb 应该整条不报。
const jsonLdItems = resolvedItems
  .filter((item) => item.url)
  .map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: new URL(item.url as string, Astro.site).href,
  }));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: jsonLdItems,
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<nav
  aria-label="Breadcrumb"
  class:list={["breadcrumb", { hero: variant === "hero" }]}
>
  <ol>
    {
      resolvedItems.map((item, index) => {
        const isLast = index === resolvedItems.length - 1;
        return (
          <li>
            {isLast ? (
              <span aria-current="page">{item.name}</span>
            ) : item.url ? (
              <a href={item.url}>{item.name}</a>
            ) : (
              /* 分组标签：不是链接就不装成链接（Lighthouse 对无 href 和
                 href="#" 的 <a> 都记一条） */
              <span class="crumb-static">{item.name}</span>
            )}
            {!isLast && (
              <span class="separator" aria-hidden="true">
                /
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1rem;
    color: #666;
  }

  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .breadcrumb a {
    color: #0053a0;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb [aria-current="page"] {
    color: #333;
    font-weight: 600;
  }

  /* 分组标签（无 url 的中间级）：跟普通 crumb 同色但不蓝不带下划线 */
  .breadcrumb .crumb-static {
    color: #666;
  }

  .breadcrumb .separator {
    color: #999;
    user-select: none;
  }

  /* hero 变体：置于 PageHero 暗色背景上，居中、浅色、金色链接。
     仅视觉差异；JSON-LD 与 default 变体完全一致。 */
  .breadcrumb.hero {
    margin-bottom: 0;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .breadcrumb.hero ol {
    justify-content: center;
  }

  .breadcrumb.hero a {
    color: #f0c96a;
  }

  .breadcrumb.hero a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .breadcrumb.hero [aria-current="page"] {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
  }

  .breadcrumb.hero .crumb-static {
    color: rgba(255, 255, 255, 0.72);
  }

  .breadcrumb.hero .separator {
    color: rgba(255, 255, 255, 0.45);
  }
</style>
