---
/**
 * Breadcrumb.astro
 * Breadcrumb navigation: outputs visible nav + JSON-LD structured data.
 *
 * Usage 1: Pass a full items array (for simple/fixed pages)
 *   <Breadcrumb items={[
 *     { name: "Home", url: "/" },
 *     { name: "About", url: "/about/" },
 *   ]} />
 *
 * Usage 2: Structured data with auto-assembly (supports multi-level middle items)
 *   <Breadcrumb
 *     root={{ name: "Products", url: "/products/" }}
 *     middleItems={[
 *       { name: "Brake System", url: "/categories/brake-system/" },
 *       { name: "Brake Pads", url: "/categories/brake-pads/" },
 *     ]}
 *     current="Product Name"
 *     currentUrl="/products/product-slug/"
 *   />
 *   Result: Home > Products > Brake System > Brake Pads > Product Name
 *
 * Backward compatible: primaryTag still works as a single middle item.
 */

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  // Usage 1: pass a full array directly
  items?: BreadcrumbItem[];

  // Usage 2: structured data, component auto-assembles the chain
  root?: BreadcrumbItem;
  primaryTag?: BreadcrumbItem;    // legacy: single middle item
  middleItems?: BreadcrumbItem[]; // new: multiple middle items (for category chains)
  current?: string;
  currentUrl?: string;
}

const { items, root, primaryTag, middleItems, current, currentUrl } = Astro.props;

// Usage 1: use the provided items array directly
// Usage 2: auto-assemble: Home > root > middleItems (or primaryTag) > current
const resolvedItems: BreadcrumbItem[] = items ?? [
  { name: "Home", url: "/" },
  ...(root        ? [root]                                                       : []),
  ...(middleItems ? middleItems                                                  : []),
  ...(primaryTag  ? [primaryTag]                                                 : []),
  ...(current && currentUrl ? [{ name: current, url: currentUrl }]               : []),
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": resolvedItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": new URL(item.url, Astro.site).href,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<nav aria-label="Breadcrumb" class="breadcrumb">
  <ol>
    {resolvedItems.map((item, index) => {
      const isLast = index === resolvedItems.length - 1;
      return (
        <li>
          {isLast ? (
            <span aria-current="page">{item.name}</span>
          ) : (
            <a href={item.url}>{item.name}</a>
          )}
          {!isLast && <span class="separator" aria-hidden="true">/</span>}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1rem;
    color: #666;
  }

  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .breadcrumb a {
    color: #0053a0;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb [aria-current="page"] {
    color: #333;
    font-weight: 600;
  }

  .breadcrumb .separator {
    color: #999;
    user-select: none;
  }
</style>
