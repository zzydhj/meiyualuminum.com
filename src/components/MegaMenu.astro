<div class="mega-panel">
  <div class="mega-inner">
    <div class="mega-header">
      <span class="mega-header-label">Our Product Lines</span>
    </div>

    <div class="mega-body">
      <!-- 左：竖排菜单 -->
      <nav class="mega-nav" aria-label="Product lines">
        {
          MENU.map((m, i) => (
            <button
              class:list={["mega-nav-item", { active: i === 0 }]}
              data-pane={i}
              aria-controls={`mega-pane-${i}`}
              aria-expanded={i === 0 ? "true" : "false"}
            >
              <span>{m.label}</span>
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          ))
        }
      </nav>

      <!-- 右：每个菜单项对应一个卡片面板 -->
      <div class="mega-content">
        {
          MENU.map((m, i) => (
            <div class="mega-pane" id={`mega-pane-${i}`} hidden={i !== 0}>
              <div class="mega-grid">
                {m.cards.map((c, j) => (
                  <a href={c.href} class="mega-card" style={`--i:${j}`}>
                    <img src={c.img} alt={c.title} loading="lazy" />
                    <div class="mega-card-overlay" />
                    <div class="mega-card-content">
                      <span class="mega-card-title">{c.title}</span>
                    </div>
                    <span class="mega-card-accent" />
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  // 左菜单悬停/点击/聚焦 → 切换右侧面板
  const panel = document.querySelector(".mega-panel");
  if (panel) {
    const items = Array.from(
      panel.querySelectorAll<HTMLButtonElement>(".mega-nav-item"),
    );
    const panes = Array.from(panel.querySelectorAll<HTMLElement>(".mega-pane"));
    const activate = (idx: number) => {
      items.forEach((el, i) => {
        el.classList.toggle("active", i === idx);
        el.setAttribute("aria-expanded", String(i === idx));
      });
      panes.forEach((p, i) => {
        p.hidden = i !== idx;
      });
    };
    items.forEach((el, i) => {
      el.addEventListener("mouseenter", () => activate(i));
      el.addEventListener("focus", () => activate(i));
      el.addEventListener("click", (e) => {
        e.preventDefault();
        activate(i);
      });
    });
    activate(0);
  }
</script>

<style>
  .mega-panel {
    --brand-gold: #c0a882;
    --brand-gold-bright: #f0c96a;
    --panel-bg: #110e0b;

    box-sizing: border-box;
    display: none;
    flex-direction: column;
    background: var(--panel-bg);
    border-top: 2px solid var(--brand-gold-bright);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
  }
  .mega-panel *,
  .mega-panel *::before,
  .mega-panel *::after {
    box-sizing: inherit;
  }

  @media screen and (min-width: 1280px) {
    .mega-panel {
      display: flex;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: 100%;
      padding: 32px 0 40px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      /* 关闭：鼠标滑离立即隐藏浮窗（毫秒级），不留延迟宽限期；打开仍由 hover 态的 0.25s 淡入 */
      transition:
        opacity 0s,
        visibility 0s;
      z-index: 999;
    }

    :global(.has-mega:hover) .mega-panel,
    :global(.has-mega:focus-within) .mega-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition:
        opacity 0.25s ease 0s,
        visibility 0.25s ease 0s;
    }
  }

  /* 内容限宽居中：与页头/页面 1400px 栅格对齐（背景仍全宽） */
  .mega-inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Header label */
  .mega-header {
    margin-bottom: 16px;
    padding-left: 4px;
  }
  .mega-header-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--brand-gold);
    opacity: 0.85;
  }

  /* ===== 双栏：左菜单 + 右面板 ===== */
  .mega-body {
    display: flex;
    gap: 28px;
    flex: 1;
    min-height: 0;
  }

  /* 左：竖排菜单 */
  .mega-nav {
    width: 280px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid rgba(240, 201, 106, 0.16);
    padding-right: 4px;
  }
  .mega-nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    /* 均分撑满左栏全高，底部不留空白 */
    flex: 1 1 0;
    min-height: 44px;
    padding: 10px 14px;
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: #cfc8bd;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
    text-align: left;
    cursor: pointer;
    transition:
      color 0.2s,
      background 0.2s,
      border-color 0.2s;
  }
  .mega-nav-item svg {
    opacity: 0.45;
    flex-shrink: 0;
    transition:
      transform 0.2s,
      opacity 0.2s;
  }
  .mega-nav-item:hover {
    color: #fff;
    background: rgba(240, 201, 106, 0.06);
  }
  .mega-nav-item.active {
    color: #fff;
    border-left-color: var(--brand-gold-bright);
    background: rgba(240, 201, 106, 0.1);
  }
  .mega-nav-item.active svg {
    opacity: 0.9;
    transform: translateX(2px);
  }

  /* 右：面板容器 */
  .mega-content {
    flex: 1;
    min-width: 0;
  }
  .mega-pane[hidden] {
    display: none;
  }

  /* 4x2 Grid */
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 22px;
  }

  /* Card */
  .mega-card {
    position: relative;
    display: block;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    aspect-ratio: 1 / 1;
    opacity: 0;
    transform: translateY(8px) scale(0.97);
    transition:
      opacity 0.35s ease calc(var(--i) * 0.04s + 0.05s),
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)
        calc(var(--i) * 0.04s + 0.05s);
  }

  :global(.has-mega:hover) .mega-card,
  :global(.has-mega:focus-within) .mega-card {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .mega-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .mega-card:hover img {
    transform: scale(1.08);
  }

  /* Gradient overlay */
  .mega-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 8, 5, 0.86) 0%,
      rgba(10, 8, 5, 0.42) 30%,
      rgba(10, 8, 5, 0) 62%
    );
    transition: background 0.3s ease;
  }

  .mega-card:hover .mega-card-overlay {
    background: linear-gradient(
      to top,
      rgba(10, 8, 5, 0.9) 0%,
      rgba(10, 8, 5, 0.34) 34%,
      rgba(10, 8, 5, 0) 66%
    );
  }

  /* Content */
  .mega-card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    z-index: 1;
  }

  .mega-card-title {
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.2px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .mega-card:hover .mega-card-title {
    transform: translateY(-2px);
  }

  /* Gold accent line on hover */
  .mega-card-accent {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--brand-gold-bright),
      var(--brand-gold)
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
    z-index: 2;
  }

  .mega-card:hover .mega-card-accent {
    transform: scaleX(1);
  }
</style>
