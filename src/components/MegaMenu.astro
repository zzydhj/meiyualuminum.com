---
/**
 * MegaMenu.astro — Products mega dropdown (desktop only, >= 1280px)
 *
 * 双栏结构：左侧竖排菜单（悬停/点击切换）+ 右侧 4x2 大图卡面板。
 * 右侧卡片沿用原有风格：满幅图 + 渐变遮罩 + 标题（整卡可点，无额外 CTA）。
 *
 * ★ 分类结构（依《产品分类与工程支持规划报告》2026-10-14）：
 *   左列 = 4 条一级工程产品线（Aluminum Ceilings / Interior Wall Panels /
 *   Facade & Exterior Cladding / Skirting & Trims），右侧卡片 = 该线下的
 *   二级系列或形态，全部链向现有分类/产品页。调整时保持「一级=产品线、
 *   卡片=系列」两级语义，不要改回按形态与话术混排的旧 6 组。
 *   - label      : 左侧菜单项文字
 *   - cards[]    : 该项对应的右侧卡片（img / title / href）
 * 面板开合仍由 Navigation.astro 的 .has-mega 悬停控制（纯 CSS）。
 */

// ★ 内容替换规则：
//   每张卡的 img / title / href 都是真实写出的字符串，直接改对应行即可，
//   不要改回 Array.from / 索引自动增序的写法。
//   最大组（Aluminum Ceilings）6 张卡，4 列网格折 2 行。
/**
 * 一张产品卡。
 * href 省略或写 "#" 表示这个产品还**没有页面**：渲染成不可点的 “Coming soon” 灰卡。
 * 以前这些卡写的是 href="#"，看起来是链接、点下去只把页面滚到顶部 ——
 * 对买家是“这站没建完”，对 Google 是每个页面都自指一次。
 * 以后给某个产品建好页，把 "#" 换成真路径即可，卡片自动恢复可点。
 */
interface MegaCardItem {
  img: string;
  title: string;
  href?: string;
}

interface MegaGroup {
  label: string;
  cards: MegaCardItem[];
}

const MENU: MegaGroup[] = [
  // 一级 = 工程产品线（客户经营范围/工程部位），卡片 = 二级系列（报告 §04 菜单表口径）。
  // 顺序按报告：天花吊顶 → 室内墙面 → 外墙覆面 → 踢脚与收边。
  // 2026-10-26 与用户 18 系列口径表对齐：6+5+4+3 = 18 张卡全部指向真实
  // 分类/产品页，不出现空的 “Coming soon” 类别；新建的 4 个系列页
  // （perforated / honeycomb-wall / insulated / trim）内容待后续逐个深化。
  {
    label: "Aluminum Ceilings",
    cards: [
      {
        img: "https://file.meiyualuminum.com/home/general/aluminum-clip-in-ceiling.webp",
        title: "Clip-In & Lay-In Ceiling Tiles",
        href: "/categories/aluminum-ceiling-tile/",
      },
      {
        // 报告 §05：方通及挂片是一个二级系列，截面（U 型/方管/圆管/水滴/波浪）是它的三级型号，
        // 不拆卡。链向 2026-10-25 分类树重构建好的 baffle-blade-ceilings 聚合页（含全部 6 个产品）。
        img: "https://file.meiyualuminum.com/home/general/u-type-baffle-ceiling.webp",
        title: "Baffle & Blade Ceilings",
        href: "/categories/baffle-blade-ceilings/",
      },
      {
        img: "https://file.meiyualuminum.com/home/aluminum-strip-ceiling/luxury-interior-aluminium-strip-ceiling-living-room-design.webp",
        title: "Linear Strip Ceilings",
        href: "/products/aluminum-strip-ceiling/",
      },
      {
        img: "https://file.meiyualuminum.com/home/general/aluminum-open-cell-ceiling.webp",
        title: "Open Cell Ceilings",
        href: "/categories/open-cell-ceiling/",
      },
      {
        img: "https://file.meiyualuminum.com/home/general/aluminum-mesh-ceiling.webp",
        title: "Mesh Ceilings",
        href: "/categories/aluminum-mesh-ceiling/",
      },
      {
        img: "https://file.meiyualuminum.com/home/general/ceiling-aluminum-honeycomb.webp",
        title: "Honeycomb Ceiling Panels",
        href: "/categories/aluminum-honeycomb-ceiling/",
      },
    ],
  },
  {
    label: "Interior Wall Panels",
    cards: [
      {
        // 报告 §07：通用墙板页作墙面选型总览（同一货物不重复建入口）。
        img: "https://file.meiyualuminum.com/home/aluminum-ceiling-project/white-curved-aluminum-panel-ceiling-tree-column-airport-transit-hub.webp",
        title: "Solid Aluminum Wall Panels",
        href: "/categories/aluminum-wall-panels/",
      },
      {
        img: "https://file.meiyualuminum.com/home/aluminum-fluted-panel/aluminium-batten-feature-wall-backlit-landscape-projection-interior.webp",
        title: "Fluted Wall Panels",
        href: "/products/interior-fluted-wall-panel/",
      },
      {
        img: "https://file.meiyualuminum.com/home/general/acoustic-aluminum-panels.webp",
        title: "Perforated Aluminum Panels",
        href: "/products/perforated-aluminum-panel/",
      },
      {
        // 2026-10-26 口径表把异形铝单板列在室内墙面列（原挂在外墙列），移回。
        img: "https://file.meiyualuminum.com/home/aluminum-ceiling-project/beijing-daxing-airport-terminal-tree-column-curved-aluminum-ceiling-interior.webp",
        title: "Curved & Custom Aluminum Panels",
        href: "/products/curved-aluminum-veneer-panel/",
      },
      {
        img: "https://file.meiyualuminum.com/home/general/aluminum-honeycomb-panel.webp",
        title: "Honeycomb Wall Panels",
        href: "/products/honeycomb-wall-panel/",
      },
    ],
  },
  {
    label: "Facade & Exterior Cladding",
    cards: [
      {
        // 卡图换实心单板实拍：原穿孔幕墙照片让给室内列的穿孔卡，避免图不对题。
        img: "https://file.meiyualuminum.com/home/mega-menu/aluminum-veneer.webp",
        title: "Solid Aluminum Cladding",
        href: "/categories/aluminum-veneer/",
      },
      {
        img: "https://file.meiyualuminum.com/home/mega-menu/aluminum-honeycomb-core-panel.webp",
        title: "Honeycomb Cladding Panels",
        href: "/categories/aluminum-honeycomb-core-panel/",
      },
      {
        img: "https://file.meiyualuminum.com/home/aluminum-fluted-panel/exterior-aluminium-batten-facade-cladding-commercial-building.webp",
        title: "Fluted Cladding Panels",
        href: "/products/exterior-fluted-facade-panel/",
      },
      {
        // 占位渲染图（renders/ 命名空间）：保温板暂无实拍，有素材后替换。
        img: "https://file.meiyualuminum.com/renders/insulated-facade-panel/panel-section-mineral-core-b53778.webp",
        title: "Insulated Facade Panels",
        href: "/products/insulated-facade-panel/",
      },
    ],
  },
  {
    label: "Skirting & Trims",
    cards: [
      {
        img: "https://file.meiyualuminum.com/home/general/aluminum-skirting-board.webp",
        title: "Surface-Mount Skirting",
        href: "/products/surface-mount-aluminum-skirting/",
      },
      {
        // 占位图：LED 踢脚截面最接近嵌入式形态，有实拍素材后替换。
        img: "https://file.meiyualuminum.com/home/general/led-aluminum-skirting-board.webp",
        title: "Recessed Skirting",
        href: "/products/recessed-aluminum-skirting/",
      },
      {
        img: "https://file.meiyualuminum.com/home/general/aluminum-edge-trim-strip.webp",
        title: "Trim & Closing Profiles",
        href: "/products/aluminum-trim-profiles/",
      },
    ],
  },
];
---

<div class="mega-panel">
  <div class="mega-inner">
    <div class="mega-header">
      <span class="mega-header-label">Our Product Lines</span>
    </div>

    <div class="mega-body">
      {/* 左：竖排菜单 */}
      <nav class="mega-nav" aria-label="Product lines">
        {
          MENU.map((m, i) => (
            <button
              class:list={["mega-nav-item", { active: i === 0 }]}
              data-pane={i}
              aria-controls={`mega-pane-${i}`}
              aria-expanded={i === 0 ? "true" : "false"}
            >
              <span>{m.label}</span>
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          ))
        }
      </nav>

      {/* 右：每个菜单项对应一个卡片面板 */}
      <div class="mega-content">
        {
          MENU.map((m, i) => (
            <div class="mega-pane" id={`mega-pane-${i}`} hidden={i !== 0}>
              <div class="mega-grid">
                {m.cards.map((c, j) => {
                  // 没有真实目标就不给 href：<a> 不带 href 时浏览器不把它当链接、
                  // 也不可聚焦，比 href="#" 诚实；同时不用拆两套 markup，
                  // 避开 scoped 样式跟不到新组件的坑。
                  const soon = !c.href || c.href === "#";
                  return (
                    <a
                      href={soon ? undefined : c.href}
                      class:list={["mega-card", { "mega-card--soon": soon }]}
                      style={`--i:${j}`}
                      aria-disabled={soon ? "true" : undefined}
                      tabindex={soon ? "-1" : undefined}
                    >
                      <img src={c.img} alt={c.title} loading="lazy" />
                      <div class="mega-card-overlay" />
                      <div class="mega-card-content">
                        <span class="mega-card-title">{c.title}</span>
                        {soon && (
                          <span class="mega-card-badge">Coming soon</span>
                        )}
                      </div>
                      <span class="mega-card-accent" />
                    </a>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  // 左菜单悬停/点击/聚焦 → 切换右侧面板
  const panel = document.querySelector(".mega-panel");
  if (panel) {
    const items = Array.from(
      panel.querySelectorAll<HTMLButtonElement>(".mega-nav-item"),
    );
    const panes = Array.from(panel.querySelectorAll<HTMLElement>(".mega-pane"));
    const content = panel.querySelector<HTMLElement>(".mega-content");
    let current = 0;
    const activate = (idx: number) => {
      current = idx;
      items.forEach((el, i) => {
        el.classList.toggle("active", i === idx);
        el.setAttribute("aria-expanded", String(i === idx));
      });
      panes.forEach((p, i) => {
        p.hidden = i !== idx;
      });
    };
    items.forEach((el, i) => {
      el.addEventListener("mouseenter", () => activate(i));
      el.addEventListener("focus", () => activate(i));
      el.addEventListener("click", (e) => {
        e.preventDefault();
        activate(i);
      });
    });
    activate(0);

    // 面板高度稳定（2026-10-25）：行数随卡数自动后，多卡组与 1 行卡组的外框高度
    // 会随切组变化而上下跳。这里把 .mega-content 的 min-height 锁到最高一组
    // （临时展开全部 pane 量一次），短组由 .mega-content 的 flex 居中在框内垂直居中：
    // 切组时外框纹丝不动。卡片高度由 aspect-ratio（宽驱动）决定，
    // 不依赖图片加载，测量时机安全。
    const syncPanelHeight = () => {
      if (!content) return;
      content.style.minHeight = "0px"; // 先清旧值，避免残留高度干扰测量
      panes.forEach((p) => {
        p.hidden = false;
      });
      // 用 getBoundingClientRect（带小数）+ ceil：offsetHeight 会向下取整，
      // 非整数行高时锁定的 min-height 比真实最高组矮零点几 px，切组仍有亚像素抖动。
      const max = Math.ceil(
        Math.max(0, ...panes.map((p) => p.getBoundingClientRect().height)),
      );
      panes.forEach((p, i) => {
        p.hidden = i !== current;
      });
      content.style.minHeight = max ? max + "px" : "";
    };
    syncPanelHeight();
    let pending = 0;
    window.addEventListener("resize", () => {
      if (pending) return;
      pending = requestAnimationFrame(() => {
        pending = 0;
        syncPanelHeight();
      });
    });
  }
</script>

<style>
  .mega-panel {
    --brand-gold: #c0a882;
    --brand-gold-bright: #f0c96a;
    --panel-bg: #110e0b;

    box-sizing: border-box;
    display: none;
    flex-direction: column;
    background: var(--panel-bg);
    border-top: 2px solid var(--brand-gold-bright);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
  }
  .mega-panel *,
  .mega-panel *::before,
  .mega-panel *::after {
    box-sizing: inherit;
  }

  @media screen and (min-width: 1280px) {
    .mega-panel {
      display: flex;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: 100%;
      padding: 32px 0 40px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      /* 关闭：鼠标滑离立即隐藏浮窗（毫秒级），不留延迟宽限期；打开仍由 hover 态的 0.25s 淡入 */
      transition:
        opacity 0s,
        visibility 0s;
      z-index: 999;
    }

    :global(.has-mega:hover) .mega-panel,
    :global(.has-mega:focus-within) .mega-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition:
        opacity 0.25s ease 0s,
        visibility 0.25s ease 0s;
    }
  }

  /* 内容限宽居中：与页头/页面 1400px 栅格对齐（背景仍全宽） */
  .mega-inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Header label */
  .mega-header {
    margin-bottom: 16px;
    padding-left: 4px;
  }
  .mega-header-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--brand-gold);
    opacity: 0.85;
  }

  /* ===== 双栏：左菜单 + 右面板 ===== */
  .mega-body {
    display: flex;
    gap: 28px;
    flex: 1;
    min-height: 0;
  }

  /* 左：竖排菜单 */
  .mega-nav {
    width: 280px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid rgba(240, 201, 106, 0.16);
    padding-right: 4px;
  }
  .mega-nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    /* 均分撑满左栏全高，底部不留空白 */
    flex: 1 1 0;
    min-height: 44px;
    padding: 10px 14px;
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: #cfc8bd;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
    text-align: left;
    cursor: pointer;
    transition:
      color 0.2s,
      background 0.2s,
      border-color 0.2s;
  }
  .mega-nav-item svg {
    opacity: 0.45;
    flex-shrink: 0;
    transition:
      transform 0.2s,
      opacity 0.2s;
  }
  .mega-nav-item:hover {
    color: #fff;
    background: rgba(240, 201, 106, 0.06);
  }
  .mega-nav-item.active {
    color: #fff;
    border-left-color: var(--brand-gold-bright);
    background: rgba(240, 201, 106, 0.1);
  }
  .mega-nav-item.active svg {
    opacity: 0.9;
    transform: translateX(2px);
  }

  /* 右：面板容器。flex 列 + justify-center：JS 把 min-height 锁到最高一组后，
     少卡组的可见 pane 在框内垂直居中（切组外框不动，卡片上下浮动）。 */
  .mega-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .mega-pane[hidden] {
    display: none;
  }

  /* 4 列网格：行数随卡数自动（最大组 6 卡折 2 行）；面板外框高度不随组变化，
     由脚本锁到最高一组 + 短组居中（见上方 <script> syncPanelHeight）。
     不要改回 repeat(2, 1fr)：那会给少卡组留空白轨道。 */
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  /* Card */
  /* 还没有页面的产品卡：保留图与标题（它们本身有展示价值），
     但去颜 + 压暗 + 禁用 hover 位移，让它在视觉上就读作“不能点”。 */
  .mega-card--soon {
    cursor: default;
    filter: saturate(0.25) brightness(0.72);
  }

  .mega-card--soon:hover {
    transform: none;
  }

  .mega-card--soon:hover .mega-card-accent {
    transform: scaleX(0);
  }

  .mega-card-badge {
    display: inline-block;
    margin-top: 6px;
    padding: 2px 8px;
    border: 1px solid rgba(200, 169, 110, 0.5);
    border-radius: 999px;
    color: #c8a96e;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .mega-card {
    position: relative;
    display: block;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    aspect-ratio: 1 / 1;
    opacity: 0;
    transform: translateY(8px) scale(0.97);
    transition:
      opacity 0.35s ease calc(var(--i) * 0.04s + 0.05s),
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)
        calc(var(--i) * 0.04s + 0.05s);
  }

  :global(.has-mega:hover) .mega-card,
  :global(.has-mega:focus-within) .mega-card {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .mega-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .mega-card:hover img {
    transform: scale(1.08);
  }

  /* Gradient overlay */
  .mega-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 8, 5, 0.86) 0%,
      rgba(10, 8, 5, 0.42) 30%,
      rgba(10, 8, 5, 0) 62%
    );
    transition: background 0.3s ease;
  }

  .mega-card:hover .mega-card-overlay {
    background: linear-gradient(
      to top,
      rgba(10, 8, 5, 0.9) 0%,
      rgba(10, 8, 5, 0.34) 34%,
      rgba(10, 8, 5, 0) 66%
    );
  }

  /* Content */
  .mega-card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    z-index: 1;
  }

  .mega-card-title {
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.2px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .mega-card:hover .mega-card-title {
    transform: translateY(-2px);
  }

  /* Gold accent line on hover */
  .mega-card-accent {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--brand-gold-bright),
      var(--brand-gold)
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
    z-index: 2;
  }

  .mega-card:hover .mega-card-accent {
    transform: scaleX(1);
  }
</style>
