---
/**
 * MegaMenu.astro — Products mega dropdown (desktop only, >= 1400px)
 *
 * 4x2 image-card grid layout. Each card = full-bleed photo + gradient overlay
 * + category name. Hover triggers image zoom, gold accent line, and "Explore" CTA.
 * Panel open/close is pure CSS hover on `.has-mega` (Navigation.astro).
 */
---

<div class="mega-panel">
  <div class="mega-header">
    <span class="mega-header-label">Our Product Lines</span>
  </div>
  <div class="mega-grid">
    <a href="/custom-metal-panel.html" class="mega-card" style="--i:0">
      <img src="https://file.meiyualuminum.com/home/mega-menu/aluminum-veneer.webp" alt="Aluminum Veneer" loading="lazy" />
      <div class="mega-card-overlay"></div>
      <div class="mega-card-content">
        <span class="mega-card-title">Aluminum Veneer</span>
        <span class="mega-card-cta">Explore <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </div>
      <span class="mega-card-accent"></span>
    </a>

    <a href="/metal-ceiling.html" class="mega-card" style="--i:1">
      <img src="https://file.meiyualuminum.com/home/mega-menu/aluminum-strip-panel.webp" alt="Aluminum Strip Panel" loading="lazy" />
      <div class="mega-card-overlay"></div>
      <div class="mega-card-content">
        <span class="mega-card-title">Aluminum Strip Panel</span>
        <span class="mega-card-cta">Explore <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </div>
      <span class="mega-card-accent"></span>
    </a>

    <a href="/glass-curtain-wall.html" class="mega-card" style="--i:2">
      <img src="https://file.meiyualuminum.com/home/mega-menu/u-shaped-aluminum-square-tube.webp" alt="U-Shaped Aluminum Square Tube" loading="lazy" />
      <div class="mega-card-overlay"></div>
      <div class="mega-card-content">
        <span class="mega-card-title">U-Shaped Aluminum Square Tube</span>
        <span class="mega-card-cta">Explore <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </div>
      <span class="mega-card-accent"></span>
    </a>

    <a href="/acoustic-baffle-ceiling.html" class="mega-card" style="--i:3">
      <img src="https://file.meiyualuminum.com/home/mega-menu/aluminum-honeycomb-core-panel.webp" alt="Aluminum Honeycomb Core Panel" loading="lazy" />
      <div class="mega-card-overlay"></div>
      <div class="mega-card-content">
        <span class="mega-card-title">Aluminum Honeycomb Core Panel</span>
        <span class="mega-card-cta">Explore <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </div>
      <span class="mega-card-accent"></span>
    </a>

    <a href="/dome-sunroom.html" class="mega-card" style="--i:4">
      <img src="https://file.meiyualuminum.com/home/mega-menu/aluminum-ceiling-tile.webp" alt="Aluminum Ceiling Tile" loading="lazy" />
      <div class="mega-card-overlay"></div>
      <div class="mega-card-content">
        <span class="mega-card-title">Aluminum Ceiling Tile</span>
        <span class="mega-card-cta">Explore <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </div>
      <span class="mega-card-accent"></span>
    </a>

    <a href="/modular-house.html" class="mega-card" style="--i:5">
      <img src="https://file.meiyualuminum.com/home/mega-menu/aluminum-square-tube.webp" alt="Aluminum Square Tube" loading="lazy" />
      <div class="mega-card-overlay"></div>
      <div class="mega-card-content">
        <span class="mega-card-title">Aluminum Square Tube</span>
        <span class="mega-card-cta">Explore <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </div>
      <span class="mega-card-accent"></span>
    </a>

    <a href="/louvered-pergola.html" class="mega-card" style="--i:6">
      <img src="https://file.meiyualuminum.com/home/mega-menu/fluted-aluminum-panel.webp" alt="Fluted Aluminum Panel" loading="lazy" />
      <div class="mega-card-overlay"></div>
      <div class="mega-card-content">
        <span class="mega-card-title">Fluted Aluminum Panel</span>
        <span class="mega-card-cta">Explore <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </div>
      <span class="mega-card-accent"></span>
    </a>

    <a href="/products/" class="mega-card" style="--i:7">
      <img src="https://file.meiyualuminum.com/home/mega-menu/aluminum-strip-panel.webp" alt="Aluminum Skirting Board" loading="lazy" />
      <div class="mega-card-overlay"></div>
      <div class="mega-card-content">
        <span class="mega-card-title">Aluminum Skirting Board</span>
        <span class="mega-card-cta">View All <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </div>
      <span class="mega-card-accent"></span>
    </a>
  </div>
</div>

<style>
  .mega-panel {
    --brand-gold: #C0A882;
    --brand-gold-bright: #F0C96A;
    --panel-bg: #110e0b;

    box-sizing: border-box;
    display: none;
    flex-direction: column;
    background: var(--panel-bg);
    border-top: 2px solid var(--brand-gold-bright);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
  }
  .mega-panel *,
  .mega-panel *::before,
  .mega-panel *::after {
    box-sizing: inherit;
  }

  @media screen and (min-width: 1400px) {
    .mega-panel {
      display: flex;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: 100%;
      padding: 24px 48px 32px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.25s ease 0.15s, visibility 0.25s ease 0.15s;
      z-index: 999;
    }

    :global(.has-mega:hover) .mega-panel,
    :global(.has-mega:focus-within) .mega-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity 0.25s ease 0s, visibility 0.25s ease 0s;
    }
  }

  /* Header label */
  .mega-header {
    margin-bottom: 16px;
    padding-left: 4px;
  }
  .mega-header-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--brand-gold);
    opacity: 0.85;
  }

  /* 4x2 Grid */
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 16px;
    flex: 1;
  }

  /* Card */
  .mega-card {
    position: relative;
    display: block;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    aspect-ratio: 16 / 10;
    opacity: 0;
    transform: translateY(8px) scale(0.97);
    transition: opacity 0.35s ease calc(var(--i) * 0.04s + 0.05s),
                transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--i) * 0.04s + 0.05s);
  }

  :global(.has-mega:hover) .mega-card,
  :global(.has-mega:focus-within) .mega-card {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .mega-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .mega-card:hover img {
    transform: scale(1.08);
  }

  /* Gradient overlay */
  .mega-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 8, 5, 0.82) 0%,
      rgba(10, 8, 5, 0.35) 45%,
      rgba(10, 8, 5, 0.05) 100%
    );
    transition: background 0.3s ease;
  }

  .mega-card:hover .mega-card-overlay {
    background: linear-gradient(
      to top,
      rgba(10, 8, 5, 0.88) 0%,
      rgba(10, 8, 5, 0.25) 50%,
      rgba(10, 8, 5, 0) 100%
    );
  }

  /* Content */
  .mega-card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    z-index: 1;
  }

  .mega-card-title {
    font-size: 17px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.2px;
    line-height: 1.3;
    transition: transform 0.3s ease;
  }

  .mega-card:hover .mega-card-title {
    transform: translateY(-2px);
  }

  .mega-card-cta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--brand-gold-bright);
    letter-spacing: 0.3px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease 0.05s, transform 0.3s ease 0.05s;
  }

  .mega-card:hover .mega-card-cta {
    opacity: 1;
    transform: translateY(0);
  }

  .mega-card-cta svg {
    transition: transform 0.2s ease;
  }

  .mega-card:hover .mega-card-cta svg {
    transform: translateX(3px);
  }

  /* Gold accent line at bottom */
  .mega-card-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand-gold-bright), var(--brand-gold));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .mega-card:hover .mega-card-accent {
    transform: scaleX(1);
  }

  /* Subtle border glow on hover */
  .mega-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 10px;
    border: 1.5px solid transparent;
    transition: border-color 0.3s ease;
    pointer-events: none;
    z-index: 2;
  }

  .mega-card:hover::after {
    border-color: rgba(240, 201, 106, 0.35);
  }
</style>
