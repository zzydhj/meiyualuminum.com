<style>
  /*
   * Brand color tokens are defined on the panel root (NOT on :root).
   * Astro scopes :root into :root[data-astro-cid], which never matches <html>,
   * so :root variables would silently break inside a component <style>.
   */
  .mega-panel {
    --brand-deep:    #3A2E26;
    --brand-main:    #69574A;
    --brand-light:   #7A6A5E;
    --brand-gold:    #C0A882;
    --brand-gold-lt: #E8D5B0;
    --brand-gold-bright: #F0C96A;
    --border:        rgba(192,168,130,0.25);

    /* Scoped box-sizing (NOT a bare `* {}` reset — that caused specificity
       conflicts elsewhere in this project). */
    box-sizing: border-box;

    /* Hidden everywhere by default; only becomes a dropdown on desktop. */
    display: none;
    flex-direction: column;
    background: #fff;
    border-top: 3px solid var(--brand-gold-bright);
    box-shadow: 0 16px 48px rgba(44,32,24,0.18);
  }
  .mega-panel *,
  .mega-panel *::before,
  .mega-panel *::after {
    box-sizing: inherit;
  }

  /*
   * Desktop only (>= 1400px): render as a 1400x500 dropdown that sits flush
   * below the header and is horizontally centered with the 1400px nav.
   *
   * Positioning trick: the wrapping `.has-mega` (in Navigation.astro) is
   * position: static, so this absolutely-positioned panel resolves against the
   * nearest positioned ancestor — the sticky <header> (full viewport width).
   *   top: 100%        -> right below the 80px header
   *   left: 50% + translateX(-50%) -> centered in the viewport (= the nav)
   */
  @media screen and (min-width: 1400px) {
    .mega-panel {
      display: flex;
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      width: 1400px;
      height: 500px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      /* CLOSE transition: wait a short grace period (0.18s) before fading out,
         so the panel doesn't slam shut if the mouse briefly slips outside.
         This delayed transition only applies when leaving hover — the opening
         rule below overrides it with a zero-delay transition. */
      transition: opacity 0.2s ease 0.18s, visibility 0.2s ease 0.18s;
      /* Below the header's own z-index (1000); still above page content
         because the panel lives inside the header's stacking context. */
      z-index: 999;
    }

    /* Open when the wrapping `.has-mega` is hovered or keyboard-focused.
       :global() is required because `.has-mega` is rendered by a different
       component (Navigation.astro) with its own scope attribute. */
    :global(.has-mega:hover) .mega-panel,
    :global(.has-mega:focus-within) .mega-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      /* OPEN transition: no delay — the panel appears instantly. */
      transition: opacity 0.2s ease 0s, visibility 0.2s ease 0s;
    }
  }

  /* ===== Tab bar ===== */
  .mega-tabs {
    display: flex;
    background: var(--brand-deep);
    border-bottom: 2px solid rgba(240,201,106,0.2);
    flex-shrink: 0;
  }

  .mega-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 8px;
    height: 48px;
    flex: 1;
    min-width: 0;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
    text-decoration: none;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    white-space: nowrap;
    text-align: center;
    letter-spacing: 0.2px;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .mega-tab:hover {
    color: var(--brand-gold-bright);
    background: rgba(240,201,106,0.10);
  }
  .mega-tab.active {
    color: #ffffff;
    font-weight: 700;
    border-bottom-color: var(--brand-gold-bright);
    background: rgba(240,201,106,0.15);
  }

  /* ===== Content area (fills the fixed 500px panel, scrolls if a pane is tall) ===== */
  .mega-content {
    position: relative;
    flex: 1;
    overflow-y: auto;
  }

  .mega-pane {
    position: absolute;
    top: 0; left: 0; right: 0;
    padding: 28px 36px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s;
  }
  .mega-pane.active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  .mega-pane p {
    margin: 0;
  }

  .mega-pane-title {
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #8B6914;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1.5px solid var(--border);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mega-pane-title::before {
    content: '';
    display: block;
    width: 3px; height: 14px;
    border-radius: 2px;
    background: var(--brand-gold-bright);
    flex-shrink: 0;
  }

  .mega-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px 12px;
    margin-bottom: 20px;
  }
  .mega-grid-item {
    display: block;
    padding: 9px 12px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    color: #1A1208;
    line-height: 1.35;
    border: 1px solid transparent;
    transition: all 0.15s;
  }
  .mega-grid-item:hover {
    background: #fdf0d8;
    color: #3A2E26;
    border-color: rgba(192,168,130,0.4);
  }

  .mega-sub-group { margin-bottom: 16px; }
  .mega-sub-label {
    display: inline-flex;
    align-items: center;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 700;
    color: #3A2E26;
    background: #f5e8cc;
    border-left: 3px solid var(--brand-gold-bright);
    border-radius: 0 5px 5px 0;
    text-decoration: none;
    margin-bottom: 8px;
    transition: all 0.15s;
  }
  .mega-sub-label:hover {
    background: #edd9a3;
    color: #1A1208;
  }

  .mega-sub-children {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px 8px;
    padding-left: 16px;
  }
  .mega-sub-child {
    display: block;
    padding: 6px 8px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 500;
    color: #5A4A3A;
    transition: all 0.15s;
  }
  .mega-sub-child::before {
    content: '– ';
    color: #C09020;
  }
  .mega-sub-child:hover {
    color: #1A1208;
    background: #fdf0d8;
  }

  .mega-cta {
    margin-top: 20px;
    padding: 14px 20px;
    background: linear-gradient(135deg, #2C2018, #4A3D33);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .mega-cta-text {
    font-size: 13px;
    color: rgba(255,255,255,0.90);
    line-height: 1.5;
  }
  .mega-cta-text strong {
    color: var(--brand-gold-bright);
    display: block;
    margin-bottom: 2px;
    font-size: 13.5px;
  }
  .mega-cta-btn {
    flex-shrink: 0;
    padding: 8px 20px;
    border-radius: 5px;
    background: var(--brand-gold-bright);
    color: #1A1208;
    text-decoration: none;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
    transition: all 0.2s;
  }
  .mega-cta-btn:hover {
    background: #FFD97A;
    transform: translateY(-1px);
  }

  /* Louvered Pergola pane (previously inline styles) */
  .mega-pergola-note {
    font-size: 14px;
    color: #5A4A3A;
    line-height: 1.8;
    margin-bottom: 20px;
  }
  .mega-pergola-btn {
    display: inline-block;
    background: #C09020;
    color: #fff;
  }
</style>

<script>
  /* Tab switching inside the Mega Menu (show/hide of the panel itself is pure CSS). */
  const megaTabs = document.querySelectorAll<HTMLAnchorElement>('.mega-tab[data-pane]');
  const megaPanes = document.querySelectorAll<HTMLElement>('.mega-pane');

  megaTabs.forEach((tab) => {
    tab.addEventListener('mouseenter', () => {
      megaTabs.forEach((t) => t.classList.remove('active'));
      megaPanes.forEach((p) => p.classList.remove('active'));
      tab.classList.add('active');
      const paneId = tab.getAttribute('data-pane');
      if (paneId) {
        document.getElementById(paneId)?.classList.add('active');
      }
    });
  });
</script>
