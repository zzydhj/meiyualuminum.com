---
/**
 * BackToTop.astro — 全局“回到顶部”圆钮
 *
 * 2026-11-07：从“贴窗口下沿的扁底座”改成圆形按钮。右下角现在只有两枚（业主口径：
 * 头像 + 回顶），尺寸与间距按目标站实测拉齐（它两枚同尺寸 60px、列间距 16px），
 * **只是上下顺序相反：我们回顶在下、头像在上**（业主原话：询盘那个不然太往下了）：
 *   本钮 60px @ bottom 24 / right 24
 *   头像 60px @ bottom 100 / right 24（= 24 + 60 + 16 间距，FloatingAvatar）
 *   窄屏：本钮 52px @ bottom 16 / right 14；头像 52px @ bottom 84 / right 14
 *   两枚同尺寸同 right，圆心自然落在同一条竖线上，不再需要补半差。
 * 白底藏青箭头 + 暖色描边（纯白页上没描边就看不见），hover 转品牌棕。
 * 滚动超过 600px 才从下方滑入，回到顶部附近滑出（阈值未变）。
 * 在 BaseLayout.astro 中引入一次即可，所有页面自动生效。
 */
---

<button
    type="button"
    class="back-to-top"
    id="backToTop"
    aria-label="Back to top"
>
    <svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <path d="M12 19V5M5 12l7-7 7 7"></path>
    </svg>
</button>

<script>
    const btn = document.getElementById("backToTop")!;
    const THRESHOLD = 600; // 滚动超过 600px 才显示
    const onScroll = () =>
        btn.classList.toggle("visible", window.scrollY > THRESHOLD);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
    btn.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: "smooth" }),
    );
</script>

<style>
    .back-to-top {
        position: fixed;
        bottom: 24px; /* 回顶在下、头像在上（本钮贴窗口下沿一侧） */
        right: 24px; /* 与头像同尺寸同 right，圆心自然同列 */
        z-index: 899;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        border: 1px solid #e6ded2;
        border-radius: 50%;
        background-color: #fff;
        color: #0d0950;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(13, 9, 80, 0.12);
        transform: translateY(
            200%
        ); /* 隐藏时得完全沉到视口外：要盖过 bottom 24 + 自身 60 = 84px；
              200% = 120px 够干净（140% 只有 84px，刚好卡在边界上会露白边） */
        visibility: hidden;
        pointer-events: none;
        transition:
            transform 0.3s ease,
            visibility 0.3s ease,
            background-color 0.2s,
            color 0.2s,
            box-shadow 0.2s;
    }

    .back-to-top.visible {
        transform: translateY(0);
        visibility: visible;
        pointer-events: auto;
    }

    .back-to-top:hover {
        background-color: #69574a;
        border-color: #69574a;
        color: #fff;
        box-shadow: 0 8px 22px rgba(105, 87, 74, 0.32);
    }

    .back-to-top:active {
        background-color: #5a4a3e;
    }

    .back-to-top:focus-visible {
        outline: 2px solid #c09020;
        outline-offset: 3px;
    }

    /* 移动端：与窄屏头像同尺寸同列（阈值与页眉桌面断点 1280px 一致） */
    @media screen and (max-width: 1279.98px) {
        .back-to-top {
            width: 52px;
            height: 52px;
            bottom: 16px; /* 本钮在下，头像在上方 84px 处（16 + 52 + 16） */
            right: 14px; /* 与头像同 right */
        }
        .back-to-top svg {
            width: 20px;
            height: 20px;
        }
    }
</style>
