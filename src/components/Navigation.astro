---
import MegaMenu from "./MegaMenu.astro";
---

<div id="main-menu" class="nav-links">
  <a href="/">Home</a>

  <div class="has-mega">
    <a href="/products/">
      Products
      <svg
        class="nav-chevron"
        width="11"
        height="7"
        viewBox="0 0 11 7"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M1.5 1.5L5.5 5.5L9.5 1.5"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
    <MegaMenu />
  </div>

  <a href="/about/">About</a>

  <div class="has-dropdown">
    <a href="/videos/">
      Videos
      <svg
        class="nav-chevron"
        width="11"
        height="7"
        viewBox="0 0 11 7"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M1.5 1.5L5.5 5.5L9.5 1.5"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
    <div class="dropdown">
      <a href="/video-tags/Project%20Cases/">Project Cases</a>
      <a href="/video-tags/Factory%20Tour/">Factory Tour</a>
      <a href="/video-tags/How%20It's%20Made/">How It's Made</a>
      <a href="/video-tags/Installation%20Guide/">Installation Guide</a>
      <a href="/video-tags/Product%20Showcase/">Product Showcase</a>
      <a href="/video-tags/Quality%20%26%20Certifications/"
        >Quality &amp; Certifications</a
      >
    </div>
  </div>

  <div class="has-dropdown">
    {
      /* Resource 本身没有着陆页（子项才有），所以不给 href：
         带 href="#" 时点一下会把页面弹回顶部，看起来像菜单坏了。
         不给 href 的 <a> 不是链接也不可聚焦，下拉仍由 hover/focus 触发。 */
    }
    <a tabindex="-1" aria-disabled="true">
      Resource
      <svg
        class="nav-chevron"
        width="11"
        height="7"
        viewBox="0 0 11 7"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M1.5 1.5L5.5 5.5L9.5 1.5"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
    <div class="dropdown">
      {/* 三级飞出：子工具挂在 Free Tools 右侧弹出，不平铺进 Resource 下拉 */}
      <div class="has-flyout">
        <a href="/tools/" class="flyout-trigger">
          Free Tools &amp; Calculators
          <svg
            class="flyout-arrow"
            viewBox="0 0 24 24"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg
          >
        </a>
        <div class="flyout">
          <a href="/tools/ceiling-take-off/">Ceiling Take-off</a>
          <a href="/tools/aluminum-weight/">Aluminium Weight</a>
          <a href="/tools/perforation-open-area/">Perforation Open Area</a>
        </div>
      </div>
      <a href="/blog/">Blog</a>
      {
        /* 2026-10-30 灵感瀑布流：与 Blog 同类（都是「有得逛」的浏览型内容），
          不占顶栏一级位——Products 的全宽面板已经把顶栏挤满了。 */
      }
      <a href="/inspiration/">Design Inspiration</a>
      <a href="/categories/">Categories</a>
      <a href="/tags/">Tags</a>
      <a href="/faq/">FAQ</a>
      <a href="/surface-treatment-comparison/">Surface Treatment Guide</a>
      <a href="/installation-guides/">Installation Guides</a>
      <a href="/interactive-guides/">3D Build-Up Guides</a>
      <a href="/procurement-guide/">Procurement Guide</a>
      {
        /* 2026-10-30 业主指令单开的售后页：放在采购指南后面（两者都是「下单前要看
          的商业文件」），不新开一级菜单——顶栏再加一栏会把 Products 的全宽面板挤窄。 */
      }
      <a href="/after-sales/">After-Sales &amp; Warranty</a>
      <a href="/technical-documentation/">Technical Documentation</a>
    </div>
  </div>

  <a href="/project-gallery/">Project Gallery</a>

  <a href="/contact/">Contact Us</a>
</div>

<style>
  /* Mobile (< 1280px): desktop nav completely hidden.
     Mobile users get the full-screen accordion menu (MobileMenu.astro). */
  .nav-links {
    display: none;
  }

  /* Chevron indicator: only rendered on desktop (media query below). */
  .nav-chevron {
    display: none;
  }

  /* Desktop (>= 1280px): nav always visible, laid out horizontally.
     The nav stretches to the full header height so the Mega Menu trigger
     (.has-mega) can span the whole header, leaving no hover gap between the
     "Products" link and the dropdown panel. */
  @media screen and (min-width: 1280px) {
    .nav-links {
      display: flex;
      align-items: center;
      position: static;
      width: auto;
      height: 100%;
      background: none;
      box-shadow: none;
      max-height: none; /* undo the mobile scroll constraint */
      overflow: visible;
    }

    .nav-links a {
      display: inline-block;
      padding: 15px 17px;
      font-size: 1rem; /* 16px */
      font-weight: bold;
      text-decoration: none;
      text-transform: uppercase;
      text-align: center;
      color: var(--nav-link-color, #0d0950);
      position: relative; /* anchor for the ::after underline */
    }

    /* Replace the blocky orange hover background with a refined gold underline
       that grows from the center. Text color is intentionally left unchanged. */
    .nav-links a:hover,
    .nav-links a:focus {
      background-color: transparent;
    }
    .nav-links a::after {
      content: "";
      position: absolute;
      left: 17px;
      right: 17px;
      bottom: 12px;
      height: 2px;
      background: #c09020;
      transform: scaleX(0);
      transform-origin: center;
      transition: transform 0.25s ease;
    }
    .nav-links a:hover::after,
    .nav-links a:focus::after {
      transform: scaleX(1);
    }

    /* Chevron on the Products link: flips up while the Mega Menu is open. */
    .nav-chevron {
      display: inline-block;
      margin-left: 7px;
      vertical-align: 2px;
      /* Rotate back with the same grace period as the panel's close delay. */
      transition: transform 0.25s ease 0.18s;
    }
    .has-mega:hover .nav-chevron,
    .has-mega:focus-within .nav-chevron,
    .has-dropdown:hover .nav-chevron,
    .has-dropdown:focus-within .nav-chevron {
      transform: rotate(180deg);
      transition: transform 0.25s ease 0s; /* flip up instantly on open */
    }

    /* Mega Menu 关闭为立即隐藏：箭头同步立即复位，与浮窗一致（不影响 has-dropdown 的关闭缓冲） */
    .has-mega .nav-chevron {
      transition: transform 0s;
    }

    /* Mega Menu trigger wrapper: full header height so hover is continuous
       from the link down to the panel. Kept position: static so the panel's
       absolute positioning resolves against the <header> (centered, 1400px). */
    .has-mega {
      display: flex;
      align-items: center;
      height: 100%;
      position: static;
    }

    /* ===== Standard vertical dropdown (About / Videos / Resource) =====
       Coloured to match the Mega Menu's brand palette: dark tab-bar brown
       (#3A2E26) body with the bright-gold (#F0C96A) top accent, and the
       same open/close transition + 0.18s close grace period. */
    .has-dropdown {
      display: flex;
      align-items: center;
      height: 100%;
      position: relative; /* anchor for the absolute .dropdown */
    }
    .nav-links .dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 240px;
      background: #3a2e26;
      border-top: 3px solid #f0c96a;
      box-shadow: 0 16px 48px rgba(44, 32, 24, 0.18);
      padding: 8px 0;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      /* CLOSE: wait the 0.18s grace period before fading out. */
      transition:
        opacity 0.2s ease 0.18s,
        visibility 0.2s ease 0.18s;
      z-index: 999;
    }
    .has-dropdown:hover .dropdown,
    .has-dropdown:focus-within .dropdown {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      /* OPEN: instant. */
      transition:
        opacity 0.2s ease 0s,
        visibility 0.2s ease 0s;
    }
    .nav-links .dropdown a {
      display: block;
      padding: 10px 22px;
      font-size: 14px;
      font-weight: 600;
      text-transform: none;
      text-align: left;
      white-space: nowrap;
      color: rgba(255, 255, 255, 0.92);
      background: transparent;
      position: static;
      transition:
        color 0.15s,
        background 0.15s;
    }
    .nav-links .dropdown a:hover,
    .nav-links .dropdown a:focus {
      color: #f0c96a;
      background: rgba(240, 201, 106, 0.1);
    }
    /* The top-level gold underline must not appear inside the dark dropdown. */
    .nav-links .dropdown a::after {
      content: none;
    }

    /* ===== Nested flyout inside a dropdown (Resource → Free Tools) =====
       三级菜单：悬停或键盘聚焦时子面板从右侧弹出。
       top 偏移 = 父下拉 padding 8px + border-top 3px，让两者顶边对齐；
       与父下拉左边缘零间隙，避免鼠标横移时闪断。 */
    .has-flyout {
      position: relative;
    }
    .nav-links .dropdown a.flyout-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }
    .flyout-arrow {
      flex-shrink: 0;
      opacity: 0.75;
    }
    .nav-links .flyout {
      position: absolute;
      top: -11px;
      left: 100%;
      min-width: 232px;
      background: #3a2e26;
      border-top: 3px solid #f0c96a;
      box-shadow: 0 16px 48px rgba(44, 32, 24, 0.18);
      padding: 8px 0;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      /* CLOSE: 同样给 0.18s 缓冲，与父下拉一致 */
      transition:
        opacity 0.2s ease 0.18s,
        visibility 0.2s ease 0.18s;
    }
    .has-flyout:hover > .flyout,
    .has-flyout:focus-within > .flyout {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      /* OPEN: 立即 */
      transition:
        opacity 0.2s ease 0s,
        visibility 0.2s ease 0s;
    }
  }
</style>
