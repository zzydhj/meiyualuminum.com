<div id="main-menu" class="nav-links">
  <a href="/">Home</a>
  <a href="/about/">About</a>
  <a href="/products/">Products</a>
  <a href="/services/">Services</a>
  <a href="/categories/">Categories</a>
  <a href="/blog/">Blog</a>
  <a href="/tags/">Tags</a>
  <a href="/contact/">Contact</a>
</div>

<style>
  .nav-links {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    width: 100%;
    display: none;
    margin: 0;
    background-color: #fff;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    z-index: 999;
  }

  .nav-links a {
    display: block;
    text-align: center;
    padding: 10px 0;
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: bold;
    text-transform: uppercase;
    color: #0d0950;
  }

  .nav-links a:hover,
  .nav-links a:focus {
    background-color: #ff9776;
  }

  /* Mobile: expand when the hamburger button (.menu, lives in Menu.astro) is toggled.
     :global() is required because .menu belongs to a different component. */
  :global(.menu[aria-expanded="true"]) ~ .nav-links {
    display: block;
  }

  /* Desktop: nav always visible, laid out horizontally */
  @media screen and (min-width: 636px) {
    .nav-links {
      display: block;
      position: static;
      width: auto;
      background: none;
      box-shadow: none;
    }

    .nav-links a {
      display: inline-block;
      padding: 15px 20px;
    }
  }
</style>

