---
/**
 * FloatingFreeSample.astro — "Free Sample" 气泡标签
 *
 * - 桌面端：WhatsApp 按钮左侧，SVG 一笔画出完美对称胶囊 + 箭头
 * - 页面加载后立即显示（短暂入场动画后常驻）
 * - 点击 → 打开询盘弹窗
 * - 手机端不显示
 */
---

<div class="sample-bubble" id="sampleBubble" aria-hidden="true">
  <button
    type="button"
    class="bubble-btn"
    data-open-inquiry-modal
    aria-label="Request free sample"
  >
    <!-- SVG 一笔画：左半圆 + 右半圆（被箭头打断）= 完美对称胶囊 + 尖角 -->
    <svg class="bubble-shape" viewBox="0 0 148 40" preserveAspectRatio="none" aria-hidden="true">
      <path d="
        M 20,0
        L 120,0
        A 20,20 0 0,1 137,12
        L 148,20
        L 137,28
        A 20,20 0 0,1 120,40
        L 20,40
        A 20,20 0 0,1 0,20
        A 20,20 0 0,1 20,0
        Z
      " fill="#69574a" />
    </svg>
    <span class="bubble-label">
      <span class="bubble-icon">🎁</span>
      <span class="bubble-text">Free Sample</span>
    </span>
  </button>
</div>

<script>
  const bubble = document.getElementById('sampleBubble')!;
  // 页面加载后短暂入场动画，之后常驻
  requestAnimationFrame(() => {
    bubble.classList.add('visible');
    bubble.setAttribute('aria-hidden', 'false');
  });
</script>

<style>
  .sample-bubble {
    position: fixed;
    bottom: 166px;
    right: 100px;
    z-index: 899;
    opacity: 0;
    transform: translateX(10px) scale(0.9);
    transition: opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
    filter: drop-shadow(0 3px 10px rgba(105, 87, 74, 0.45));
  }

  .sample-bubble.visible {
    opacity: 1;
    transform: translateX(0) scale(1);
    pointer-events: auto;
  }

  .bubble-btn {
    position: relative;
    display: block;
    width: 148px;
    height: 40px;
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .bubble-btn:hover {
    transform: scale(1.05);
  }

  .bubble-btn:hover .bubble-shape path {
    fill: #5a4a3e;
  }

  .bubble-shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bubble-shape path {
    transition: fill 0.2s;
  }

  .bubble-label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 100%;
    height: 100%;
    padding-right: 12px;
    color: #fff;
    pointer-events: none;
  }

  .bubble-icon {
    font-size: 14px;
    line-height: 1;
    animation: bubble-bounce 2s ease-in-out infinite;
  }

  .bubble-text {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.3px;
  }

  @keyframes bubble-bounce {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    25% { transform: translateY(-2px) rotate(-5deg); }
    75% { transform: translateY(-1px) rotate(5deg); }
  }

  @media screen and (max-width: 1399px) {
    .sample-bubble {
      display: none !important;
    }
  }
</style>
