  <!-- 主体 -->
  <div class="my-ft-top">
    <!-- 品牌描述 -->
    <div class="my-ft-brand">
      <p>Premium aluminum ceiling panels, facade cladding and decorative metal systems — engineered for lasting performance and architectural excellence.</p>
    </div>

    <!-- Products -->
    <div class="my-ft-col">
      <h4>Products</h4>
      <ul>
        <li><a href="/products/">Aluminum Facade Panel</a></li>
        <li><a href="/products/">Suspended Ceiling</a></li>
        <li><a href="/products/">Acoustic Ceiling</a></li>
        <li><a href="/products/">Decorative Screen</a></li>
        <li><a href="/products/">ACP Panel</a></li>
        <li><a href="/products/">Curtain Wall System</a></li>
      </ul>
    </div>

    <!-- Company -->
    <div class="my-ft-col">
      <h4>Company</h4>
      <ul>
        <li><a href="/about/">About MEIYU</a></li>
        <li><a href="#">Manufacturing</a></li>
        <li><a href="#">Certifications</a></li>
        <li><a href="/blog/">Case Studies</a></li>
        <li><a href="/blog/">Blog &amp; News</a></li>
        <li><a href="#">Careers</a></li>
      </ul>
    </div>

    <!-- Contact -->
    <div class="my-ft-col">
      <h4>Contact Us</h4>
      <ul class="my-ft-contact">
        <li><span class="ic">📍</span><span>No.88 Industrial Ave, Foshan, Guangdong, China</span></li>
        <li><span class="ic">📞</span><span>+86 123 4567 8900</span></li>
        <li><span class="ic">📧</span><span>info@meiyualuminum.com</span></li>
        <li><span class="ic">🕐</span><span>Mon – Fri: 9:00 AM – 6:00 PM (CST)</span></li>
      </ul>
    </div>

    <!-- CTA 卡片 -->
    <div class="my-ft-cta-box">
      <strong>Contact MEIYU</strong>
      <p>Leave us a message for a free quote or catalog. We will respond within 24 hours.</p>
      <div class="my-ft-cta-btns">
        <a href="/contact/" class="my-ft-cta-btn primary">
          <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          Get a Free Quote
        </a>
      </div>
    </div>
  </div>

  <!-- 认证 -->
  <div class="my-ft-certs">
    <span class="my-ft-badge">✓ ISO 9001 Certified</span>
    <span class="my-ft-badge">✓ SGS Tested</span>
    <span class="my-ft-badge">✓ CE Certified</span>
    <span class="my-ft-badge">✓ PVDF Coating</span>
    <span class="my-ft-badge">✓ 15+ Years Experience</span>
  </div>

  <!-- 版权 -->
  <div class="my-ft-bottom">
    <span>© 2026 MEIYU Aluminum Co., Ltd. All Rights Reserved.</span>
    <div>
      <a href="#">Privacy Policy</a>
      <a href="#">Terms of Use</a>
      <a href="#">Sitemap</a>
    </div>
  </div>
  </div>
</footer>

<style>
  /* ── Base reset ──
     Only reset box-sizing (no blanket margin/padding override).
     Browser-default margins on headings, lists, and paragraphs
     are explicitly zeroed per-element below.
  */
  .my-ft {
    box-sizing: border-box;
    font-family: 'Inter', 'Helvetica Neue', sans-serif;
    background: #1A1008;
    color: rgba(255, 255, 255, 0.8);
    width: 100%;
  }
  .my-ft *,
  .my-ft *::before,
  .my-ft *::after {
    box-sizing: inherit;
  }
  /* Explicit margin reset for elements that have browser defaults */
  .my-ft h1, .my-ft h2, .my-ft h3, .my-ft h4,
  .my-ft p, .my-ft ul, .my-ft ol, .my-ft li {
    margin: 0;
    padding: 0;
  }

  /* ── Centered content container (matches header nav + main .container) ── */
  .my-ft-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* ── Header: Logo + Social ── */
  .my-ft-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 36px 0px 28px;
    border-bottom: 1px solid rgba(200, 169, 110, 0.15);
    flex-wrap: wrap;
    gap: 16px;
  }
  .my-ft-head-logo {
    display: flex;
    align-items: center;
  }
  .my-ft-head-logo img {
    height: 48px;
    width: auto;
    display: block;
    object-fit: contain;
  }
  .my-ft-socials {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .my-ft-socials a {
    width: 36px;
    height: 36px;
    border: 1px solid rgba(200, 169, 110, 0.25);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .my-ft-socials a svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }
  .my-ft-socials a:hover {
    background: #c8a96e;
    border-color: #c8a96e;
    color: #fff;
  }

  /* ── Main Grid ── */
  .my-ft-top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.1fr 1.3fr;
    gap: 40px;
    padding: 56px 0px;
    border-bottom: 1px solid rgba(200, 169, 110, 0.1);
    align-items: start;
  }
  .my-ft-brand p {
    font-size: 14px;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.5);
    max-width: 260px;
  }
  .my-ft-col h4 {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #c8a96e;
    margin-bottom: 20px;
  }
  .my-ft-col ul {
    list-style: none;
  }
  .my-ft-col ul li {
    margin-bottom: 12px;
  }
  .my-ft-col ul li a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
    line-height: 1.4;
  }
  .my-ft-col ul li a:hover {
    color: #c8a96e;
  }
  .my-ft-contact {
    list-style: none;
  }
  .my-ft-contact li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 14px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
  }
  .my-ft-contact .ic {
    color: #c8a96e;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ── CTA Card ── */
  .my-ft-cta-box {
    background: rgba(200, 169, 110, 0.06);
    border: 1px solid rgba(200, 169, 110, 0.3);
    border-radius: 10px;
    padding: 24px 22px;
  }
  .my-ft-cta-box strong {
    display: block;
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 10px;
    line-height: 1.4;
  }
  .my-ft-cta-box p {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 18px;
    line-height: 1.65;
  }
  .my-ft-cta-btns {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .my-ft-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 7px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: all 0.2s;
  }
  .my-ft-cta-btn svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
    flex-shrink: 0;
  }
  .my-ft-cta-btn.primary {
    background: #c8a96e;
    color: #1A1008;
  }
  .my-ft-cta-btn.primary:hover {
    background: #e8d5a8;
    transform: translateY(-2px);
  }

  /* ── Certifications ── */
  .my-ft-certs {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 32px 0px;
    border-bottom: 1px solid rgba(200, 169, 110, 0.08);
  }
  .my-ft-badge {
    padding: 8px 20px;
    border: 1px solid rgba(200, 169, 110, 0.35);
    border-radius: 30px;
    font-size: 12px;
    font-weight: 600;
    color: #c8a96e;
    letter-spacing: 0.5px;
  }

  /* ── Bottom Bar ── */
  .my-ft-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    padding: 20px 0px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.35);
    gap: 12px;
  }
  .my-ft-bottom a {
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    margin-left: 20px;
    transition: color 0.2s;
  }
  .my-ft-bottom a:hover {
    color: #c8a96e;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .my-ft-top {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .my-ft-brand {
      grid-column: 1 / -1;
    }
    .my-ft-brand p {
      max-width: 100%;
    }
    .my-ft-cta-box {
      grid-column: span 1;
    }
  }
  @media (max-width: 900px) {
    .my-ft-inner {
      padding-left: 24px;
      padding-right: 24px;
    }
    .my-ft-top {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      padding: 40px 0px;
    }
    .my-ft-brand {
      grid-column: 1 / -1;
    }
    .my-ft-cta-box {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 500px) {
    .my-ft-inner {
      padding-left: 20px;
      padding-right: 20px;
    }
    .my-ft-top {
      grid-template-columns: 1fr;
      padding: 36px 0px;
    }
    .my-ft-head {
      padding: 24px 0px;
    }
    .my-ft-certs {
      padding: 20px 0px;
    }
    .my-ft-badge {
      font-size: 11px;
      padding: 5px 12px;
    }
    .my-ft-bottom {
      padding: 18px 0px;
      flex-direction: column;
      text-align: center;
    }
    .my-ft-bottom a {
      margin-left: 0;
      margin: 0 8px;
    }
  }
</style>
