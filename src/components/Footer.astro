---
/**
 * Footer.astro — 全站页脚
 *
 * 公司数据（地址 / 电话 / 邮箱 / 认证）一律从 lib/companyProfile.ts 取，
 * 不在这里硬编码。以前本组件自己写了一套，而且写的还是错的：
 *   城市填了 Foshan（2026-10-27 起对外口径统一不写城市，只到 Guangdong Province）、
 *   电话是模板占位号 +86 123 4567 8900、
 *   写了无依据的 “SGS Tested” 与 “15+ Years Experience”。
 * 页脚出现在每一个页面上，这类错会直接砸信任，也会被采购合规审查抓到。
 */
import { companyFacts, certBadges, responseTime } from "../lib/companyProfile";

// wa.me 只接受纯数字；从 companyFacts.phone 推，保证电话号码只有一个来源。
const waNumber = companyFacts.phone.replace(/[^\d]/g, "");
const year = new Date().getFullYear();
---

<footer class="my-ft">
  <div class="my-ft-inner">
    <!-- Logo + 社媒 -->
    <div class="my-ft-head">
      <div class="my-ft-head-logo">
        <img
          src="https://file.meiyualuminum.com/home/logo-white-2.png"
          alt="MEIYU Aluminum"
        />
      </div>

      <!-- 只保留已核实的真实账号。宁可不放，也不要留一排 href="#" 的空图标：
           买家点半天没反应，读作“这个站没人维护”。加账号在下方添一个 <a> 即可。 -->
      <div class="my-ft-socials">
        <a
          class="soc--yt"
          href="https://www.youtube.com/@meiyualuminum"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
          ><svg viewBox="0 0 24 24"
            ><path
              d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"
            ></path></svg
          ></a
        >
        <!-- LinkedIn：当前给的是个人档案（/in/）。若以后建了公司主页（/company/），
             只需换 href，图标不动。 -->
        <a
          class="soc--li"
          href="https://www.linkedin.com/in/william-wei-meiyu-aluminum/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          ><svg viewBox="0 0 24 24"
            ><path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7H10V9h4v1.76A6 6 0 0 1 16 8zM2 9h4v12H2z"
            ></path><circle cx="4" cy="4" r="2"></circle></svg
          ></a
        >
        <!-- TikTok -->
        <a
          class="soc--tt"
          href="https://www.tiktok.com/@meiyualuminum"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok"
          ><svg viewBox="0 0 24 24"
            ><path
              d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 0 0-6.13 6.33 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"
            ></path></svg
          ></a
        >
        <a
          class="soc--wa"
          href={`https://wa.me/${waNumber}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          ><svg viewBox="0 0 24 24"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
            ></path></svg
          ></a
        >
      </div>
    </div>

    <!-- 主体 -->
    <div class="my-ft-top">
      <!-- 品牌描述 -->
      <div class="my-ft-brand">
        <p>
          Premium aluminum ceiling panels, facade cladding and decorative metal
          systems — engineered for lasting performance and architectural
          excellence.
        </p>
      </div>

      <!-- Products：全部指向真实存在的分类页。以前六行文案不同但 href 全指 /products/，
           对买家是误导（看着像六个入口，点进去是同一个页），对 Google 是六个重复链接。 -->
      <div class="my-ft-col">
        <h4>Products</h4>
        <ul>
          <li>
            <a href="/categories/aluminum-veneer/">Aluminum Veneer Panel</a>
          </li>
          <li>
            <a href="/categories/aluminum-wall-panels/">Aluminum Wall Panels</a>
          </li>
          <li>
            <a href="/categories/aluminum-ceiling-tile/">Ceiling Tiles</a>
          </li>
          <li>
            <a href="/categories/aluminum-strip-panel/">Strip Ceilings</a>
          </li>
          <li>
            <a href="/categories/open-cell-ceiling/">Open Cell Ceilings</a>
          </li>
          <li>
            <a href="/categories/aluminum-honeycomb-core-panel/"
              >Honeycomb Panels</a
            >
          </li>
          <li><a href="/categories/">All Categories</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div class="my-ft-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/about/">About MEIYU</a></li>
          <li><a href="/manufacturing/">Manufacturing</a></li>
          <li><a href="/certifications/">Certifications</a></li>
          <li><a href="/project-gallery/">Project Gallery</a></li>
          <li><a href="/blog/">Blog &amp; News</a></li>
          <li><a href="/careers/">Careers</a></li>
        </ul>
      </div>

      <!-- Contact：公/私地址与电话均取自 companyFacts，不在这里敲字 -->
      <div class="my-ft-col">
        <h4>Contact Us</h4>
        <ul class="my-ft-contact">
          <li>
            <span class="ic" aria-hidden="true">📍</span><span
              >{companyFacts.location}</span
            >
          </li>
          <li>
            <span class="ic" aria-hidden="true">📞</span><a
              href={`tel:${companyFacts.phone.replace(/\s/g, "")}`}
            >
              {companyFacts.phone}
            </a>
          </li>
          <li>
            <span class="ic" aria-hidden="true">📧</span><a
              href={`mailto:${companyFacts.email}`}>{companyFacts.email}</a
            >
          </li>
        </ul>
      </div>

      <!-- CTA 卡片 -->
      <div class="my-ft-cta-box">
        <strong>Contact MEIYU</strong>
        <p>
          Leave us a message for a free quote or sample panels. We reply within {
            responseTime
          }.
        </p>
        <div class="my-ft-cta-btns">
          <a href="/contact/" class="my-ft-cta-btn primary">
            <svg viewBox="0 0 24 24"
              ><path
                d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
              ></path></svg
            >
            Get a Free Quote
          </a>
        </div>
      </div>
    </div>

    <!-- 认证徽章：只渲染 companyProfile.certBadges（对齐附录 A）。
         原先硬写的 “SGS Tested” 与 “15+ Years Experience” 已删：前者无报告依据，
         后者当时与 2015 年成立不符。成立年份 2026-10-27 已改为 2011（至今约 15 年），
         但不自动恢复该徽章：年限属营销措辞，要写就写可核对的 “Established 2011”。 -->
    <div class="my-ft-certs">
      {certBadges.map((badge) => <span class="my-ft-badge">✓ {badge}</span>)}
    </div>

    <!-- 版权：年份自算，不写死（写死于 2026 会在明年自动变成陈旧信息） -->
    <div class="my-ft-bottom">
      <span>© {year} {companyFacts.name}. All Rights Reserved.</span>
      <div>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-of-use/">Terms of Use</a>
        <a href="/sitemap.xml">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* ── Base reset ──
     Only reset box-sizing (no blanket margin/padding override).
     Browser-default margins on headings, lists, and paragraphs
     are explicitly zeroed per-element below.
  */
  .my-ft {
    box-sizing: border-box;
    font-family: "Inter", "Helvetica Neue", sans-serif;
    background: #1a1008;
    color: rgba(255, 255, 255, 0.8);
    width: 100%;
  }
  .my-ft *,
  .my-ft *::before,
  .my-ft *::after {
    box-sizing: inherit;
  }
  /* Explicit margin reset for elements that have browser defaults */
  .my-ft h1,
  .my-ft h2,
  .my-ft h3,
  .my-ft h4,
  .my-ft p,
  .my-ft ul,
  .my-ft ol,
  .my-ft li {
    margin: 0;
    padding: 0;
  }

  /* ── Centered content container (matches header nav + main .container) ── */
  .my-ft-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* ── Header: Logo + Social ── */
  .my-ft-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 36px 0px 28px;
    border-bottom: 1px solid rgba(200, 169, 110, 0.15);
    flex-wrap: wrap;
    gap: 16px;
  }
  .my-ft-head-logo {
    display: flex;
    align-items: center;
  }
  .my-ft-head-logo img {
    height: 48px;
    width: auto;
    display: block;
    object-fit: contain;
  }
  .my-ft-socials {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .my-ft-socials a {
    width: 36px;
    height: 36px;
    border: 1px solid rgba(200, 169, 110, 0.25);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .my-ft-socials a svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  /* 品牌色徽章：原来是四个单色线条圆，在深棕底上长得几乎一样，认不出谁是谁。
     改成「品牌色实心 + 白色图形」—— 这既是各品牌自己的官方徽章样式（也是它们
     要求的：logo 不应被改成单色），也一并解决了深底上的对比度问题。
     颜色取各品牌公开发布的标志用色。 */
  .my-ft-socials a.soc--yt {
    background: #ff0033;
    border-color: #ff0033;
    color: #fff;
  }

  .my-ft-socials a.soc--li {
    background: #0a66c2;
    border-color: #0a66c2;
    color: #fff;
  }

  /* TikTok 官方图形是青+粉红双色。这里不用那支红（#fe2c55）而用青：
     它与 YouTube 的 #ff0033 色相太近，在 36px 上看着像两个红圆，只能靠图形区分。
     青底 + 近黑图形是 TikTok 在深色背景上的官方配色，且两个对比度都远过线。 */
  .my-ft-socials a.soc--tt {
    background: #25f4ee;
    border-color: #25f4ee;
    color: #010101;
  }

  /* WhatsApp：官方气泡绿 #25d366 配白图形自身对比只有 ~2:1，白色话筒发糊。
     改用它品牌色里的深青 #128c7e：白图形对比 ~4.4:1，与深棕底 ~4.1:1，两边都过线。 */
  .my-ft-socials a.soc--wa {
    background: #128c7e;
    border-color: #128c7e;
    color: #fff;
  }

  /* 上浮 + 加深，代替原来整圈变金色的弱反馈。
     注意：这里原先下面还有一条同选名的 .my-ft-socials a:hover{background:#c8a96e}，
     会把品牌色 hover 覆盖成金色，已删 —— 同文件内重复选名是静默失效的常见成因。 */
  .my-ft-socials a:hover {
    transform: translateY(-2px);
    filter: brightness(1.12);
    color: #fff;
    opacity: 1;
  }

  /* ── Main Grid ── */
  .my-ft-top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.1fr 1.3fr;
    gap: 40px;
    padding: 56px 0px;
    border-bottom: 1px solid rgba(200, 169, 110, 0.1);
    align-items: start;
  }
  .my-ft-brand p {
    font-size: 14px;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.5);
    max-width: 260px;
  }
  .my-ft-col h4 {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #c8a96e;
    margin-bottom: 20px;
  }
  .my-ft-col ul {
    list-style: none;
  }
  .my-ft-col ul li {
    margin-bottom: 12px;
  }
  .my-ft-col ul li a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
    line-height: 1.4;
  }
  .my-ft-col ul li a:hover {
    color: #c8a96e;
  }
  .my-ft-contact {
    list-style: none;
  }
  .my-ft-contact li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 14px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
  }
  .my-ft-contact .ic {
    color: #c8a96e;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ── CTA Card ── */
  .my-ft-cta-box {
    background: rgba(200, 169, 110, 0.06);
    border: 1px solid rgba(200, 169, 110, 0.3);
    border-radius: 10px;
    padding: 24px 22px;
  }
  .my-ft-cta-box strong {
    display: block;
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 10px;
    line-height: 1.4;
  }
  .my-ft-cta-box p {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 18px;
    line-height: 1.65;
  }
  .my-ft-cta-btns {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .my-ft-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 7px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: all 0.2s;
  }
  .my-ft-cta-btn svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
    flex-shrink: 0;
  }
  .my-ft-cta-btn.primary {
    background: #c8a96e;
    color: #1a1008;
  }
  .my-ft-cta-btn.primary:hover {
    background: #e8d5a8;
    transform: translateY(-2px);
  }

  /* ── Certifications ── */
  .my-ft-certs {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 32px 0px;
    border-bottom: 1px solid rgba(200, 169, 110, 0.08);
  }
  .my-ft-badge {
    padding: 8px 20px;
    border: 1px solid rgba(200, 169, 110, 0.35);
    border-radius: 30px;
    font-size: 12px;
    font-weight: 600;
    color: #c8a96e;
    letter-spacing: 0.5px;
  }

  /* ── Bottom Bar ── */
  .my-ft-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    padding: 20px 0px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.35);
    gap: 12px;
  }
  .my-ft-bottom a {
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    margin-left: 20px;
    transition: color 0.2s;
  }
  .my-ft-bottom a:hover {
    color: #c8a96e;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .my-ft-top {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .my-ft-brand {
      grid-column: 1 / -1;
    }
    .my-ft-brand p {
      max-width: 100%;
    }
    .my-ft-cta-box {
      grid-column: span 1;
    }
  }
  @media (max-width: 900px) {
    .my-ft-inner {
      padding-left: 24px;
      padding-right: 24px;
    }
    .my-ft-top {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      padding: 40px 0px;
    }
    .my-ft-brand {
      grid-column: 1 / -1;
    }
    .my-ft-cta-box {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 500px) {
    .my-ft-inner {
      padding-left: 20px;
      padding-right: 20px;
    }
    .my-ft-top {
      grid-template-columns: 1fr;
      padding: 36px 0px;
    }
    .my-ft-head {
      padding: 24px 0px;
    }
    .my-ft-certs {
      padding: 20px 0px;
    }
    .my-ft-badge {
      font-size: 11px;
      padding: 5px 12px;
    }
    .my-ft-bottom {
      padding: 18px 0px;
      flex-direction: column;
      text-align: center;
    }
    .my-ft-bottom a {
      margin-left: 0;
      margin: 0 8px;
    }
  }
</style>
