---
import Social from './Social.astro';
---

<style>
  /* Full-width footer bar, flush with the left/right/bottom window edges */
  footer {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 1.25rem 1rem;
    background-color: #fff;
    box-shadow: 0 -1px 4px rgba(0, 0, 0, 0.08);
  }
</style>

<footer>
  <Social platform="twitter" username="meiyualuminum" />
  <Social platform="linkedin" username="meiyualuminum" />
  <Social platform="github" username="meiyualuminum" />
</footer>
