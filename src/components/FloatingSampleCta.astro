---
/**
 * FloatingSampleCta.astro — "Sample Panels" 气泡标签
 *
 * - 桌面端：WhatsApp 按钮左侧，SVG 一笔画出完美对称胶囊 + 箭头
 * - 页面加载后立即显示（短暂入场动画后常驻）
 * - 点击 → 打开询盘弹窗
 * - 手机端不显示
 *
 * 2026-10-27：原名 FloatingFreeSample、文案 "Free Sample"，与 "Get a Free Quote" 是同一类
 * 问题——附录 A 没有样品政策条目，而 src/lib/companyProfile.ts 的 Samples 条款上写着
 * 「只写不含数字与费用承诺的能力陈述」。标 "Free" 等于替业主承诺了样品与运费免费。
 * 因此去掉 free 与 🎁（礼物符号同样在暗示免费），组件也改名到与行为一致。
 * 若日后业主确认确实送免费样品，正确顺序是先写进附录 A，再恢复这里的措辞。
 */
---

<div class="sample-bubble" id="sampleBubble" aria-hidden="true">
    <button
        type="button"
        class="bubble-btn"
        data-open-inquiry-modal
        aria-label="Request sample panels"
    >
        <!-- SVG 一笔画：左半圆 + 右半圆（被箭头打断）= 完美对称胶囊 + 尖角 -->
        <svg
            class="bubble-shape"
            viewBox="0 0 148 40"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <path
                d="
        M 20,0
        L 120,0
        A 20,20 0 0,1 137,12
        L 148,20
        L 137,28
        A 20,20 0 0,1 120,40
        L 20,40
        A 20,20 0 0,1 0,20
        A 20,20 0 0,1 20,0
        Z
      "
                fill="#69574a"></path>
        </svg>
        <span class="bubble-label">
            <span class="bubble-text">Sample Panels</span>
        </span>
    </button>
</div>

<script>
    const bubble = document.getElementById("sampleBubble")!;
    // 页面加载后短暂入场动画，之后常驻
    requestAnimationFrame(() => {
        bubble.classList.add("visible");
        bubble.setAttribute("aria-hidden", "false");
    });
</script>

<style>
    .sample-bubble {
        position: fixed;
        bottom: 166px;
        right: 100px;
        z-index: 899;
        opacity: 0;
        transform: translateX(10px) scale(0.9);
        transition:
            opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
            transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        pointer-events: none;
        filter: drop-shadow(0 3px 10px rgba(105, 87, 74, 0.45));
    }

    .sample-bubble.visible {
        opacity: 1;
        transform: translateX(0) scale(1);
        pointer-events: auto;
    }

    .bubble-btn {
        position: relative;
        display: block;
        width: 148px;
        height: 40px;
        border: none;
        background: none;
        padding: 0;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .bubble-btn:hover {
        transform: scale(1.05);
    }

    .bubble-btn:hover .bubble-shape path {
        fill: #5a4a3e;
    }

    .bubble-shape {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .bubble-shape path {
        transition: fill 0.2s;
    }

    /* padding-right 给右侧箭头缺口让位，让文字在胶囊主体里视觉居中 */
    .bubble-label {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        padding-right: 12px;
        color: #fff;
        pointer-events: none;
    }

    .bubble-text {
        font-size: 12.5px;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    /* 移动端阈值与页眉桌面断点（1280px）保持一致 */
    @media screen and (max-width: 1279px) {
        .sample-bubble {
            display: none !important;
        }
    }
</style>
