---
/**
 * ProjectGallery.astro — 项目画廊（统计条 + 分类药丸 + 卡片宫格 + 分页）
 *
 * - 数据源：posts 表 primary_tag='projects'（取数/分组逻辑在 lib/projectGallery.ts）
 * - 筛选机制（A 方案）：药丸是**链接**而非 JS 按钮 —— 跳转 /project-gallery/{category}/
 *   分类页做服务端过滤，分页正确（旧版 JS 页内隐藏只能过滤当前页内容）
 * - 分页：每页 PAGE_SIZE 条，接 PaginationNav；主页第 1 页由 [page].astro SSR 挂载，
 *   第 2~N 页与分类页由 project-gallery/ 下的静态路由挂载本组件
 * - 复用于：/project-gallery/、/project-gallery/page/N/、
 *   /project-gallery/{category}/、/project-gallery/{category}/page/N/，
 *   当前所在分类的药丸高亮（category）
 */
import PaginationNav from "./PaginationNav.astro";
import { PAGE_SIZE } from "../lib/pagination";
import {
    CATEGORY_MAP,
    computeProjectStats,
    fetchAllProjects,
    groupProjectsByCategory,
    projectCategory,
    projectRegion,
} from "../lib/projectGallery";

interface Props {
    /** 当前选中的分类；主页不传 = All Projects 高亮 */
    category?: string | null;
    /** 当前页码（分页页传 N，默认第 1 页） */
    currentPage?: number;
}

const { category = null, currentPage = 1 } = Astro.props;

// 一次取全部项目案例：统计条、药丸、本页切片同源（lib 内分批取数，无 1000 行截断）
const allProjects = await fetchAllProjects();
const stats = computeProjectStats(allProjects);

// 药丸列表：CATEGORY_MAP 策展顺序，只保留有案例的分类
const byCategory = groupProjectsByCategory(allProjects);
const categories = Object.keys(CATEGORY_MAP).filter((c) => byCategory.has(c));

// 服务端过滤 + 当前页切片（顺序与取数顺序一致：时间倒序 + slug 次级排序）
const filtered = category ? (byCategory.get(category) ?? []) : allProjects;
const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const page = Math.min(Math.max(1, currentPage), totalPages);
const projects = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

const categoryPath = category ? encodeURIComponent(category) : "";
const basePath = category
    ? `/project-gallery/${categoryPath}/page`
    : "/project-gallery/page";
const firstPageUrl = category
    ? `/project-gallery/${categoryPath}/`
    : "/project-gallery/";
---

<!-- Stats Strip -->
<section class="pg-stats">
    <div class="pg-stats-inner">
        <div class="pg-stat">
            <span class="pg-stat-num">{stats.total}+</span>
            <span class="pg-stat-label">Projects</span>
        </div>
        <div class="pg-stat">
            <span class="pg-stat-num">{stats.regions}</span>
            <span class="pg-stat-label">Regions</span>
        </div>
        <div class="pg-stat">
            <span class="pg-stat-num">{stats.sectors}</span>
            <span class="pg-stat-label">Sectors</span>
        </div>
        <div class="pg-stat">
            <span class="pg-stat-num">15+</span>
            <span class="pg-stat-label">Years Experience</span>
        </div>
    </div>
</section>

<!-- Gallery -->
<section class="pg-gallery">
    <div class="pg-container">
        <!-- Category Filters：链接式筛选（服务端过滤 + 分页正确），当前分类高亮 -->
        <nav class="pg-filters" aria-label="Project categories">
            <a
                href="/project-gallery/"
                class:list={["pg-filter-btn", { active: !category }]}
            >
                <span class="pg-filter-icon">🏗</span>
                <span class="pg-filter-label">All Projects</span>
            </a>
            {
                categories.map((c) => (
                    <a
                        href={`/project-gallery/${encodeURIComponent(c)}/`}
                        class:list={[
                            "pg-filter-btn",
                            { active: category === c },
                        ]}
                    >
                        <span class="pg-filter-icon">
                            {CATEGORY_MAP[c].icon}
                        </span>
                        <span class="pg-filter-label">
                            {CATEGORY_MAP[c].label}
                        </span>
                    </a>
                ))
            }
        </nav>

        <!-- Project Grid -->
        {
            projects.length > 0 ? (
                <div class="pg-grid">
                    {projects.map((post) => {
                        const catLabel =
                            CATEGORY_MAP[projectCategory(post)]?.label ??
                            "Project";
                        const regionTag = projectRegion(post);
                        const regionLabel = regionTag
                            ? regionTag
                                  .replace(/-/g, " ")
                                  .replace(/\b\w/g, (c) => c.toUpperCase())
                            : "";

                        return (
                            <a href={`/blog/${post.slug}/`} class="pg-card">
                                <div class="pg-card-img">
                                    <img
                                        src={post.image_url || ""}
                                        alt={post.image_alt || post.title}
                                        loading="lazy"
                                        width="600"
                                        height="400"
                                    />
                                    <div class="pg-card-badges">
                                        <span class="pg-badge-cat">
                                            {catLabel}
                                        </span>
                                        {regionLabel && (
                                            <span class="pg-badge-region">
                                                {regionLabel}
                                            </span>
                                        )}
                                    </div>
                                </div>
                                <div class="pg-card-body">
                                    <h3>{post.title}</h3>
                                    <p>{post.description}</p>
                                </div>
                            </a>
                        );
                    })}
                </div>
            ) : (
                <div class="pg-empty">
                    <p>
                        No project cases yet. Add blog posts with tag "projects"
                        to see them here.
                    </p>
                </div>
            )
        }

        <PaginationNav
            currentPage={page}
            totalPages={totalPages}
            basePath={basePath}
            firstPageUrl={firstPageUrl}
        />
    </div>
</section>

<style>
    /* ===== Stats Strip ===== */
    .pg-stats {
        background: linear-gradient(135deg, #69574a 0%, #4a3d32 100%);
        padding: 32px 0;
    }
    .pg-stats-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
        gap: 20px;
    }
    .pg-stat {
        text-align: center;
        min-width: 120px;
    }
    .pg-stat-num {
        display: block;
        font-size: 2.2rem;
        font-weight: 800;
        color: #c09020;
        line-height: 1.1;
    }
    .pg-stat-label {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.8);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 600;
    }

    /* ===== Gallery ===== */
    .pg-gallery {
        padding: 60px 0 80px;
        background: #f8f6f3;
    }
    .pg-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
    }

    /* ===== Filters（元素是 <a>：链接式筛选） ===== */
    .pg-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
        margin-bottom: 48px;
        padding-bottom: 32px;
        border-bottom: 1px solid #e8e4df;
    }
    .pg-filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 20px;
        border: 2px solid #e8e4df;
        border-radius: 50px;
        background: #fff;
        color: #69574a;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
        white-space: nowrap;
    }
    .pg-filter-btn:hover {
        border-color: #c09020;
        color: #c09020;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(192, 144, 32, 0.15);
    }
    .pg-filter-btn.active {
        background: #c09020;
        border-color: #c09020;
        color: #fff;
        box-shadow: 0 4px 16px rgba(192, 144, 32, 0.3);
    }
    .pg-filter-icon {
        font-size: 1rem;
    }

    /* ===== Grid ===== */
    .pg-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
    }

    /* ===== Card ===== */
    .pg-card {
        display: flex;
        flex-direction: column;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
        border: 1px solid #ece8e3;
        text-decoration: none;
        color: inherit;
        transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .pg-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 48px rgba(105, 87, 74, 0.16);
        border-color: rgba(192, 144, 32, 0.3);
    }

    /* ===== Card Image ===== */
    .pg-card-img {
        position: relative;
        aspect-ratio: 3 / 2;
        overflow: hidden;
    }
    .pg-card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .pg-card:hover .pg-card-img img {
        transform: scale(1.08);
    }
    .pg-card-badges {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        padding: 14px 16px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        background: linear-gradient(
            180deg,
            rgba(0, 0, 0, 0.45) 0%,
            transparent 100%
        );
    }
    .pg-badge-cat {
        padding: 4px 12px;
        background: rgba(192, 144, 32, 0.9);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }
    .pg-badge-region {
        padding: 4px 10px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(8px);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 600;
        border-radius: 20px;
    }

    /* ===== Card Body ===== */
    .pg-card-body {
        padding: 20px 22px 24px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .pg-card-body h3 {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 8px;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .pg-card-body p {
        font-size: 0.85rem;
        color: #64748b;
        margin: 0;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* ===== Empty ===== */
    .pg-empty {
        text-align: center;
        padding: 80px 20px;
        color: #94a3b8;
        font-size: 1.1rem;
    }

    /* ===== Responsive ===== */
    @media (max-width: 1024px) {
        .pg-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
    }
    @media (max-width: 640px) {
        .pg-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }
        .pg-filters {
            gap: 8px;
        }
        .pg-filter-btn {
            padding: 8px 14px;
            font-size: 0.8rem;
        }
        /* 窄屏只留图标 */
        .pg-filter-label {
            display: none;
        }
        .pg-filter-icon {
            font-size: 1.2rem;
        }
        .pg-stat-num {
            font-size: 1.6rem;
        }
    }
</style>
