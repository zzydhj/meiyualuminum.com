---
/**
 * Reusable inquiry form component.
 * Used on the contact page and inside the inquiry modal.
 *
 * ⚠️ SETUP — get your Access Key (free, no signup):
 *    1. Go to https://web3forms.com
 *    2. Enter the inbox where you want to receive inquiries
 *    3. Copy the access key from the email and paste it below
 */
const ACCESS_KEY = "35b74595-640c-4dc8-90e8-dc6c2469f4c5"; // ← replace with your Web3Forms access key
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="inquiry-form"
>
  <input type="hidden" name="access_key" value={ACCESS_KEY} />
  <input type="hidden" name="subject" value="New Inquiry — Meiyu Aluminum Website" />
  <input type="hidden" name="redirect" value="https://www.meiyualuminum.com/thank-you/" />
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

  <div class="form-grid">
    <label class="field">
      <span class="label">Full Name <em>*</em></span>
      <input type="text" name="name" required placeholder="Your name" />
    </label>

    <label class="field">
      <span class="label">Email <em>*</em></span>
      <input type="email" name="email" required placeholder="you@company.com" />
    </label>

    <label class="field">
      <span class="label">Country</span>
      <input type="text" name="country" list="country-list" placeholder="Type your country" autocomplete="country-name" />
      <datalist id="country-list">
        <option>United States</option>
        <option>United Kingdom</option>
        <option>Canada</option>
        <option>Australia</option>
        <option>Germany</option>
        <option>France</option>
        <option>Italy</option>
        <option>Spain</option>
        <option>Netherlands</option>
        <option>Poland</option>
        <option>Brazil</option>
        <option>Mexico</option>
        <option>Turkey</option>
        <option>United Arab Emirates</option>
        <option>Saudi Arabia</option>
        <option>India</option>
        <option>Japan</option>
        <option>South Korea</option>
        <option>Vietnam</option>
        <option>Thailand</option>
        <option>Indonesia</option>
        <option>Malaysia</option>
        <option>Philippines</option>
        <option>Nigeria</option>
        <option>South Africa</option>
        <option>Egypt</option>
        <option>Russia</option>
        <option>Argentina</option>
        <option>Chile</option>
        <option>Colombia</option>
        <option>Peru</option>
        <option>Kenya</option>
        <option>Ghana</option>
        <option>Tanzania</option>
        <option>Morocco</option>
        <option>Iraq</option>
        <option>Qatar</option>
        <option>Kuwait</option>
        <option>Oman</option>
        <option>Bangladesh</option>
        <option>Pakistan</option>
        <option>Sri Lanka</option>
        <option>Nepal</option>
        <option>Cambodia</option>
        <option>Myanmar</option>
        <option>Singapore</option>
        <option>New Zealand</option>
        <option>Portugal</option>
        <option>Greece</option>
        <option>Czech Republic</option>
        <option>Romania</option>
        <option>Hungary</option>
        <option>Sweden</option>
        <option>Norway</option>
        <option>Denmark</option>
        <option>Finland</option>
        <option>Belgium</option>
        <option>Austria</option>
        <option>Switzerland</option>
        <option>Ireland</option>
        <option>Israel</option>
        <option>Jordan</option>
        <option>Lebanon</option>
        <option>Algeria</option>
        <option>Tunisia</option>
        <option>Libya</option>
        <option>Ethiopia</option>
        <option>Uganda</option>
        <option>Zambia</option>
        <option>Zimbabwe</option>
        <option>Mozambique</option>
        <option>Angola</option>
        <option>Cameroon</option>
        <option>Senegal</option>
        <option>Ivory Coast</option>
        <option>Uzbekistan</option>
        <option>Kazakhstan</option>
        <option>Azerbaijan</option>
        <option>Georgia</option>
        <option>Ukraine</option>
        <option>Venezuela</option>
        <option>Ecuador</option>
        <option>Bolivia</option>
        <option>Paraguay</option>
        <option>Uruguay</option>
        <option>Costa Rica</option>
        <option>Panama</option>
        <option>Dominican Republic</option>
        <option>Guatemala</option>
        <option>Honduras</option>
        <option>Jamaica</option>
        <option>Trinidad and Tobago</option>
      </datalist>
    </label>

    <label class="field">
      <span class="label">WhatsApp / Phone</span>
      <input type="text" name="phone" placeholder="+86 138 0000 0000" />
    </label>
  </div>

  <label class="field">
    <span class="label">Message <em>*</em></span>
    <textarea
      name="message"
      required
      rows="6"
      placeholder="Describe the products, quantities, dimensions, or any questions you have. For large drawings/specs, paste a cloud-drive link here..."
    ></textarea>
  </label>

  <label class="checkbox-field">
    <input type="checkbox" name="free_sample" value="Yes" />
    <span class="checkbox-box" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3.5 8.5l3 3 6-7" />
      </svg>
    </span>
    <span class="checkbox-text">We support free samples for you to test the quality. Do you need them?</span>
  </label>

  <button type="submit" class="submit-btn">Send Inquiry</button>
  <p class="note"><em>*</em> Required fields. Your information is only used to respond to your inquiry.</p>
</form>

<style>
  .inquiry-form {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    padding: 1.5rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  @media screen and (max-width: 636px) {
    .form-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .field textarea {
      min-height: 88px;
    }

    .note {
      margin-top: 0.5rem;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .form-grid .field {
    margin-bottom: 0;
  }

  .label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #334155;
  }

  .label em {
    color: #e11d48;
    font-style: normal;
  }

  .field input,
  .field select,
  .field textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.375rem;
    background: #fff;
    color: #0f172a;
    width: 100%;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid #0053a0;
    outline-offset: 1px;
    border-color: #0053a0;
  }

  .field textarea {
    resize: vertical;
    min-height: 140px;
  }

  .submit-btn {
    width: 100%;
    background-color: #69574a;
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 0.85rem 2rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(105, 87, 74, 0.3);
    transition: background-color 0.2s, box-shadow 0.2s;
  }

  .submit-btn:hover {
    background-color: #5a4a3e;
    box-shadow: 0 4px 14px rgba(105, 87, 74, 0.45);
  }

  .note {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-top: 0.75rem;
  }

  /* 勾选框 — 带浅色背景卡片，更醒目 */
  .checkbox-field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.25rem 0 1.25rem;
    padding: 0.7rem 0.9rem;
    background: linear-gradient(135deg, #faf6f3 0%, #f5ede7 100%);
    border: 1px solid #e8ddd5;
    border-radius: 8px;
    cursor: pointer;
    user-select: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .checkbox-field:hover {
    border-color: #c9b8a8;
    box-shadow: 0 2px 8px rgba(105, 87, 74, 0.1);
  }

  .checkbox-field input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .checkbox-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border: 2px solid #b8a494;
    border-radius: 4px;
    background: #fff;
    transition: background-color 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }

  .checkbox-box svg {
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.15s, transform 0.15s;
  }

  .checkbox-field input:checked + .checkbox-box {
    background: #69574a;
    border-color: #69574a;
  }

  .checkbox-field input:checked + .checkbox-box svg {
    opacity: 1;
    transform: scale(1);
  }

  .checkbox-field input:focus-visible + .checkbox-box {
    outline: 2px solid #0053a0;
    outline-offset: 1px;
  }

  .checkbox-text {
    font-size: 0.88rem;
    font-weight: 500;
    color: #5a4a3e;
    line-height: 1.4;
  }
</style>
