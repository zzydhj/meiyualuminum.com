---
import InquiryForm from "./InquiryForm.astro";
import { responseTime } from "../lib/companyProfile";
---

{
  /*
  Inquiry modal — included once in BaseLayout.astro.
  Triggered from any button with data-open-inquiry-modal attribute.
  Close only via the X button or Escape key. Clicking the backdrop does nothing.

  A trigger may carry data-doc-name="<document title>". Two things then happen,
  deliberately kept apart: prefill() writes a "send me this document" line into
  Message, but only when that won't clobber what the buyer typed; the
  requested_document recorder always records the title in a hidden field, so the
  email says which document was asked for even if the buyer wrote their own
  message. Several documents clicked in one page view are all recorded ("; "-joined).

  Download gate mode: buttons with data-download-file="<file URL>" (and optional
  data-doc-name="<document title>") open this same modal; on form submit the
  file download is triggered and the requested document is recorded in the
  inquiry email (hidden "requested_document" field). Only point data-download-file
  at a URL that really returns 200 — the buyer has already handed over their
  contact details by the time the download runs.

  Uses the native HTML <dialog> element. The browser handles, for free:
  - scroll lock on the body while the modal is open
  - focus trapping inside the modal
  - closing on Escape
  - dimming via ::backdrop (clicking it does not close by default)
*/
}
<dialog
  class="inquiry-modal"
  id="inquiry-modal"
  aria-labelledby="inquiry-modal-title"
>
  <div class="inquiry-modal-dialog">
    <div class="inquiry-modal-header">
      <div class="inquiry-modal-titles">
        <h2 id="inquiry-modal-title">Request a Quote</h2>
        <p class="inquiry-modal-subtitle">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"></path></svg
          >
          We reply within {responseTime}
        </p>
      </div>
      <button
        type="button"
        class="inquiry-modal-close"
        data-close-inquiry-modal
        aria-label="Close inquiry form"
      >
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Download gate banner — shown only when opened via [data-download-file] -->
    <div class="download-banner" id="download-banner" hidden>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
        ></path>
        <path d="M14 2v6h6"></path>
        <path d="M12 18v-6"></path>
        <path d="M9 15l3 3 3-3"></path>
      </svg>
      <div class="download-banner-text">
        <strong>Fill in the form below to download:</strong>
        <span id="download-doc-name"></span>
      </div>
    </div>

    <div class="inquiry-modal-body">
      <InquiryForm />
    </div>
  </div>
</dialog>

<script>
  (function () {
    const dialog = document.getElementById(
      "inquiry-modal",
    ) as HTMLDialogElement | null;
    const openButtons = document.querySelectorAll("[data-open-inquiry-modal]");
    const closeButton = dialog?.querySelector("[data-close-inquiry-modal]");

    /* 预填上下文：带 data-inquiry-message 的触发按钮，打开时把这段话填进 Message。
       只覆盖「空着」或「上次也是自动填的且客户没改过」的内容 —— 绝不冲掉客户自己打的字。 */
    const messageEl = dialog?.querySelector(
      'textarea[name="message"]',
    ) as HTMLTextAreaElement | null;
    let lastAuto = "";

    // showModal() 对已经开着的 <dialog> 会抛 InvalidStateError。触发器现在有两套
    // （data-open-inquiry-modal 和 data-download-file），同一个元素两个属性都带时两个处理器
    // 会各调一次，第二次就炸。统一走这个幂等入口。
    const openModal = () => {
      if (dialog && !dialog.open) dialog.showModal();
    };

    function prefill(btn: Element) {
      if (!messageEl) return;
      const doc = btn.getAttribute("data-doc-name") || "";
      const want =
        btn.getAttribute("data-inquiry-message") ||
        // 文档索取按钮只有 data-doc-name：把客户点的那份文档名带进 Message，
        // 业主才知道这条询盘对应哪一份资料。/technical-documentation/ 的 13 个按钮
        // 在 2026-11-08 死链改造后只剩这个属性，没有这句话的话，询盘内容和客户
        // 在页面上点的东西就彻底脱钩了。
        (doc ? `Could you please send me this document? ${doc}` : "");
      if (!want) {
        if (lastAuto && messageEl.value === lastAuto) messageEl.value = "";
        lastAuto = "";
        return;
      }
      if (messageEl.value === "" || messageEl.value === lastAuto)
        messageEl.value = want;
      lastAuto = want;
    }

    openButtons.forEach((btn) =>
      btn.addEventListener("click", () => {
        prefill(btn);
        openModal();
      }),
    );

    closeButton?.addEventListener("click", () => dialog?.close());

    // Expose global helpers so other scripts can trigger the modal
    (window as any).openInquiryModal = (text?: string) => {
      if (
        text &&
        messageEl &&
        (messageEl.value === "" || messageEl.value === lastAuto)
      ) {
        messageEl.value = text;
        lastAuto = text;
      }
      dialog?.showModal();
    };
    (window as any).closeInquiryModal = () => dialog?.close();
  })();

  /* ===== requested_document 记录器 =====
     客户索取了哪份资料，必须有一个不依赖 Message 正文的承载字段。

     为什么不能只靠 prefill() 写进 Message：prefill 的规矩是「绝不冲掉客户自己打的字」，
     所以客户一旦自已在正文里写了话，文档名就一个字都不会被记下来。改造前的下载门禁
     是靠提交时写 requested_document 避免这个同题的；2026-11-08 把 13 个按钮从
     data-download-file 改成 data-open-inquiry-modal 后，那条路径没了，
     实测（13 个按钮逐个点）确实会丢——所以记录与预填必须分成两件事：
     字段永远记，正文只在安全时填。

     同一次浏览里点过多份就全部记下来（分号分隔），那正是客户实际索取的清单；
     隐藏字段只在第一次点击时才建，普通询盘不会多带一个空字段。 */
  (function () {
    const form = document.querySelector<HTMLFormElement>("#inquiry-modal form");
    if (!form) return;
    let hidden: HTMLInputElement | null = null;
    const seen: string[] = [];

    document.addEventListener(
      "click",
      (e) => {
        const btn = (e.target as Element | null)?.closest?.<HTMLElement>(
          "[data-doc-name], [data-download-file]",
        );
        if (!btn) return;
        const name =
          btn.getAttribute("data-doc-name") ||
          btn.getAttribute("data-download-file") ||
          "";
        if (!name || seen.includes(name)) return;
        seen.push(name);
        if (!hidden) {
          hidden = document.createElement("input");
          hidden.type = "hidden";
          hidden.name = "requested_document";
          form.appendChild(hidden);
        }
        hidden.value = seen.join("; ");
      },
      { capture: true },
    );
  })();

  /* ===== Download gate =====
     任何带 data-download-file 的按钮：打开询盘弹窗，提交成功后自动下载文件。
     邮件里的文档名不在这里写，由上面那个记录器统一负责。 */
  (function () {
    const dialog = document.getElementById(
      "inquiry-modal",
    ) as HTMLDialogElement | null;
    const banner = document.getElementById("download-banner");
    const docNameEl = document.getElementById("download-doc-name");
    const form = dialog?.querySelector("form") as
      HTMLFormElement | null | undefined;
    if (!dialog || !form || !banner || !docNameEl) return;

    let pendingFile: string | null = null;
    let pendingDoc = "";

    // 下载模式提交：fetch 异步提交（避免页面导航取消下载），成功后触发下载并留在页面反馈；
    // 普通询盘（pendingFile 为空）不拦截，保持原生提交行为不变。
    form.addEventListener("submit", async (e) => {
      if (!pendingFile) return;
      e.preventDefault();

      const file = pendingFile;

      // 客户索取哪份资料由上面的「requested_document 记录器」在点击那一刻就写进
      // 隐藏字段，不在这里抢：以前只记最后点的那一份，现在多份一起记。

      const submitBtn = form.querySelector<HTMLButtonElement>(
        "button[type=submit]",
      );
      const originalLabel = submitBtn?.textContent || "";
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Submitting…";
      }

      const startDownload = () => {
        const a = document.createElement("a");
        a.href = file;
        a.download = "";
        a.rel = "noopener";
        document.body.appendChild(a);
        a.click();
        a.remove();
      };

      const showSuccess = () => {
        const strong = banner.querySelector("strong");
        if (strong)
          strong.textContent = "✓ Submitted — your download is starting";
        docNameEl.textContent = "";
      };

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        if (!res.ok) throw new Error("submit failed");
        startDownload();
        showSuccess();
        form.reset();
        setTimeout(() => dialog.close(), 2000);
      } catch {
        // fetch 失败时回退原生提交，保证询盘不丢
        startDownload();
        form.submit();
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      }
    });

    // 关闭时重置横幅状态与文案，避免普通询盘误显下载提示
    dialog.addEventListener("close", () => {
      pendingFile = null;
      pendingDoc = "";
      banner.hidden = true;
      const strong = banner.querySelector("strong");
      if (strong) strong.textContent = "Fill in the form below to download:";
    });

    document
      .querySelectorAll<HTMLElement>("[data-download-file]")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          pendingFile = btn.getAttribute("data-download-file") || null;
          pendingDoc = btn.getAttribute("data-doc-name") || "";
          docNameEl.textContent = pendingDoc;
          banner.hidden = false;
          // 上面那个 openModal 在另一个 IIFE 里，不跨作用域引用；这里就地守开闭状态
          if (!dialog.open) dialog.showModal();
        });
      });
  })();
</script>

<style>
  /* ============================================================
     CSS variables — adjust these to tweak the modal appearance
     ============================================================ */
  .inquiry-modal {
    --modal-overlay-bg: rgba(15, 23, 42, 0.55);
    --modal-bg: #ffffff;
    --modal-radius: 0.75rem;
    --modal-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    --modal-max-width: 720px;
    --modal-padding: 1.5rem;
    --modal-backdrop-blur: 4px;
    --close-color: #64748b;
    --close-hover: #0f172a;
  }

  /* Reset <dialog> defaults and make it fill the viewport */
  .inquiry-modal {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: none;
    background: transparent;
    overflow: visible;
  }

  .inquiry-modal[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Backdrop overlay — browser handles this via ::backdrop */
  .inquiry-modal::backdrop {
    background-color: var(--modal-overlay-bg);
    backdrop-filter: blur(var(--modal-backdrop-blur));
    -webkit-backdrop-filter: blur(var(--modal-backdrop-blur));
  }

  /* Dialog box */
  .inquiry-modal-dialog {
    position: relative;
    width: 100%;
    max-width: var(--modal-max-width);
    max-height: calc(100vh - 2rem);
    background-color: var(--modal-bg);
    border-radius: var(--modal-radius);
    box-shadow: var(--modal-shadow);
    overflow-y: auto;
    animation: modalFadeIn 0.2s ease-out;
  }

  @keyframes modalFadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Header */
  .inquiry-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--modal-padding);
    padding-bottom: 0;
  }

  .inquiry-modal-titles {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .inquiry-modal-header h2 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
    color: #0f172a;
  }

  /* 响应承诺徽章 — 暖色 pill，醒目但贴合主题 */
  .inquiry-modal-subtitle {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    padding: 0.3rem 0.7rem;
    background: linear-gradient(135deg, #faf6f3 0%, #f3e9e1 100%);
    border: 1px solid #ecdfd4;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #69574a;
    line-height: 1;
  }

  .inquiry-modal-subtitle svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: #c2703d;
  }

  /* Close button */
  .inquiry-modal-close {
    -webkit-appearance: none;
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: none;
    padding: 0;
    color: var(--close-color);
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    transition:
      color 0.15s,
      background-color 0.15s;
  }

  .inquiry-modal-close:hover,
  .inquiry-modal-close:focus {
    color: var(--close-hover);
    background-color: #f1f5f9;
  }

  /* Body */
  .inquiry-modal-body {
    padding: var(--modal-padding);
  }

  /* Download gate banner — 弹窗顶部提示条，仅在下载拦截模式下显示 */
  .download-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin: 1rem var(--modal-padding) 0;
    padding: 0.75rem 1rem;
    background: linear-gradient(135deg, #faf6f3 0%, #f3e9e1 100%);
    border: 1px solid #ecdfd4;
    border-radius: 0.5rem;
    color: #5a4a3e;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  /* display:flex 会覆盖 hidden 属性的默认 display:none，必须显式补回 */
  .download-banner[hidden] {
    display: none;
  }

  .download-banner svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-top: 1px;
    color: #69574a;
  }

  .download-banner strong {
    display: block;
    font-weight: 700;
    color: #4a3c32;
  }

  .download-banner #download-doc-name {
    font-weight: 600;
    color: #69574a;
  }

  .inquiry-modal-body :global(.inquiry-form) {
    border: none;
    border-radius: 0;
    padding: 0;
    background: transparent;
  }

  /* Mobile: use more of the screen */
  @media screen and (max-width: 636px) {
    .inquiry-modal {
      padding: 0;
    }

    .inquiry-modal[open] {
      align-items: flex-end;
    }

    .inquiry-modal-dialog {
      max-height: calc(100vh - 2rem);
      width: calc(100% - 1rem);
      max-width: none;
      margin-bottom: 0.5rem;
    }
  }
</style>
