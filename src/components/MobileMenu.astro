<style>
  /* ===== 全屏覆盖层 =====
     z-index 2000 > header 的 1000，确保盖住 sticky header。
     默认 opacity 0 + visibility hidden，加 .open 后淡入。 */
  .m-menu {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: #fff;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .m-menu.open {
    opacity: 1;
    visibility: visible;
  }

  /* 桌面端（≥1400px）彻底移除，不占渲染树 */
  @media screen and (min-width: 1400px) {
    .m-menu {
      display: none;
    }
  }

  /* ===== 顶部栏 ===== */
  .m-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e8e4df;
    flex-shrink: 0;
  }
  .m-menu-logo img {
    height: 34px;
    width: auto;
    display: block;
  }
  .m-menu-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: none;
    border: none;
    border-radius: 8px;
    color: #0d0950;
    cursor: pointer;
    transition: background 0.2s;
  }
  .m-menu-close:hover {
    background: #f5f3f0;
  }

  /* ===== 可滚动菜单主体 ===== */
  .m-menu-body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  /* ===== 列表通用 ===== */
  .m-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 层级缩进：一级 16px → 二级 32px → 三级 48px */
  .m-l1 > li > .m-link,
  .m-l1 > li > .m-row > .m-link { padding-left: 16px; }
  .m-l2 > li > .m-link,
  .m-l2 > li > .m-row > .m-link { padding-left: 32px; }
  .m-l3 > li > .m-link { padding-left: 48px; }

  /* ===== 链接 ===== */
  .m-link {
    display: block;
    flex: 1;
    min-width: 0;
    padding: 14px 16px;
    font-size: 15px;
    font-weight: 600;
    color: #0d0950;
    text-decoration: none;
    transition: background 0.15s;
  }
  .m-link:hover {
    background: #faf8f5;
  }

  /* 二级样式 */
  .m-l2 > li > .m-link,
  .m-l2 > li > .m-row > .m-link {
    font-size: 14px;
    font-weight: 600;
    color: #3d3d3d;
  }
  /* 三级样式 */
  .m-l3 > li > .m-link {
    font-size: 13px;
    font-weight: 500;
    color: #5a4a3e;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  /* ===== 手风琴行（链接 + 展开按钮） ===== */
  .m-row {
    display: flex;
    align-items: center;
  }
  .m-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    align-self: stretch;
    flex-shrink: 0;
    background: none;
    border: none;
    border-left: 1px solid #f0ede9;
    color: #69574a;
    cursor: pointer;
    transition: background 0.15s;
  }
  .m-toggle:hover {
    background: #faf8f5;
  }

  /* 箭头旋转：展开时 180° */
  .m-chevron {
    transition: transform 0.3s ease;
  }
  .m-acc.open > .m-row .m-chevron {
    transform: rotate(180deg);
  }

  /* ===== 折叠面板动画 =====
     grid-template-rows: 0fr → 1fr 过渡，
     内容高度自适应，无 max-height 的 timing 问题。 */
  .m-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .m-acc.open > .m-panel {
    grid-template-rows: 1fr;
  }
  .m-panel-in {
    overflow: hidden;
    min-height: 0;
  }

  /* 子面板背景色区分层级 */
  .m-l1 > .m-acc > .m-panel { background: #faf9f7; }
  .m-l2 > .m-acc > .m-panel { background: #f5f3f0; }

  /* 分隔线 */
  .m-l1 > li {
    border-bottom: 1px solid #f0ede9;
  }
</style>
