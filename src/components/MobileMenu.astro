---
/**
 * MobileMenu.astro — 移动端全屏手风琴导航菜单
 *
 * - 全屏覆盖（fixed, inset: 0），z-index 高于 sticky header
 * - 三级菜单通过左侧缩进体现层级
 * - 同级互斥手风琴：展开 A 自动收起 B（JS 在 src/scripts/menu.js）
 * - 展开动画：grid-template-rows 0fr → 1fr（纯 CSS 过渡，自适应内容高度）
 * - 仅在 < 1400px 显示；桌面端由 Navigation.astro + MegaMenu.astro 负责
 *
 * ⚠️ 菜单链接与 Navigation.astro / MegaMenu.astro 各维护一份，
 *    修改导航结构时两处需同步更新。
 */
---

<div class="m-menu" id="mobile-menu" aria-hidden="true">
  <!-- 顶部栏：Logo + 关闭按钮 -->
  <div class="m-menu-header">
    <a href="/" class="m-menu-logo">
      <img
        src="https://file.meiyualuminum.com/home/logo-1.png"
        alt="MEIYU Aluminum"
      />
    </a>
    <button
      type="button"
      class="m-menu-close"
      id="mobile-menu-close"
      aria-label="Close menu"
    >
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- 可滚动菜单列表 -->
  <nav class="m-menu-body" aria-label="Mobile navigation">
    <ul class="m-list m-l1">
      <!-- Home -->
      <li><a class="m-link" href="/">Home</a></li>

      <!-- Aluminum Solutions -->
      <li><a class="m-link" href="#">Aluminum Solutions</a></li>

      <!-- Products（三级结构） -->
      <li class="m-acc">
        <div class="m-row">
          <a class="m-link" href="/products/">Products</a>
          <button
            type="button"
            class="m-toggle"
            aria-expanded="false"
            aria-label="Toggle Products submenu"
          >
            <svg
              class="m-chevron"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg
            >
          </button>
        </div>
        <div class="m-panel">
          <div class="m-panel-in">
            <ul class="m-list m-l2">
              <li>
                <a class="m-link" href="/categories/aluminum-veneer/"
                  >Aluminum Veneer</a
                >
              </li>
              <li>
                <a class="m-link" href="/categories/aluminum-strip-panel/"
                  >Aluminum Strip Panel</a
                >
              </li>
              <li>
                <a
                  class="m-link"
                  href="/categories/u-shaped-aluminum-square-tube/"
                  >U-Shaped Aluminum Square Tube</a
                >
              </li>
              <li>
                <a
                  class="m-link"
                  href="/categories/aluminum-honeycomb-core-panel/"
                  >Aluminum Honeycomb Core Panel</a
                >
              </li>
              <li>
                <a class="m-link" href="/categories/aluminum-ceiling-tile/"
                  >Aluminum Ceiling Tile</a
                >
              </li>
              <li>
                <a class="m-link" href="/categories/aluminum-square-tube/"
                  >Aluminum Square Tube</a
                >
              </li>
              <li>
                <a class="m-link" href="/categories/fluted-aluminum-panel/"
                  >Fluted Aluminum Panel</a
                >
              </li>
              <li>
                <a class="m-link" href="/categories/aluminum-skirting-board/"
                  >Aluminum Skirting Board</a
                >
              </li>
            </ul>
          </div>
        </div>
      </li>

      <!-- About -->
      <li><a class="m-link" href="/about/">About</a></li>

      <!-- Videos -->
      <li class="m-acc">
        <div class="m-row">
          <a class="m-link" href="#">Videos</a>
          <button
            type="button"
            class="m-toggle"
            aria-expanded="false"
            aria-label="Toggle Videos submenu"
          >
            <svg
              class="m-chevron"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg
            >
          </button>
        </div>
        <div class="m-panel">
          <div class="m-panel-in">
            <ul class="m-list m-l2">
              <li><a class="m-link" href="#">Project Cases</a></li>
              <li><a class="m-link" href="#">Client Testimonial</a></li>
              <li><a class="m-link" href="#">Factory Tour</a></li>
              <li><a class="m-link" href="#">How It's Made</a></li>
              <li><a class="m-link" href="#">Installation Guide</a></li>
              <li>
                <a class="m-link" href="#">Sample &amp; Custom Service</a>
              </li>
              <li><a class="m-link" href="#">Product Showcase</a></li>
              <li>
                <a class="m-link" href="#">Quality &amp; Certifications</a>
              </li>
            </ul>
          </div>
        </div>
      </li>

      <!-- Distributor -->
      <li><a class="m-link" href="#">Distributor</a></li>

      <!-- Resource -->
      <li class="m-acc">
        <div class="m-row">
          <a class="m-link" href="#">Resource</a>
          <button
            type="button"
            class="m-toggle"
            aria-expanded="false"
            aria-label="Toggle Resource submenu"
          >
            <svg
              class="m-chevron"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg
            >
          </button>
        </div>
        <div class="m-panel">
          <div class="m-panel-in">
            <ul class="m-list m-l2">
              <li><a class="m-link" href="/blog/">Blog</a></li>
              <li><a class="m-link" href="/categories/">Categories</a></li>
              <li><a class="m-link" href="/tags/">Tags</a></li>
              <li><a class="m-link" href="/faq/">FAQ</a></li>
              <li>
                <a class="m-link" href="/technical-documentation/"
                  >Technical Documentation</a>
              </li>
            </ul>
          </div>
        </div>
      </li>

      <!-- Project Gallery -->
      <li class="m-acc">
        <div class="m-row">
          <a class="m-link" href="#">Project Gallery</a>
          <button
            type="button"
            class="m-toggle"
            aria-expanded="false"
            aria-label="Toggle Project Gallery submenu"
          >
            <svg
              class="m-chevron"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg
            >
          </button>
        </div>
        <div class="m-panel">
          <div class="m-panel-in">
            <ul class="m-list m-l2">
              <li>
                <a
                  class="m-link"
                  href="/project-shanghai-pudong-financial-tower/"
                  >Shanghai Financial Tower</a>
              </li>
              <li>
                <a
                  class="m-link"
                  href="/project-beijing-daxing-airport-ceiling/"
                  >Beijing Daxing Airport</a>
              </li>
              <li>
                <a
                  class="m-link"
                  href="/project-hangzhou-olympic-stadium-facade/"
                  >Hangzhou Olympic Stadium</a>
              </li>
              <li>
                <a class="m-link" href="/project-shanghai-bund-hotel-interior/"
                  >Shanghai Bund Hotel</a>
              </li>
              <li>
                <a
                  class="m-link"
                  href="/project-guangzhou-medical-center-cladding/"
                  >Guangzhou Medical Center</a>
              </li>
              <li>
                <a class="m-link" href="/project-shenzhen-bay-mall-atrium/"
                  >Shenzhen Bay Mall</a>
              </li>
              <li>
                <a class="m-link" href="/project-shenzhen-tech-hq-office/"
                  >Shenzhen Tech HQ</a>
              </li>
              <li>
                <a class="m-link" href="/project-chengdu-riverside-residences/"
                  >Chengdu Riverside Residences</a>
              </li>
            </ul>
          </div>
        </div>
      </li>

      <!-- Contact Us -->
      <li><a class="m-link" href="/contact/">Contact Us</a></li>
    </ul>
  </nav>
</div>

<style>
  /* ===== 全屏覆盖层 =====
     z-index 2000 > header 的 1000，确保盖住 sticky header。
     默认 opacity 0 + visibility hidden，加 .open 后淡入。 */
  .m-menu {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: #fff;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }
  .m-menu.open {
    opacity: 1;
    visibility: visible;
  }

  /* 桌面端（≥1400px）彻底移除，不占渲染树 */
  @media screen and (min-width: 1400px) {
    .m-menu {
      display: none;
    }
  }

  /* ===== 顶部栏 ===== */
  .m-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e8e4df;
    flex-shrink: 0;
  }
  .m-menu-logo img {
    height: 34px;
    width: auto;
    display: block;
  }
  .m-menu-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: none;
    border: none;
    border-radius: 8px;
    color: #0d0950;
    cursor: pointer;
    transition: background 0.2s;
  }
  .m-menu-close:hover {
    background: #f5f3f0;
  }

  /* ===== 可滚动菜单主体 ===== */
  .m-menu-body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  /* ===== 列表通用 ===== */
  .m-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 层级缩进：一级 16px → 二级 32px → 三级 48px */
  .m-l1 > li > .m-link,
  .m-l1 > li > .m-row > .m-link {
    padding-left: 16px;
  }
  .m-l2 > li > .m-link,
  .m-l2 > li > .m-row > .m-link {
    padding-left: 32px;
  }
  .m-l3 > li > .m-link {
    padding-left: 48px;
  }

  /* ===== 链接 ===== */
  .m-link {
    display: block;
    flex: 1;
    min-width: 0;
    padding: 14px 16px;
    font-size: 15px;
    font-weight: 600;
    color: #0d0950;
    text-decoration: none;
    transition: background 0.15s;
  }
  .m-link:hover {
    background: #faf8f5;
  }

  /* 二级样式 */
  .m-l2 > li > .m-link,
  .m-l2 > li > .m-row > .m-link {
    font-size: 14px;
    font-weight: 600;
    color: #3d3d3d;
  }
  /* 三级样式 */
  .m-l3 > li > .m-link {
    font-size: 13px;
    font-weight: 500;
    color: #5a4a3e;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  /* ===== 手风琴行（链接 + 展开按钮） ===== */
  .m-row {
    display: flex;
    align-items: center;
  }
  .m-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    align-self: stretch;
    flex-shrink: 0;
    background: none;
    border: none;
    border-left: 1px solid #f0ede9;
    color: #69574a;
    cursor: pointer;
    transition: background 0.15s;
  }
  .m-toggle:hover {
    background: #faf8f5;
  }

  /* 箭头旋转：展开时 180° */
  .m-chevron {
    transition: transform 0.3s ease;
  }
  .m-acc.open > .m-row .m-chevron {
    transform: rotate(180deg);
  }

  /* ===== 折叠面板动画 =====
     grid-template-rows: 0fr → 1fr 过渡，
     内容高度自适应，无 max-height 的 timing 问题。 */
  .m-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .m-acc.open > .m-panel {
    grid-template-rows: 1fr;
  }
  .m-panel-in {
    overflow: hidden;
    min-height: 0;
  }

  /* 子面板背景色区分层级 */
  .m-l1 > .m-acc > .m-panel {
    background: #faf9f7;
  }
  .m-l2 > .m-acc > .m-panel {
    background: #f5f3f0;
  }

  /* 分隔线 */
  .m-l1 > li {
    border-bottom: 1px solid #f0ede9;
  }
</style>
