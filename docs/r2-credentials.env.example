# 模板文件（可进仓库）· 真实密钥请写进同目录的 r2-credentials.env（已被 .gitignore 忽略）
# 用法：把本文件复制为 r2-credentials.env，填入真实值即可
#       PowerShell:  Copy-Item docs/r2-credentials.env.example docs/r2-credentials.env
# 读取顺序：环境变量 > 项目根 .env / .env.local > docs/r2-credentials.env（先找到的生效）
# 完整说明与令牌获取步骤：docs/r2-setup.md §2

# Cloudflare R2（令牌作用域建议：仅 meiyu 桶的对象读取/写入/列出）
# 获取：Cloudflare → R2 → 桶 meiyu → API Tokens → Create API Token → Object Read & Write
# 注意：Secret Access Key 只在创建时显示一次
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>

# Supabase（仅 docs/migrate-hotlinks-to-r2.py 只读文章用；站点前端用的也是这两项）
# anon / publishable key 本身是前端公开密钥，不是服务端密钥，不要换成 service_role key
PUBLIC_SUPABASE_URL=<your-project-supabase-url>
PUBLIC_SUPABASE_ANON_KEY=<your-project-anon-key>
